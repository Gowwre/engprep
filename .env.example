# TTSMaker API v2 — create a key at https://pro.ttsmaker.com/api-platform/api-key-list
# This file is for local audio generation only. Never commit the real key.
TTSMAKER_API_KEY=

# English voice used for the word list. See:
# npm run audio -- --list-voices
TTSMAKER_VOICE_ID=1480

# Slightly slower than normal speech, better for learners.
TTSMAKER_AUDIO_SPEED=0.9

# 1 = high quality MP3, 0 = standard.
TTSMAKER_HIGH_QUALITY=1
