---
interface Formula {
  sign: string;
  text: string;
}

interface Timeline {
  start: number;
  end: number;
  dot?: number;
  check?: boolean;
  dashed?: boolean;
  habit?: boolean;
  label: string;
}

interface Props {
  id: string;
  group: string;
  no: string;
  groupLabel: string;
  title: string;
  english: string;
  badge?: string;
  formulas: Formula[];
  timeline?: Timeline;
  uses: string[];
  signals: string[];
  exampleEn: string;
  exampleVi: string;
  pitfall: string;
}

const {
  id,
  group,
  no,
  groupLabel,
  title,
  english,
  badge,
  formulas,
  timeline,
  uses,
  signals,
  exampleEn,
  exampleVi,
  pitfall
} = Astro.props;
---

<article class="tense-card" id={id} data-group={group}>
  <div class="card-head">
    <span class="tense-no">{no}</span>
    <div class="tense-title">
      <span class="group-pill">{groupLabel}</span>
      <h3>{title} <span>{english}</span></h3>
    </div>
    {badge && <span class="exam-badge">{badge}</span>}
  </div>

  <div class="formulas">
    {formulas.map((formula) => (
      <div class="formula">
        <span class="formula-sign">{formula.sign}</span>
        <code>{formula.text}</code>
      </div>
    ))}
  </div>

  {timeline && (
    <div class="tense-time" role="img" aria-label={`Vị trí trên trục thời gian: ${timeline.label}`}>
      <span class="tense-time-end" aria-hidden="true">Quá khứ</span>
      <span class="tense-time-track" aria-hidden="true">
        <span class="tense-time-now"></span>
        {timeline.end > timeline.start && (
          <span
            class:list={['tense-time-bar', { 'is-dashed': timeline.dashed }]}
            style={`left:${timeline.start}%;width:${timeline.end - timeline.start}%`}
          ></span>
        )}
        {timeline.check ? (
          <span class="tense-time-check" style={`left:${timeline.end}%`}>✓</span>
        ) : (
          <span
            class:list={['tense-time-dot', { 'is-habit': timeline.habit }]}
            style={`left:${timeline.dot ?? timeline.end}%`}
          ></span>
        )}
      </span>
      <span class="tense-time-end" aria-hidden="true">Tương lai</span>
    </div>
  )}

  <div class="card-block">
    <h4>Cách dùng</h4>
    <ul class="uses">
      {uses.map((use) => <li set:html={use} />)}
    </ul>
  </div>

  <div class="card-block">
    <h4>Dấu hiệu nhận biết</h4>
    <div class="chips">
      {signals.map((signal) => <span>{signal}</span>)}
    </div>
  </div>

  <blockquote class="example">
    <p class="example-en" set:html={exampleEn}></p>
    <p class="example-vi">{exampleVi}</p>
  </blockquote>

  <p class="pitfall"><strong>Lỗi thường gặp:</strong> <Fragment set:html={pitfall} /></p>

  <slot name="extra" />
</article>
