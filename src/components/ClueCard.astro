---
interface Props {
  label: string;
  title: string;
  body: string;
  example: string;
  id?: string;
}

const { label, title, body, example, id } = Astro.props;
---

<article class="cz-clue-card" id={id}>
  <p class="cz-clue-label">{label}</p>
  <h3>{title}</h3>
  <p>{body}</p>
  <p class="cz-clue-eg" set:html={example}></p>
</article>
