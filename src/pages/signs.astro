---
import '../styles/global.css';
import SheetLayout from '../layouts/SheetLayout.astro';
import CommunicationCard from '../components/CommunicationCard.astro';
import EmptyState from '../components/EmptyState.astro';
import FigurePanel from '../components/FigurePanel.astro';
import FilterToolbar from '../components/FilterToolbar.astro';
import QuizPanel from '../components/QuizPanel.astro';
import QuickReview from '../components/QuickReview.astro';
import SectionHead from '../components/SectionHead.astro';
import StepCard from '../components/StepCard.astro';
import StudyStackVisual from '../components/StudyStackVisual.astro';
import TableShell from '../components/TableShell.astro';
import TrapCard from '../components/TrapCard.astro';
import { quickReviews } from '../data/quick-review';
import '../styles/signs.css';
---

<SheetLayout slug="signs">
  <Fragment slot="visual">
    <StudyStackVisual
      stackClass="sg-stack"
      noteLabel="Mẹo thi"
      noteTitle="Đọc từ khoá"
      note="No, only, free, required…"
    >
      <p class="mini-label">Biển báo &amp; thông báo · 01</p>
      <div class="sg-hero-sign">
        <span class="sg-hero-sign-top">Notice</span>
        <strong>NO<br>PARKING</strong>
        <span class="sg-hero-sign-foot">Khu vực cấm đỗ xe</span>
      </div>
      <div class="sg-hero-chat">
        <span class="sg-hero-chat-label">Communication</span>
        <p><strong>Would you mind</strong> opening the window?</p>
        <p class="sg-hero-chat-reply">— Not at all.</p>
      </div>
      <div class="mini-chips">
        <span>prohibition</span><span>request</span><span>Not at all.</span>
      </div>
    </StudyStackVisual>
  </Fragment>

  <QuickReview slug="signs" accent="signs" content={quickReviews['signs']!} />

  <!-- MAP -->
  <section class="section" id="map" data-pagefind-title="Bản đồ">
    <div class="container">
      <SectionHead kicker="01 · Bản đồ" title="Bốn nhóm biển báo.">
        Mỗi biển báo hoặc thông báo trong đề đều thuộc một trong bốn nhóm này. Xác định nhóm trước, rồi mới đọc nghĩa chi tiết.
        <p slot="aside" class="section-aside"><span>4</span> nhóm biển<br><span>8</span> chức năng giao tiếp</p>
      </SectionHead>

      <div class="map-grid sg-map-grid">
        <a class="map-card sg-map-card sg-map-ban" href="#signs-ban">
          <p class="map-kicker">01 · Cấm</p>
          <h3>Cấm</h3>
          <p class="map-rule">Điều bạn <strong>không được làm</strong>. Thường bắt đầu bằng <code>No</code>, <code>Do not</code> hoặc <code>Keep out</code>.</p>
          <div class="map-chips">
            <span>NO PARKING</span><span>DO NOT ENTER</span><span>KEEP OUT</span>
          </div>
          <span class="map-link">Xem bảng biển báo →</span>
        </a>

        <a class="map-card sg-map-card sg-map-warning" href="#signs-warning">
          <p class="map-kicker">02 · Cảnh báo</p>
          <h3>Cảnh báo</h3>
          <p class="map-rule">Có <strong>nguy hiểm hoặc rủi ro</strong>. Cần cẩn thận, tránh xa hoặc chú ý khi đi lại.</p>
          <div class="map-chips">
            <span>WET FLOOR</span><span>MIND THE GAP</span><span>BEWARE OF DOG</span>
          </div>
          <span class="map-link">Xem bảng biển báo →</span>
        </a>

        <a class="map-card sg-map-card sg-map-rule" href="#signs-instruction">
          <p class="map-kicker">03 · Cho phép &amp; hướng dẫn</p>
          <h3>Hướng dẫn</h3>
          <p class="map-rule">Cho biết <strong>ai được làm gì hoặc đi lối nào</strong>: đẩy cửa, đi bên trái, chỉ nhân viên.</p>
          <div class="map-chips">
            <span>PUSH</span><span>KEEP LEFT</span><span>QUEUE HERE</span><span>STAFF ONLY</span>
          </div>
          <span class="map-link">Xem bảng biển báo →</span>
        </a>

        <a class="map-card sg-map-card sg-map-info" href="#signs-info">
          <p class="map-kicker">04 · Thông tin</p>
          <h3>Thông tin</h3>
          <p class="map-rule">Giờ mở cửa, giá, điều kiện đặt chỗ hoặc tình trạng dịch vụ. Đọc kỹ <strong>con số</strong> và <strong>từ điều kiện</strong>.</p>
          <div class="map-chips">
            <span>FREE ENTRY</span><span>50% OFF</span><span>BOOKING REQUIRED</span>
          </div>
          <span class="map-link">Xem bảng biển báo →</span>
        </a>
      </div>

      <FigurePanel
        tone="wash"
        kicker="Hình dạng"
        title="Nhìn dạng biển, đoán nhóm."
        caption="Đề thường chỉ in chữ, nhưng hình dạng giúp nhớ nhóm: vòng tròn gạch chéo là cấm, tam giác là cảnh báo, biển xanh là hướng dẫn hoặc thông tin."
      >
        <div class="sg-shape-gallery">
          <article class="sg-shape-card">
            <div class="sg-shape sg-shape-ban" aria-hidden="true"><span>P</span></div>
            <div class="sg-shape-copy">
              <p class="sg-shape-kicker">01 · Cấm</p>
              <h3>Không được làm</h3>
              <p>Vòng tròn đỏ, gạch chéo. Từ khoá: <code>No</code>, <code>Do not</code>, <code>Keep out</code>.</p>
              <div class="sg-shape-chips"><span>NO PARKING</span><span>NO SMOKING</span><span>KEEP OUT</span></div>
            </div>
          </article>

          <article class="sg-shape-card">
            <div class="sg-shape sg-shape-warning" aria-hidden="true"><span>!</span></div>
            <div class="sg-shape-copy">
              <p class="sg-shape-kicker">02 · Cảnh báo</p>
              <h3>Cẩn thận, có rủi ro</h3>
              <p>Tam giác vàng, viền đậm. Từ khoá: <code>Wet</code>, <code>Mind</code>, <code>Beware</code>.</p>
              <div class="sg-shape-chips"><span>WET FLOOR</span><span>MIND THE GAP</span><span>BEWARE OF DOG</span></div>
            </div>
          </article>

          <article class="sg-shape-card">
            <div class="sg-shape sg-shape-rule" aria-hidden="true"><span>←</span></div>
            <div class="sg-shape-copy">
              <p class="sg-shape-kicker">03 · Hướng dẫn</p>
              <h3>Được làm gì, đi lối nào</h3>
              <p>Biển xanh, mũi tên hoặc lệnh ngắn. Từ khoá: <code>Push</code>, <code>Keep left</code>, <code>Queue</code>.</p>
              <div class="sg-shape-chips"><span>PUSH</span><span>KEEP LEFT</span><span>QUEUE HERE</span></div>
            </div>
          </article>

          <article class="sg-shape-card">
            <div class="sg-shape sg-shape-info" aria-hidden="true"><span>i</span></div>
            <div class="sg-shape-copy">
              <p class="sg-shape-kicker">04 · Thông tin</p>
              <h3>Giờ, giá, điều kiện</h3>
              <p>Bảng chữ, thường có số hoặc điều kiện. Từ khoá: <code>Free</code>, <code>Off</code>, <code>Required</code>.</p>
              <div class="sg-shape-chips"><span>FREE ENTRY</span><span>50% OFF</span><span>BOOKING REQUIRED</span></div>
            </div>
          </article>
        </div>
      </FigurePanel>

      <p class="mini-note"><strong>Đừng đoán theo hình:</strong> đề thi thường chỉ in chữ. Hãy đọc đúng từ khoá và loại biển, vì đáp án sai hay đảo nghĩa hoặc thêm thông tin không có trên biển.</p>
    </div>
  </section>

  <!-- STRATEGY -->
  <section class="section section-alt" id="strategy" data-pagefind-title="Chiến lược">
    <div class="container">
      <SectionHead kicker="02 · Chiến lược" title="Đọc một biển báo trong 20 giây.">
        Với câu hỏi biển báo, đừng dịch cả câu. Hãy nhận diện nhóm, gạch từ khoá rồi diễn giải thành một câu ngắn.
        <p slot="aside" class="section-aside"><span>4</span> bước<br><span>20</span> giây / câu</p>
      </SectionHead>

      <div class="sg-step-grid">
        <StepCard
          prefix="sg"
          no="01"
          title="Nhận diện nhóm"
          body="Cấm, cảnh báo, hướng dẫn hay thông tin? Nhóm biển quyết định kiểu đáp án đúng."
          formula="cấm · cảnh báo · hướng dẫn · thông tin"
        />

        <StepCard
          prefix="sg"
          no="02"
          title="Gạch từ khoá"
          body="Chú ý <code>No</code>, <code>Only</code>, <code>Free</code>, <code>Required</code>, <code>Off</code>, <code>Out of order</code>."
          formula="No · only · free · required · off"
        />

        <StepCard
          prefix="sg"
          no="03"
          title="Diễn giải một câu"
          body="Tự hỏi: “Ai được làm?”, “Được làm gì?”, “Không được làm gì?”, “Phải làm gì?” rồi trả lời thật ngắn."
          formula="who · can / can’t / must"
        />

        <StepCard
          prefix="sg"
          no="04"
          title="Loại đáp án sai"
          body="Bỏ đáp án trái nghĩa, quá rộng hoặc thêm chi tiết không xuất hiện trên biển."
          formula="trái nghĩa · quá rộng · không có trong bài"
        />
      </div>

      <div class="sg-keyword-strip" aria-label="Sáu từ khoá quyết định nghĩa của biển báo">
        <div><code>NO</code><span>cấm</span></div>
        <div><code>ONLY</code><span>chỉ dành cho</span></div>
        <div><code>FREE</code><span>miễn phí</span></div>
        <div><code>REQUIRED</code><span>bắt buộc</span></div>
        <div><code>OFF</code><span>giảm giá</span></div>
        <div><code>OUT OF ORDER</code><span>bị hỏng</span></div>
      </div>

      <p class="mini-note"><strong>Câu hỏi thường gặp:</strong> “What does the sign mean?”, “What should you do?”, “What is the notice about?”. Cả ba đều yêu cầu hiểu nghĩa, không phải đọc lại nguyên văn.</p>
    </div>
  </section>

  <!-- SIGNS -->
  <section class="section" id="signs" data-pagefind-title="Biển báo">
    <div class="container">
      <SectionHead kicker="03 · Biển báo" title="20 mẫu biển báo, thông báo.">
        Đây là những mẫu xuất hiện nhiều nhất trong đề lớp 9. Cột cuối là bẫy thường gặp — đọc kỹ để không chọn đáp án đảo nghĩa.
        <p slot="aside" class="section-aside"><span>20</span> mẫu<br><span>4</span> nhóm</p>
      </SectionHead>

      <FilterToolbar
        tabKey="group"
        ariaLabel="Lọc biển báo theo nhóm"
        tabs={[
          { value: 'all', label: 'Tất cả' },
          { value: 'ban', label: 'Cấm' },
          { value: 'warning', label: 'Cảnh báo' },
          { value: 'instruction', label: 'Hướng dẫn' },
          { value: 'info', label: 'Thông tin' },
        ]}
        searchId="sign-search"
        searchLabel="Tìm biển báo hoặc nghĩa"
        placeholder="Tìm “parking”, “miễn phí”, “cấm”…"
        clearId="sign-clear"
        countId="sign-count"
        countText="20/20 mẫu"
      />

      <EmptyState
        id="sign-empty"
        title="Không tìm thấy biển báo"
        text="Thử từ khoá khác hoặc xoá bộ lọc."
        resetId="sign-reset"
      />

      <TableShell
        wrapperClass="table-shell"
        tableClass="data-table sg-table"
        caption="Bảng 20 biển báo, thông báo thường gặp và nghĩa"
        hint
      >
        <thead>
          <tr>
            <th scope="col">Biển / thông báo</th>
            <th scope="col">Nhóm</th>
            <th scope="col">Nghĩa</th>
            <th scope="col">Bẫy thường gặp</th>
          </tr>
        </thead>
        <tbody>
          <tr id="signs-ban" data-group="ban">
            <th scope="row"><code>NO PARKING</code></th>
            <td><span class="sg-cat sg-cat-ban">Cấm</span></td>
            <td>Không được đỗ xe.</td>
            <td>Không phải “có chỗ đỗ xe”.</td>
          </tr>
          <tr data-group="ban">
            <th scope="row"><code>NO SMOKING</code></th>
            <td><span class="sg-cat sg-cat-ban">Cấm</span></td>
            <td>Không được hút thuốc.</td>
            <td>Không phải “khu vực hút thuốc”.</td>
          </tr>
          <tr data-group="ban">
            <th scope="row"><code>DO NOT ENTER</code></th>
            <td><span class="sg-cat sg-cat-ban">Cấm</span></td>
            <td>Không được đi vào.</td>
            <td>Không phải “lối vào”.</td>
          </tr>
          <tr data-group="ban">
            <th scope="row"><code>KEEP OUT</code></th>
            <td><span class="sg-cat sg-cat-ban">Cấm</span></td>
            <td>Không được lại gần hoặc vào khu vực này.</td>
            <td>Không phải “giữ cửa mở”.</td>
          </tr>
          <tr id="signs-instruction" data-group="instruction">
            <th scope="row"><code>STAFF ONLY</code></th>
            <td><span class="sg-cat sg-cat-rule">Hướng dẫn</span></td>
            <td>Chỉ nhân viên được vào.</td>
            <td>Không phải “mọi người đều được vào”.</td>
          </tr>
          <tr id="signs-warning" data-group="warning">
            <th scope="row"><code>DANGER: HIGH VOLTAGE</code></th>
            <td><span class="sg-cat sg-cat-warning">Cảnh báo</span></td>
            <td>Nguy hiểm: điện cao thế.</td>
            <td>Không phải “ổ điện bình thường”.</td>
          </tr>
          <tr data-group="warning">
            <th scope="row"><code>WET FLOOR</code></th>
            <td><span class="sg-cat sg-cat-warning">Cảnh báo</span></td>
            <td>Sàn ướt, coi chừng trượt.</td>
            <td>Không phải “sàn đã lau xong”.</td>
          </tr>
          <tr data-group="warning">
            <th scope="row"><code>MIND THE GAP</code></th>
            <td><span class="sg-cat sg-cat-warning">Cảnh báo</span></td>
            <td>Coi chừng khoảng trống.</td>
            <td>Không phải “đứng chờ ở đây”.</td>
          </tr>
          <tr data-group="warning">
            <th scope="row"><code>BEWARE OF DOG</code></th>
            <td><span class="sg-cat sg-cat-warning">Cảnh báo</span></td>
            <td>Coi chừng chó.</td>
            <td>Không phải “được mang chó vào”.</td>
          </tr>
          <tr data-group="instruction">
            <th scope="row"><code>PUSH / PULL</code></th>
            <td><span class="sg-cat sg-cat-rule">Hướng dẫn</span></td>
            <td>Đẩy / kéo cửa.</td>
            <td>Không phải “cấm mở cửa”.</td>
          </tr>
          <tr data-group="instruction">
            <th scope="row"><code>KEEP LEFT</code></th>
            <td><span class="sg-cat sg-cat-rule">Hướng dẫn</span></td>
            <td>Đi bên trái.</td>
            <td>Không phải “rẽ trái”.</td>
          </tr>
          <tr data-group="instruction">
            <th scope="row"><code>QUEUE HERE</code></th>
            <td><span class="sg-cat sg-cat-rule">Hướng dẫn</span></td>
            <td>Xếp hàng tại đây.</td>
            <td>Không phải “mua vé ở đây”.</td>
          </tr>
          <tr data-group="instruction">
            <th scope="row"><code>USE OTHER DOOR</code></th>
            <td><span class="sg-cat sg-cat-rule">Hướng dẫn</span></td>
            <td>Dùng cửa khác.</td>
            <td>Không phải “cửa này bị khóa vĩnh viễn”.</td>
          </tr>
          <tr id="signs-info" data-group="info">
            <th scope="row"><code>OPEN DAILY 8 A.M.–9 P.M.</code></th>
            <td><span class="sg-cat sg-cat-info">Thông tin</span></td>
            <td>Mở hằng ngày từ 8 giờ đến 21 giờ.</td>
            <td>Không phải “mở cả đêm”.</td>
          </tr>
          <tr data-group="info">
            <th scope="row"><code>FREE ENTRY</code></th>
            <td><span class="sg-cat sg-cat-info">Thông tin</span></td>
            <td>Vào cửa miễn phí.</td>
            <td>Không phải “đồ ăn miễn phí”.</td>
          </tr>
          <tr data-group="info">
            <th scope="row"><code>50% OFF</code></th>
            <td><span class="sg-cat sg-cat-info">Thông tin</span></td>
            <td>Giảm 50% giá.</td>
            <td>Không phải “mua 1 tặng 1”.</td>
          </tr>
          <tr data-group="info">
            <th scope="row"><code>BOOKING REQUIRED</code></th>
            <td><span class="sg-cat sg-cat-info">Thông tin</span></td>
            <td>Phải đặt trước.</td>
            <td>Không phải “không cần đặt trước”.</td>
          </tr>
          <tr data-group="info">
            <th scope="row"><code>OUT OF ORDER</code></th>
            <td><span class="sg-cat sg-cat-info">Thông tin</span></td>
            <td>Máy hoặc hệ thống bị hỏng.</td>
            <td>Không phải “hãy đặt hàng”.</td>
          </tr>
          <tr data-group="info">
            <th scope="row"><code>SOLD OUT</code></th>
            <td><span class="sg-cat sg-cat-info">Thông tin</span></td>
            <td>Hết vé hoặc hết hàng.</td>
            <td>Không phải “đang bán”.</td>
          </tr>
          <tr data-group="ban">
            <th scope="row"><code>NO FOOD OR DRINK</code></th>
            <td><span class="sg-cat sg-cat-ban">Cấm</span></td>
            <td>Không mang đồ ăn hoặc đồ uống vào.</td>
            <td>Không phải “chỉ cấm đồ ăn”.</td>
          </tr>
        </tbody>
      </TableShell>

      <p class="mini-note"><strong>Quy tắc vàng:</strong> đáp án đúng là cách diễn đạt khác của biển, không phải câu dài hơn. Nếu đáp án nhắc đến một chi tiết không có trên biển, hãy loại ngay.</p>
    </div>
  </section>

  <!-- COMMUNICATION -->
  <section class="section section-alt" id="communication" data-pagefind-title="Giao tiếp">
    <div class="container">
      <SectionHead kicker="04 · Giao tiếp" title="Tám chức năng giao tiếp.">
        Mỗi câu hỏi giao tiếp kiểm tra một chức năng: gợi ý, mời, xin lỗi, cảm ơn, nhờ, xin phép, động viên hoặc hỏi sức khoẻ. Hãy chọn câu đáp đúng chức năng, không chỉ đúng ngữ pháp.
        <p slot="aside" class="section-aside"><span>8</span> chức năng<br><span>1</span> quy tắc</p>
      </SectionHead>

      <div class="sg-comm-grid">
        <CommunicationCard
          no="01"
          kicker="Gợi ý"
          title="Gợi ý"
          prompt="<code>Why don’t we + V?</code><br><code>How about + V-ing?</code><br><code>Shall we + V?</code>"
          reply="Good idea. / That sounds great. / I’d love to, but…"
          example="Why don’t we recycle paper? — Good idea."
        />

        <CommunicationCard
          no="02"
          kicker="Mời"
          title="Mời"
          prompt="<code>Would you like to + V?</code><br><code>Are you free + time?</code><br><code>Do you want to + V?</code>"
          reply="I’d love to. Thanks. / I’m sorry, I can’t."
          example="Would you like to join us? — I’d love to. Thanks."
        />

        <CommunicationCard
          no="03"
          kicker="Xin lỗi"
          title="Xin lỗi"
          prompt="<code>I’m sorry for + V-ing.</code><br><code>I’m sorry I’m late.</code><br><code>I apologize for + N/V-ing.</code>"
          reply="That’s all right. / Never mind. / Don’t worry about it."
          example="I’m sorry I’m late. — Never mind."
        />

        <CommunicationCard
          no="04"
          kicker="Cảm ơn"
          title="Cảm ơn"
          prompt="<code>Thank you for + V-ing/N.</code><br><code>Thanks a lot.</code><br><code>I’m grateful for + N.</code>"
          reply="You’re welcome. / Not at all. / It’s my pleasure."
          example="Thank you for your help. — You’re welcome."
        />

        <CommunicationCard
          no="05"
          kicker="Nhờ vả"
          title="Yêu cầu"
          prompt="<code>Can / Could you + V?</code><br><code>Would you mind + V-ing?</code>"
          reply="Sure. / Of course. / Not at all. (đồng ý giúp)"
          example="Would you mind opening the window? — Not at all."
        />

        <CommunicationCard
          no="06"
          kicker="Xin phép"
          title="Cho phép"
          prompt="<code>May I + V?</code><br><code>Can I + V?</code><br><code>Is it OK if I + V?</code>"
          reply="Go ahead. / Yes, of course. / I’m afraid you can’t."
          example="May I use your phone? — I’m afraid you can’t."
        />

        <CommunicationCard
          no="07"
          kicker="Động viên"
          title="Khích lệ"
          prompt="<code>Don’t worry.</code><br><code>You can do it.</code><br><code>Cheer up! / Keep trying!</code>"
          reply="Thanks. I’ll try. / That’s very kind of you."
          example="Don’t worry. You can do it! — Thanks. I’ll try."
        />

        <CommunicationCard
          no="08"
          kicker="Sức khoẻ"
          title="Sức khoẻ"
          prompt="<code>What’s the matter?</code><br><code>You look tired.</code><br><code>Bless you! / Get well soon.</code>"
          reply="I have a headache. / I feel better now. / Thank you."
          example="You look tired. — I have a headache."
        />
      </div>

      <p class="mini-note"><strong>Ba câu dễ nhầm:</strong> “Would you mind…?” + “Not at all.” là <strong>đồng ý giúp</strong> · “Why don’t we…?” là <strong>gợi ý</strong>, không phải hỏi nguyên nhân · “I’m afraid I can’t.” là <strong>từ chối lịch sự</strong>.</p>
    </div>
  </section>

  <!-- SAMPLE -->
  <section class="section sample-start" id="sample" data-pagefind-title="Đề mẫu">
    <div class="container">
      <SectionHead kicker="05 · Đề mẫu" title="Bốn câu, bốn kiểu suy luận.">
        Đọc câu hỏi, tự chọn đáp án rồi mới xem giải thích. Hai câu đầu là biển báo, hai câu sau là giao tiếp.
        <p slot="aside" class="section-aside"><span>2</span> biển báo<br><span>2</span> giao tiếp</p>
      </SectionHead>

      <div class="sg-sample-grid">
        <article class="sg-sample-card">
          <div class="sg-sample-top">
            <span class="sg-sample-tag">Biển báo · Cấm</span>
            <span class="sg-sample-no" aria-hidden="true">01</span>
          </div>
          <div class="sg-sample-sign">
            <span>Notice</span>
            <strong>NO PARKING</strong>
          </div>
          <p class="sg-sample-q">What does the sign mean?</p>
          <ol class="sg-sample-options">
            <li>A. You can park here.</li>
            <li class="is-correct">B. You must not park here.</li>
            <li>C. Parking is free today.</li>
            <li>D. You should park quickly.</li>
          </ol>
          <p class="sg-sample-why"><strong>B.</strong> <code>No + V-ing</code> = cấm làm gì. “Parking” ở đây là việc đỗ xe.</p>
        </article>

        <article class="sg-sample-card">
          <div class="sg-sample-top">
            <span class="sg-sample-tag">Thông báo · Điều kiện</span>
            <span class="sg-sample-no" aria-hidden="true">02</span>
          </div>
          <div class="sg-sample-sign sg-sample-sign-soft">
            <span>Notice</span>
            <strong>BOOKING REQUIRED</strong>
          </div>
          <p class="sg-sample-q">What should you do?</p>
          <ol class="sg-sample-options">
            <li>A. Come at any time.</li>
            <li class="is-correct">B. Book before you come.</li>
            <li>C. Pay at the door.</li>
            <li>D. Wait for a free table.</li>
          </ol>
          <p class="sg-sample-why"><strong>B.</strong> <code>Required</code> = bắt buộc; <code>booking</code> = việc đặt trước.</p>
        </article>

        <article class="sg-sample-card">
          <div class="sg-sample-top">
            <span class="sg-sample-tag">Giao tiếp · Nhờ vả</span>
            <span class="sg-sample-no" aria-hidden="true">03</span>
          </div>
          <div class="sg-sample-context">
            <p><strong>Mai:</strong> “Would you mind opening the window?”</p>
            <p><strong>Nam:</strong> “______”</p>
          </div>
          <p class="sg-sample-q">Chọn câu trả lời phù hợp.</p>
          <ol class="sg-sample-options">
            <li class="is-correct">A. Not at all.</li>
            <li>B. Yes, I would.</li>
            <li>C. You’re welcome.</li>
            <li>D. Never mind.</li>
          </ol>
          <p class="sg-sample-why"><strong>A.</strong> “Not at all.” = không phiền, tức là đồng ý giúp. “You’re welcome.” trả lời cảm ơn.</p>
        </article>

        <article class="sg-sample-card">
          <div class="sg-sample-top">
            <span class="sg-sample-tag">Giao tiếp · Gợi ý</span>
            <span class="sg-sample-no" aria-hidden="true">04</span>
          </div>
          <div class="sg-sample-context">
            <p><strong>Lan:</strong> “Why don’t we join the clean-up campaign?”</p>
            <p><strong>Hoa:</strong> “______”</p>
          </div>
          <p class="sg-sample-q">Chọn câu trả lời phù hợp.</p>
          <ol class="sg-sample-options">
            <li>A. Because we are busy.</li>
            <li class="is-correct">B. Good idea.</li>
            <li>C. You’re welcome.</li>
            <li>D. I’m sorry, I’m late.</li>
          </ol>
          <p class="sg-sample-why"><strong>B.</strong> “Why don’t we…?” là lời gợi ý, nên đáp “Good idea.”, không phải trả lời “Because…”.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- TRAPS -->
  <section class="section section-alt" id="traps" data-pagefind-title="Bẫy đề">
    <div class="container">
      <SectionHead kicker="06 · Bẫy đề" title="Mười lỗi hay mất điểm.">
        Đọc câu sai, câu đúng và lý do. Đây là những lỗi học sinh lớp 9 hay mắc khi làm câu biển báo và giao tiếp.
        <p slot="aside" class="section-aside"><span>10</span> lỗi<br>cần tránh</p>
      </SectionHead>

      <div class="trap-grid">
        <TrapCard
          bad="<strong>NO PARKING</strong> = có chỗ đỗ xe."
          good="<strong>NO PARKING</strong> = không được đỗ xe."
          why="No + V-ing là cấm, không phải thông báo có dịch vụ."
        />

        <TrapCard
          bad="<strong>FREE ENTRY</strong> = đồ ăn miễn phí."
          good="<strong>FREE ENTRY</strong> = vào cửa miễn phí."
          why="Entry là việc vào cửa; không nói gì đến đồ ăn."
        />

        <TrapCard
          bad="<strong>OUT OF ORDER</strong> = hãy đặt hàng."
          good="<strong>OUT OF ORDER</strong> = máy bị hỏng."
          why="Out of order là tình trạng hỏng, không phải lệnh đặt hàng."
        />

        <TrapCard
          bad="<strong>50% OFF</strong> = mua 1 tặng 1."
          good="<strong>50% OFF</strong> = giảm 50% giá."
          why="Off là giảm giá; không phải chương trình tặng hàng."
        />

        <TrapCard
          bad="<strong>BOOKING REQUIRED</strong> = không cần đặt trước."
          good="<strong>BOOKING REQUIRED</strong> = phải đặt trước."
          why="Required là bắt buộc, ngược với “không cần”."
        />

        <TrapCard
          bad="<strong>STAFF ONLY</strong> = mọi người đều được vào."
          good="<strong>STAFF ONLY</strong> = chỉ nhân viên được vào."
          why="Only giới hạn đối tượng; không phải lời mời cho tất cả."
        />

        <TrapCard
          bad="“Would you mind…?” — “Not at all.” = không đồng ý giúp."
          good="“Would you mind…?” — “Not at all.” = đồng ý giúp."
          why="Not at all = không phiền, tức là sẵn lòng giúp."
        />

        <TrapCard
          bad="“Why don’t we…?” — “Because we are busy.”"
          good="“Why don’t we…?” — “Good idea.”"
          why="Đây là lời gợi ý, không phải câu hỏi nguyên nhân."
        />

        <TrapCard
          bad="“I’m afraid I can’t.” = tôi đang sợ."
          good="“I’m afraid I can’t.” = rất tiếc, tôi không thể."
          why="Đây là cách từ chối lịch sự, không phải diễn tả nỗi sợ."
        />

        <TrapCard
          bad="“You’re welcome.” dùng để đáp lời xin lỗi."
          good="“You’re welcome.” dùng để đáp lời cảm ơn."
          why="Đáp lời xin lỗi là “Never mind.” hoặc “That’s all right.”."
        />
      </div>
    </div>
  </section>

