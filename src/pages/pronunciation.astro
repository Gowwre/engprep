---
import '../styles/global.css';
import SheetLayout from '../layouts/SheetLayout.astro';
import FigurePanel from '../components/FigurePanel.astro';
import QuizPanel from '../components/QuizPanel.astro';
import QuickReview from '../components/QuickReview.astro';
import SectionHead from '../components/SectionHead.astro';
import StudyStackVisual from '../components/StudyStackVisual.astro';
import TableShell from '../components/TableShell.astro';
import TrapCard from '../components/TrapCard.astro';
import { quickReviews } from '../data/quick-review';
import '../styles/pronunciation.css';
---

<SheetLayout slug="pronunciation">
  <Fragment slot="visual">
    <StudyStackVisual
      stackClass="pron-stack"
      noteLabel="Mẹo thi"
      noteTitle="Nghe âm cuối"
      note="đừng nhìn chữ cái!"
    >
      <p class="mini-label">Đuôi -ed · Ba cách đọc</p>
      <div class="pron-mini-buckets">
        <div class="pron-mini-bucket pron-t"><span>/t/</span><strong>watched</strong></div>
        <div class="pron-mini-bucket pron-d"><span>/d/</span><strong>played</strong></div>
        <div class="pron-mini-bucket pron-id"><span>/ɪd/</span><strong>needed</strong></div>
      </div>
      <div class="mini-rule"></div>
      <p class="pron-mini-question">Which ending does “stopped” have?</p>
      <div class="pron-mini-choices">
        <span class="is-correct">A. /t/</span>
        <span>B. /d/</span>
        <span>C. /ɪd/</span>
      </div>
      <p class="pron-mini-why"><strong>/t/</strong> · “stop” kết thúc bằng /p/ (vô thanh).</p>
    </StudyStackVisual>
  </Fragment>

  <QuickReview slug="pronunciation" accent="sound" content={quickReviews['pronunciation']!} />

  <!-- MAP -->
  <section class="section" id="map" data-pagefind-title="Bản đồ">
    <div class="container">
      <SectionHead kicker="01 · Bản đồ" title="Bốn nhóm âm, một điểm đầu tiên.">
        Câu 1–2 hỏi phát âm, câu 3–4 hỏi trọng âm. Bốn nhóm này có quy tắc rõ ràng và lặp lại qua các đề.
        <p slot="aside" class="section-aside"><span>4</span> nhóm âm<br><span>16</span> câu hỏi</p>
      </SectionHead>

      <div class="map-grid pron-map-grid">
        <a class="map-card pron-map-card pron-map-ed" href="#ed">
          <p class="map-kicker">01 · Đuôi động từ</p>
          <h3>-ed</h3>
          <p class="map-rule">Ba cách đọc tùy theo âm cuối của từ gốc.</p>
          <div class="map-chips">
            <span>/t/</span><span>/d/</span><span>/ɪd/</span>
          </div>
          <span class="map-link">Xem quy tắc -ed →</span>
        </a>

        <a class="map-card pron-map-card pron-map-s" href="#s">
          <p class="map-kicker">02 · Số nhiều, ngôi 3</p>
          <h3>-s / -es</h3>
          <p class="map-rule">Ba âm /s/, /z/, /ɪz/ theo âm cuối.</p>
          <div class="map-chips">
            <span>/s/</span><span>/z/</span><span>/ɪz/</span>
          </div>
          <span class="map-link">Xem quy tắc -s →</span>
        </a>

        <a class="map-card pron-map-card pron-map-vowel" href="#vowels">
          <p class="map-kicker">03 · Nguyên âm</p>
          <h3>Nguyên âm</h3>
          <p class="map-rule">Các cặp tối thiểu dễ nghe nhầm trong đề.</p>
          <div class="map-chips">
            <span>/ɪ/ – /iː/</span><span>/e/ – /eɪ/</span><span>/æ/ – /ɑː/</span>
          </div>
          <span class="map-link">Xem cặp nguyên âm →</span>
        </a>

        <a class="map-card pron-map-card pron-map-stress" href="#stress">
          <p class="map-kicker">04 · Trọng âm</p>
          <h3>Trọng âm</h3>
          <p class="map-rule">Từ 2 và 3 âm tiết, cùng các đuôi hút trọng âm.</p>
          <div class="map-chips">
            <span>2 syllables</span><span>-tion</span><span>-ity</span><span>-ic</span>
          </div>
          <span class="map-link">Xem quy tắc trọng âm →</span>
        </a>
      </div>

      <p class="mini-note"><strong>Mẹo làm bài:</strong> đọc to từng từ trong đầu, tập trung vào âm cuối hoặc âm tiết được nhấn. Đừng chọn theo mặt chữ — đề phát âm thường đánh vào đúng chỗ chữ và âm không khớp nhau.</p>
    </div>
  </section>

  <!-- ED -->
  <section class="section section-alt" id="ed" data-pagefind-title="-ed">
    <div class="container">
      <SectionHead kicker="02 · Đuôi -ed" title="Nghe âm cuối, đừng nhìn chữ.">
        Đuôi -ed có ba cách đọc: /t/, /d/ và /ɪd/. Cách đọc phụ thuộc vào âm cuối của từ gốc, không phụ thuộc vào chữ cái cuối.
        <p slot="aside" class="section-aside"><span>3</span> cách đọc<br><span>1</span> quy tắc</p>
      </SectionHead>

      <div class="pron-rule-grid">
        <article class="pron-rule-card pron-t">
          <span class="pron-rule-sound">/t/</span>
          <h3>Sau âm vô thanh</h3>
          <p class="pron-rule-desc">/p/, /k/, /f/, /s/, /ʃ/, /tʃ/</p>
          <div class="pron-examples">
            <span>stopped</span><span>watched</span><span>laughed</span><span>missed</span><span>washed</span>
          </div>
        </article>

        <article class="pron-rule-card pron-d">
          <span class="pron-rule-sound">/d/</span>
          <h3>Sau âm hữu thanh</h3>
          <p class="pron-rule-desc">Nguyên âm và các âm hữu thanh còn lại: /b/, /g/, /v/, /z/, /m/, /n/, /l/, /r/, /ð/, /dʒ/</p>
          <div class="pron-examples">
            <span>played</span><span>cleaned</span><span>opened</span><span>listened</span><span>arrived</span>
          </div>
        </article>

        <article class="pron-rule-card pron-id">
          <span class="pron-rule-sound">/ɪd/</span>
          <h3>Sau /t/ và /d/</h3>
          <p class="pron-rule-desc">Thêm một âm tiết: want-ed, need-ed.</p>
          <div class="pron-examples">
            <span>wanted</span><span>needed</span><span>decided</span><span>visited</span><span>started</span>
          </div>
        </article>
      </div>

      <p class="mini-note"><strong>Chốt nhanh:</strong> âm cuối vô thanh → /t/; âm cuối hữu thanh hoặc nguyên âm → /d/; âm cuối là /t/ hoặc /d/ → /ɪd/. “Watched” kết thúc bằng /tʃ/ nên đọc /t/, không phải /ɪd/.</p>

      <div class="pron-exception">
        <strong>Ngoại lệ cần nhớ:</strong> một số tính từ đuôi -ed đọc /ɪd/ dù không kết thúc bằng /t/ hay /d/: <em>naked</em>, <em>wicked</em>, <em>beloved</em>. Đây là ngoại lệ nhỏ; ưu tiên quy tắc chính trước.
      </div>
    </div>
  </section>

  <!-- S -->
  <section class="section" id="s" data-pagefind-title="-s / -es">
    <div class="container">
      <SectionHead kicker="03 · Đuôi -s / -es" title="Ba âm, một mẹo: nhìn âm cuối.">
        Đuôi -s/-es có ba cách đọc: /s/, /z/ và /ɪz/. Đừng thấy -es là mặc định đọc /ɪz/ — phải xét âm cuối của từ gốc.
        <p slot="aside" class="section-aside"><span>3</span> cách đọc<br><span>2</span> lỗi hay gặp</p>
      </SectionHead>

      <div class="pron-rule-grid">
        <article class="pron-rule-card pron-s">
          <span class="pron-rule-sound">/s/</span>
          <h3>Sau âm vô thanh</h3>
          <p class="pron-rule-desc">/p/, /k/, /t/, /f/, /θ/</p>
          <div class="pron-examples">
            <span>stops</span><span>books</span><span>cats</span><span>laughs</span><span>months</span>
          </div>
        </article>

        <article class="pron-rule-card pron-z">
          <span class="pron-rule-sound">/z/</span>
          <h3>Sau âm hữu thanh</h3>
          <p class="pron-rule-desc">Nguyên âm và các âm hữu thanh còn lại.</p>
          <div class="pron-examples">
            <span>plays</span><span>reads</span><span>dogs</span><span>goes</span><span>comes</span>
          </div>
        </article>

        <article class="pron-rule-card pron-iz">
          <span class="pron-rule-sound">/ɪz/</span>
          <h3>Sau âm xuýt</h3>
          <p class="pron-rule-desc">/s/, /z/, /ʃ/, /ʒ/, /tʃ/, /dʒ/</p>
          <div class="pron-examples">
            <span>misses</span><span>buzzes</span><span>washes</span><span>watches</span><span>changes</span>
          </div>
        </article>
      </div>

      <p class="mini-note"><strong>Đừng nhầm:</strong> -es trong chữ không luôn đọc /ɪz/. <em>Goes</em> và <em>does</em> đọc /z/; <em>watches</em> và <em>changes</em> mới đọc /ɪz/. Hãy nghe âm cuối của từ gốc.</p>

      <FigurePanel
        kicker="Sơ đồ chọn nhanh"
        title="Âm cuối quyết định cách đọc."
        caption="Chỉ cần xác định âm cuối của từ gốc, không nhìn chữ -ed hay -es. Ba nhánh màu tương ứng ba cách đọc."
      >
        <div class="pron-sorter">
          <div class="pron-sorter-block">
            <div class="pron-sorter-start">
              <span>-ed</span>
              <strong>âm cuối</strong>
            </div>
            <div class="pron-sorter-branches">
              <div class="pron-sorter-branch pron-t">
                <span>vô thanh · /p k f s ʃ tʃ/</span>
                <strong>/t/</strong>
                <em>watched · stopped · laughed</em>
              </div>
              <div class="pron-sorter-branch pron-d">
                <span>hữu thanh · còn lại</span>
                <strong>/d/</strong>
                <em>played · cleaned · opened</em>
              </div>
              <div class="pron-sorter-branch pron-id">
                <span>kết thúc bằng /t/ hoặc /d/</span>
                <strong>/ɪd/</strong>
                <em>wanted · needed · decided</em>
              </div>
            </div>
          </div>

          <div class="pron-sorter-block">
            <div class="pron-sorter-start">
              <span>-s / -es</span>
              <strong>âm cuối</strong>
            </div>
            <div class="pron-sorter-branches">
              <div class="pron-sorter-branch pron-s">
                <span>vô thanh · /p k t f θ/</span>
                <strong>/s/</strong>
                <em>stops · books · months</em>
              </div>
              <div class="pron-sorter-branch pron-z">
                <span>hữu thanh · còn lại</span>
                <strong>/z/</strong>
                <em>plays · reads · goes</em>
              </div>
              <div class="pron-sorter-branch pron-iz">
                <span>âm xuýt · /s z ʃ ʒ tʃ dʒ/</span>
                <strong>/ɪz/</strong>
                <em>misses · watches · changes</em>
              </div>
            </div>
          </div>
        </div>
      </FigurePanel>
    </div>
  </section>

  <!-- VOWELS -->
  <section class="section section-alt" id="vowels" data-pagefind-title="Nguyên âm">
    <div class="container">
      <SectionHead kicker="04 · Nguyên âm" title="Học theo cặp, đừng học lẻ.">
        Câu hỏi phát âm thường đưa bốn từ có cùng cách viết nhưng khác âm. Học các cặp tối thiểu (minimal pairs) để phân biệt nhanh.
        <p slot="aside" class="section-aside"><span>6</span> cặp âm<br><span>2</span> nhóm dấu hiệu</p>
      </SectionHead>

      <TableShell
        wrapperClass="table-shell"
        tableClass="data-table pron-table pron-vowel-table"
        caption="Các cặp nguyên âm dễ nhầm trong tiếng Anh"
        hint
      >
        <thead>
          <tr>
            <th scope="col">Cặp âm</th>
            <th scope="col">Ví dụ</th>
            <th scope="col">Dấu hiệu / mẹo nhớ</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <th scope="row"><code>/ɪ/ – /iː/</code></th>
            <td><code>sit /sɪt/</code> · <code>seat /siːt/</code> · <code>ship /ʃɪp/</code> · <code>sheep /ʃiːp/</code></td>
            <td>/ɪ/ ngắn, /iː/ dài. Chú ý <em>i</em> ngắn và <em>ea/ee</em> dài.</td>
          </tr>
          <tr>
            <th scope="row"><code>/e/ – /eɪ/</code></th>
            <td><code>pen /pen/</code> · <code>pain /peɪn/</code> · <code>met /met/</code> · <code>mate /meɪt/</code></td>
            <td>/e/ ngắn; /eɪ/ là âm đôi, thường gặp ở <em>a-e</em> hoặc <em>ai</em>.</td>
          </tr>
          <tr>
            <th scope="row"><code>/æ/ – /ɑː/</code></th>
            <td><code>cat /kæt/</code> · <code>cart /kɑːt/</code> · <code>hat /hæt/</code> · <code>heart /hɑːt/</code></td>
            <td>/æ/ ngắn và bẹt; /ɑː/ dài, thường có <em>r</em> sau <em>a</em>.</td>
          </tr>
          <tr>
            <th scope="row"><code>/ʌ/ – /ɒ/</code></th>
            <td><code>cut /kʌt/</code> · <code>cot /kɒt/</code> · <code>luck /lʌk/</code> · <code>lock /lɒk/</code></td>
            <td>/ʌ/ thường viết bằng <em>u</em>; /ɒ/ thường viết bằng <em>o</em>.</td>
          </tr>
          <tr>
            <th scope="row"><code>/uː/ – /ʊ/</code></th>
            <td><code>food /fuːd/</code> · <code>foot /fʊt/</code> · <code>pool /puːl/</code> · <code>pull /pʊl/</code></td>
            <td>/uː/ dài; /ʊ/ ngắn. Cùng viết <em>oo</em> nhưng khác âm.</td>
          </tr>
          <tr>
            <th scope="row"><code>/ə/</code></th>
            <td><code>teacher /ˈtiːtʃə/</code> · <code>about /əˈbaʊt/</code> · <code>banana /bəˈnɑːnə/</code></td>
            <td>Âm yếu ở âm tiết không nhấn; không đọc rõ như <em>a</em>.</td>
          </tr>
        </tbody>
      </TableShell>

      <div class="pron-spelling">
        <div class="pron-spelling-head">
          <h3>Chữ và âm không phải lúc nào cũng khớp</h3>
          <span>nhìn chữ, nghe âm</span>
        </div>
        <div class="pron-spelling-grid">
          <div><code>ea</code><span>/iː/ seat · /e/ bread · /eɪ/ great</span></div>
          <div><code>i</code><span>/ɪ/ sit · /aɪ/ time · /iː/ machine</span></div>
          <div><code>a</code><span>/æ/ cat · /eɪ/ name · /ɑː/ car · /ə/ about</span></div>
          <div><code>âm câm</code><span>hour · honest · know · knife · write · listen · castle · island</span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- STRESS -->
  <section class="section" id="stress" data-pagefind-title="Trọng âm">
    <div class="container">
      <SectionHead kicker="05 · Trọng âm" title="Đếm âm tiết, đừng đếm chữ cái.">
        Trọng âm là âm tiết được đọc mạnh và rõ hơn. Với từ 2–3 âm tiết, có vài quy tắc đủ để xử lý phần lớn câu hỏi.
        <p slot="aside" class="section-aside"><span>2</span> nhóm từ<br><span>6</span> đuôi hút trọng âm</p>
      </SectionHead>

      <div class="pron-stress-grid">
        <article class="pron-stress-card">
          <p class="pron-stress-label">Từ 2 âm tiết</p>
          <h3>Danh từ / tính từ vs động từ</h3>
          <ul class="pron-stress-list">
            <li><strong>Danh từ, tính từ</strong> thường nhấn âm 1: <em>TAble, HAPpy, DOCtor, MUsic.</em></li>
            <li><strong>Động từ</strong> thường nhấn âm 2: <em>beGIN, deCIDE, enJOY, forGET.</em></li>
            <li>Có từ đổi trọng âm theo từ loại: <em>REcord</em> (n) – <em>reCORD</em> (v); <em>PREsent</em> (n/adj) – <em>preSENT</em> (v).</li>
          </ul>
        </article>

        <article class="pron-stress-card">
          <p class="pron-stress-label">Từ 3 âm tiết</p>
          <h3>Đuôi từ quyết định</h3>
          <ul class="pron-stress-list">
            <li><strong>-tion / -sion:</strong> nhấn âm trước đuôi: <em>deCIsion, eduCAtion, atTENtion.</em></li>
            <li><strong>-ic / -ical:</strong> nhấn âm trước: <em>scienTIfic, ecoNOmic, hisTORical.</em></li>
            <li><strong>-ity / -ial / -ious:</strong> nhấn âm trước: <em>aBIlity, comMERcial, deLIcious.</em></li>
            <li>Nhiều danh từ/tính từ 3 âm tiết nhấn âm 1: <em>BEAUtiful, ACCident, INteresting.</em></li>
          </ul>
        </article>
      </div>

      <div class="pron-shift" aria-label="Trọng âm thay đổi trong họ từ photograph">
        <div class="pron-shift-head">
          <h3>Cùng một họ từ, trọng âm có thể di chuyển</h3>
          <span>photograph → photography → photographic</span>
        </div>
        <div class="pron-shift-row">
          <div><strong><span>PHO</span>·to·graph</strong><small>trọng âm 1</small></div>
          <span class="pron-shift-arrow" aria-hidden="true">→</span>
          <div><strong>pho·<span>TOG</span>·ra·phy</strong><small>trọng âm 2</small></div>
          <span class="pron-shift-arrow" aria-hidden="true">→</span>
          <div><strong>pho·to·<span>GRAPH</span>·ic</strong><small>trọng âm 3</small></div>
        </div>
        <p>Đừng học trọng âm của cả họ từ như một từ duy nhất. Gặp từ mới, hãy đánh dấu âm tiết được nhấn.</p>
      </div>

      <TableShell
        wrapperClass="table-shell"
        tableClass="data-table pron-table pron-suffix-table"
        caption="Ảnh hưởng của đuôi từ đến trọng âm"
        hint
      >
        <thead>
          <tr>
            <th scope="col">Đuôi từ</th>
            <th scope="col">Ảnh hưởng đến trọng âm</th>
            <th scope="col">Ví dụ</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <th scope="row"><code>-tion / -sion</code></th>
            <td>Nhấn âm tiết ngay trước đuôi.</td>
            <td><code>deCIsion</code> · <code>eduCAtion</code> · <code>atTENtion</code></td>
          </tr>
          <tr>
            <th scope="row"><code>-ic / -ical</code></th>
            <td>Nhấn âm tiết ngay trước đuôi.</td>
            <td><code>scienTIfic</code> · <code>ecoNOmic</code> · <code>hisTORical</code></td>
          </tr>
          <tr>
            <th scope="row"><code>-ity</code></th>
            <td>Nhấn âm tiết ngay trước đuôi.</td>
            <td><code>aBIlity</code> · <code>popuLArity</code> · <code>possIbility</code></td>
          </tr>
          <tr>
            <th scope="row"><code>-ial / -ious</code></th>
            <td>Nhấn âm tiết ngay trước đuôi.</td>
            <td><code>comMERcial</code> · <code>deLIcious</code></td>
          </tr>
          <tr>
            <th scope="row"><code>-ed / -ing / -s / -ly</code></th>
            <td>Thường không làm đổi trọng âm của từ gốc.</td>
            <td><code>HAPpy → HAPpily</code> · <code>deVELop → deVELoping</code></td>
          </tr>
          <tr>
            <th scope="row"><code>-ment / -ness / -ful / -less</code></th>
            <td>Thường không làm đổi trọng âm của từ gốc.</td>
            <td><code>deVELop → deVELopment</code> · <code>HAPpy → HAPpiness</code></td>
          </tr>
          <tr>
            <th scope="row"><code>-able / -ible</code></th>
            <td>Thường không làm đổi trọng âm của từ gốc.</td>
            <td><code>COMfort → COMfortable</code> · <code>POSsible → POSsibly</code></td>
          </tr>
        </tbody>
      </TableShell>

      <div class="pron-word-pairs">
        <h3>Danh từ – động từ cùng gốc</h3>
        <div class="pron-word-pairs-grid">
          <span><strong>REcord</strong> (n) · reCORD (v)</span>
