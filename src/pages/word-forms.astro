    <div class="container">
      <SectionHead kicker="06 · Bẫy đề" title="Mười lỗi hay mất điểm.">
        Xem câu sai, câu đúng và lý do. Đây là những lỗi học sinh lớp 9 hay mắc nhất khi làm phần từ loại.
        <p slot="aside" class="section-aside"><span>10</span> lỗi<br>cần sửa</p>
      </SectionHead>

      <div class="trap-grid">
        <TrapCard
          bad="I am very <strong>interesting</strong> in music."
          good="I am very <strong>interested</strong> in music."
          why="Người cảm thấy → -ed; vật/việc gây cảm giác → -ing."
        />

        <TrapCard
          bad="The film was so <strong>bored</strong> that we fell asleep."
          good="The film was so <strong>boring</strong> that we fell asleep."
          why="Bộ phim gây cảm giác buồn chán → boring. Người cảm thấy buồn chán → bored."
        />

        <TrapCard
          bad="She gave me a good <strong>advise</strong>."
          good="She gave me a good <strong>advice</strong>."
          why="advice là danh từ không đếm được; advise là động từ: She advised me to study."
        />

        <TrapCard
          bad="The weather <strong>effects</strong> my mood."
          good="The weather <strong>affects</strong> my mood."
          why="affect là động từ (ảnh hưởng); effect là danh từ (tác động): the effect of the weather."
        />

        <TrapCard
          bad="He is a <strong>success</strong> businessman."
          good="He is a <strong>successful</strong> businessman."
          why="Trước danh từ businessman cần tính từ successful, không dùng danh từ success."
        />

        <TrapCard
          bad="We need a more <strong>economic</strong> car."
          good="We need a more <strong>economical</strong> car."
          why="economic = thuộc kinh tế; economical = tiết kiệm, ít tốn kém."
        />

        <TrapCard
          bad="She studies very <strong>hardly</strong>."
          good="She studies very <strong>hard</strong>."
          why="hard = chăm chỉ; hardly = hầu như không. Đừng thêm -ly vào hard khi muốn nói “chăm chỉ”."
        />

        <TrapCard
          bad="He came <strong>lately</strong> yesterday."
          good="He came <strong>late</strong> yesterday."
          why="late = muộn; lately = gần đây. “Yesterday” cần late, không phải lately."
        />

        <TrapCard
          bad="She speaks very <strong>friendly</strong>."
          good="She speaks <strong>in a friendly way</strong>."
          why="friendly là tính từ, không phải trạng từ. Muốn bổ nghĩa cho động từ, dùng “in a friendly way”."
        />

        <TrapCard
          bad="She sings very <strong>good</strong>."
          good="She sings very <strong>well</strong>."
          why="good là tính từ; well là trạng từ bất quy tắc của good."
        />
      </div>
    </div>
  </section>

  <!-- QUIZ -->
