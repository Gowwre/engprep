    <div class="container">
      <SectionHead kicker="06 · Bẫy đề" title="Tám lỗi rất dễ mất điểm.">
        Đọc câu sai, câu đúng và lý do. Đây là những lỗi học sinh lớp 9 hay mắc nhất khi làm bài về thì.
        <p slot="aside" class="section-aside"><span>8</span> lỗi<br>cần sửa</p>
      </SectionHead>

      <div class="trap-grid">
        <TrapCard
          bad="She <strong>don't</strong> like conical hats."
          good="She <strong>doesn't</strong> like conical hats."
          why="Chủ ngữ số ít (he/she/it) đi với doesn't, không đi với don't."
        />

        <TrapCard
          bad="I have <strong>saw</strong> that film."
          good="I have <strong>seen</strong> that film."
          why="Sau have/has phải là V3 (quá khứ phân từ), không phải V2."
        />

        <TrapCard
          bad="I <strong>have visited</strong> Hue <strong>last year</strong>."
          good="I <strong>visited</strong> Hue last year."
          why="“Last year” là thời gian đã kết thúc → dùng quá khứ đơn."
        />

        <TrapCard
          bad="When I was walking home, I <strong>was seeing</strong> him."
          good="When I was walking home, I <strong>saw</strong> him."
          why="Hành động ngắn xen vào dùng quá khứ đơn, không dùng thì tiếp diễn."
        />

        <TrapCard
          bad="By the time we arrived, the show <strong>started</strong>."
          good="By the time we arrived, the show <strong>had started</strong>."
          why="Hành động xảy ra trước một hành động quá khứ khác dùng quá khứ hoàn thành."
        />

        <TrapCard
          bad="I <strong>am knowing</strong> the answer."
          good="I <strong>know</strong> the answer."
          why="Know là động từ trạng thái, không chia ở thì tiếp diễn."
        />

        <TrapCard
          bad="She has lived here <strong>since three years</strong>."
          good="She has lived here <strong>for three years</strong>."
          why="since + mốc thời gian (since 2020); for + khoảng thời gian (for three years)."
        />

        <TrapCard
          bad="<strong>If it will rain</strong>, we will stay home."
          good="<strong>If it rains</strong>, we will stay home."
          why="Mệnh đề if của câu điều kiện loại 1 dùng hiện tại đơn, không dùng will."
        />
      </div>
    </div>
  </section>

