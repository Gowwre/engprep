---
import SheetLayout from '../layouts/SheetLayout.astro';
---

<SheetLayout slug="tenses">
  <Fragment slot="visual">
    <div class="study-stack">
      <div class="stack-card stack-card-back"></div>
      <div class="stack-card stack-card-mid"></div>
      <div class="stack-card stack-card-front">
        <p class="mini-label">Hiện tại hoàn thành</p>
        <p class="mini-formula">S + have/has<br>+ V3/ed</p>
        <div class="mini-rule"></div>
        <p class="mini-desc">Đã từng làm · Kết quả còn ảnh hưởng · Kéo dài đến hiện tại</p>
        <div class="mini-chips">
          <span>since 2015</span><span>for 3 years</span><span>already</span><span>just</span>
        </div>
        <p class="mini-example">I <mark>have visited</mark> Hue three times.</p>
        <p class="mini-translation">Mình đã đến Huế ba lần rồi.</p>
      </div>
    </div>
    <div class="sticky-note">
      <span class="sticky-label">Mẹo thi</span>
      <strong>While + quá khứ tiếp diễn</strong>
      <span>nhớ dạng viết lại câu!</span>
    </div>
    <div class="stamp">Ôn thi<br>giữa kỳ I<br><span>2026–2027</span></div>
  </Fragment>

  <!-- MAP -->
  <section class="section" id="map">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="section-kicker">01 · Sơ đồ</p>
          <h2>Nhìn một lần, thấy cả 12 thì.</h2>
          <p>Bốn dạng, ba mốc thời gian. Bấm vào ô bất kỳ để xem chi tiết bên dưới.</p>
        </div>
        <p class="section-aside"><span>4</span> dạng<br><span>3</span> mốc</p>
      </div>

      <div class="map-panel">
        <div class="map-scroll">
          <table class="tense-map">
            <caption class="sr-only">Sơ đồ 12 thì tiếng Anh theo dạng và mốc thời gian</caption>
            <thead>
              <tr>
                <th scope="col"><span class="sr-only">Dạng</span></th>
                <th scope="col">Hiện tại</th>
                <th scope="col">Quá khứ</th>
                <th scope="col">Tương lai</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <th scope="row"><span class="aspect"><strong>Đơn</strong><span>Simple</span></span></th>
                <td><a class="map-cell map-cell-present" href="#present-simple"><strong>Hiện tại đơn</strong><em>Present Simple</em><code>S + V(s/es)</code></a></td>
                <td><a class="map-cell map-cell-past" href="#past-simple"><strong>Quá khứ đơn</strong><em>Past Simple</em><code>S + V2/ed</code></a></td>
                <td><a class="map-cell map-cell-future" href="#future-simple"><strong>Tương lai đơn</strong><em>Future Simple</em><code>S + will + V</code></a></td>
              </tr>
              <tr>
                <th scope="row"><span class="aspect"><strong>Tiếp diễn</strong><span>Continuous</span></span></th>
                <td><a class="map-cell map-cell-present" href="#present-continuous"><strong>Hiện tại tiếp diễn</strong><em>Present Continuous</em><code>S + am/is/are + V-ing</code></a></td>
                <td><a class="map-cell map-cell-past" href="#past-continuous"><strong>Quá khứ tiếp diễn</strong><em>Past Continuous</em><code>S + was/were + V-ing</code></a></td>
                <td><a class="map-cell map-cell-future" href="#future-continuous"><strong>Tương lai tiếp diễn</strong><em>Future Continuous</em><code>S + will be + V-ing</code></a></td>
              </tr>
              <tr>
                <th scope="row"><span class="aspect"><strong>Hoàn thành</strong><span>Perfect</span></span></th>
                <td><a class="map-cell map-cell-present" href="#present-perfect"><strong>Hiện tại hoàn thành</strong><em>Present Perfect</em><code>S + have/has + V3/ed</code></a></td>
                <td><a class="map-cell map-cell-past" href="#past-perfect"><strong>Quá khứ hoàn thành</strong><em>Past Perfect</em><code>S + had + V3/ed</code></a></td>
                <td><a class="map-cell map-cell-future" href="#future-perfect"><strong>Tương lai hoàn thành</strong><em>Future Perfect</em><code>S + will have + V3/ed</code></a></td>
              </tr>
              <tr>
                <th scope="row"><span class="aspect"><strong>Hoàn thành tiếp diễn</strong><span>Perfect Continuous</span></span></th>
                <td><a class="map-cell map-cell-present" href="#present-perfect-continuous"><strong>Hiện tại hoàn thành tiếp diễn</strong><em>Present Perfect Continuous</em><code>S + have/has been + V-ing</code></a></td>
                <td><a class="map-cell map-cell-past" href="#past-perfect-continuous"><strong>Quá khứ hoàn thành tiếp diễn</strong><em>Past Perfect Continuous</em><code>S + had been + V-ing</code></a></td>
                <td><a class="map-cell map-cell-future" href="#future-perfect-continuous"><strong>Tương lai hoàn thành tiếp diễn</strong><em>Future Perfect Continuous</em><code>S + will have been + V-ing</code></a></td>
              </tr>
            </tbody>
          </table>
        </div>

        <div class="map-mobile" aria-label="Sơ đồ 12 thì theo mốc thời gian">
          <section class="map-mobile-group">
            <h3><span class="map-dot"></span>Hiện tại</h3>
            <div class="map-mobile-list">
              <a href="#present-simple"><span><strong>Hiện tại đơn</strong><em>Present Simple</em></span><code>S + V(s/es)</code></a>
              <a href="#present-continuous"><span><strong>Hiện tại tiếp diễn</strong><em>Present Continuous</em></span><code>S + am/is/are + V-ing</code></a>
              <a href="#present-perfect"><span><strong>Hiện tại hoàn thành</strong><em>Present Perfect</em></span><code>S + have/has + V3/ed</code></a>
              <a href="#present-perfect-continuous"><span><strong>Hiện tại hoàn thành tiếp diễn</strong><em>Present Perfect Continuous</em></span><code>S + have/has been + V-ing</code></a>
            </div>
          </section>
          <section class="map-mobile-group">
            <h3><span class="map-dot"></span>Quá khứ</h3>
            <div class="map-mobile-list">
              <a href="#past-simple"><span><strong>Quá khứ đơn</strong><em>Past Simple</em></span><code>S + V2/ed</code></a>
              <a href="#past-continuous"><span><strong>Quá khứ tiếp diễn</strong><em>Past Continuous</em></span><code>S + was/were + V-ing</code></a>
              <a href="#past-perfect"><span><strong>Quá khứ hoàn thành</strong><em>Past Perfect</em></span><code>S + had + V3/ed</code></a>
              <a href="#past-perfect-continuous"><span><strong>Quá khứ hoàn thành tiếp diễn</strong><em>Past Perfect Continuous</em></span><code>S + had been + V-ing</code></a>
            </div>
          </section>
          <section class="map-mobile-group">
            <h3><span class="map-dot"></span>Tương lai</h3>
            <div class="map-mobile-list">
              <a href="#future-simple"><span><strong>Tương lai đơn</strong><em>Future Simple</em></span><code>S + will + V</code></a>
              <a href="#future-continuous"><span><strong>Tương lai tiếp diễn</strong><em>Future Continuous</em></span><code>S + will be + V-ing</code></a>
              <a href="#future-perfect"><span><strong>Tương lai hoàn thành</strong><em>Future Perfect</em></span><code>S + will have + V3/ed</code></a>
              <a href="#future-perfect-continuous"><span><strong>Tương lai hoàn thành tiếp diễn</strong><em>Future Perfect Continuous</em></span><code>S + will have been + V-ing</code></a>
            </div>
          </section>
        </div>

      </div>
    </div>
  </section>

  <!-- TIMELINE -->
  <section class="section section-alt section-timeline" id="timeline">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="section-kicker">02 · Dòng thời gian</p>
          <h2>12 thì trên một trục thời gian.</h2>
          <p>Mỗi hàng là một dạng thì. Chấm tròn thể hiện hành động ngắn, thanh dài thể hiện hành động kéo dài, dấu ✓ nghĩa là đã hoàn thành trước một mốc. Bấm vào từng thì để xem chi tiết.</p>
        </div>
        <p class="section-aside"><span>4</span> dạng<br><span>12</span> mốc</p>
      </div>

      <div class="timeline-panel">
        <div class="timeline-axis">
          <span class="timeline-axis-spacer" aria-hidden="true"></span>
          <div class="timeline-axis-track">
            <span class="tl-axis-past">← Quá khứ</span>
            <span class="tl-axis-now"><i aria-hidden="true"></i>Bây giờ</span>
            <span class="tl-axis-future">Tương lai →</span>
          </div>
        </div>

        <div class="tl-lane">
          <h3 class="tl-lane-head"><strong>Đơn</strong><span>Simple</span></h3>
          <div class="tl-track">
            <span class="tl-now" aria-hidden="true"></span>
            <a class="tl-node tl-node--past tl-node--simple" href="#past-simple">
              <span class="tl-glyph" aria-hidden="true"><span class="tl-bar"></span><span class="tl-dot"></span></span>
              <span class="tl-copy"><strong><span class="tl-name-full">Quá khứ đơn</span><span class="tl-name-short">Quá khứ</span></strong><em>did</em></span>
            </a>
            <a class="tl-node tl-node--present tl-node--simple tl-node--habit" href="#present-simple">
              <span class="tl-glyph" aria-hidden="true"><span class="tl-bar"></span><span class="tl-dot"></span></span>
              <span class="tl-copy"><strong><span class="tl-name-full">Hiện tại đơn</span><span class="tl-name-short">Hiện tại</span></strong><em>does</em></span>
            </a>
            <a class="tl-node tl-node--future tl-node--simple" href="#future-simple">
              <span class="tl-glyph" aria-hidden="true"><span class="tl-bar"></span><span class="tl-dot"></span></span>
              <span class="tl-copy"><strong><span class="tl-name-full">Tương lai đơn</span><span class="tl-name-short">Tương lai</span></strong><em>will do</em></span>
            </a>
          </div>
        </div>

        <div class="tl-lane">
          <h3 class="tl-lane-head"><strong>Tiếp diễn</strong><span>Continuous</span></h3>
          <div class="tl-track">
            <span class="tl-now" aria-hidden="true"></span>
            <a class="tl-node tl-node--past tl-node--continuous" href="#past-continuous">
              <span class="tl-glyph" aria-hidden="true"><span class="tl-bar"></span><span class="tl-dot"></span></span>
              <span class="tl-copy"><strong><span class="tl-name-full">Quá khứ tiếp diễn</span><span class="tl-name-short">Quá khứ</span></strong><em>was doing</em></span>
            </a>
            <a class="tl-node tl-node--present tl-node--continuous" href="#present-continuous">
              <span class="tl-glyph" aria-hidden="true"><span class="tl-bar"></span><span class="tl-dot"></span></span>
              <span class="tl-copy"><strong><span class="tl-name-full">Hiện tại tiếp diễn</span><span class="tl-name-short">Hiện tại</span></strong><em>is doing</em></span>
            </a>
            <a class="tl-node tl-node--future tl-node--continuous" href="#future-continuous">
              <span class="tl-glyph" aria-hidden="true"><span class="tl-bar"></span><span class="tl-dot"></span></span>
              <span class="tl-copy"><strong><span class="tl-name-full">Tương lai tiếp diễn</span><span class="tl-name-short">Tương lai</span></strong><em>will be doing</em></span>
            </a>
          </div>
        </div>

        <div class="tl-lane">
          <h3 class="tl-lane-head"><strong>Hoàn thành</strong><span>Perfect</span></h3>
          <div class="tl-track">
            <span class="tl-now" aria-hidden="true"></span>
            <a class="tl-node tl-node--past tl-node--perfect" href="#past-perfect">
              <span class="tl-glyph" aria-hidden="true"><span class="tl-bar"></span><span class="tl-dot"></span></span>
              <span class="tl-copy"><strong><span class="tl-name-full">Quá khứ hoàn thành</span><span class="tl-name-short">Quá khứ</span></strong><em>had done</em></span>
            </a>
            <a class="tl-node tl-node--present tl-node--perfect" href="#present-perfect">
              <span class="tl-glyph" aria-hidden="true"><span class="tl-bar"></span><span class="tl-dot"></span></span>
              <span class="tl-copy"><strong><span class="tl-name-full">Hiện tại hoàn thành</span><span class="tl-name-short">Hiện tại</span></strong><em>have done</em></span>
            </a>
            <a class="tl-node tl-node--future tl-node--perfect" href="#future-perfect">
              <span class="tl-glyph" aria-hidden="true"><span class="tl-bar"></span><span class="tl-dot"></span></span>
              <span class="tl-copy"><strong><span class="tl-name-full">Tương lai hoàn thành</span><span class="tl-name-short">Tương lai</span></strong><em>will have done</em></span>
            </a>
          </div>
        </div>

        <div class="tl-lane">
          <h3 class="tl-lane-head"><strong>Hoàn thành tiếp diễn</strong><span>Perfect Continuous</span></h3>
          <div class="tl-track">
            <span class="tl-now" aria-hidden="true"></span>
            <a class="tl-node tl-node--past tl-node--perfect tl-node--perfect-continuous" href="#past-perfect-continuous">
              <span class="tl-glyph" aria-hidden="true"><span class="tl-bar"></span><span class="tl-dot"></span></span>
              <span class="tl-copy"><strong><span class="tl-name-full">Quá khứ hoàn thành tiếp diễn</span><span class="tl-name-short">Quá khứ</span></strong><em>had been doing</em></span>
            </a>
            <a class="tl-node tl-node--present tl-node--perfect tl-node--perfect-continuous" href="#present-perfect-continuous">
              <span class="tl-glyph" aria-hidden="true"><span class="tl-bar"></span><span class="tl-dot"></span></span>
              <span class="tl-copy"><strong><span class="tl-name-full">Hiện tại hoàn thành tiếp diễn</span><span class="tl-name-short">Hiện tại</span></strong><em>have been doing</em></span>
            </a>
            <a class="tl-node tl-node--future tl-node--perfect tl-node--perfect-continuous" href="#future-perfect-continuous">
              <span class="tl-glyph" aria-hidden="true"><span class="tl-bar"></span><span class="tl-dot"></span></span>
              <span class="tl-copy"><strong><span class="tl-name-full">Tương lai hoàn thành tiếp diễn</span><span class="tl-name-short">Tương lai</span></strong><em>will have been doing</em></span>
            </a>
          </div>
        </div>

        <div class="timeline-legend">
          <span><i class="tl-key tl-key--dot" aria-hidden="true"></i>Hành động ngắn, thói quen</span>
          <span><i class="tl-key tl-key--bar" aria-hidden="true"></i>Hành động kéo dài</span>
          <span><i class="tl-key tl-key--check" aria-hidden="true">✓</i>Hoàn thành trước một mốc</span>
        </div>
      </div>
    </div>
  </section>

  <!-- TENSES -->
  <section class="section section-tenses" id="tenses">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="section-kicker">03 · Tổng hợp</p>
          <h2>12 thì, đủ để thi.</h2>
          <p>Mỗi thẻ có công thức, cách dùng, dấu hiệu, ví dụ và lỗi thường gặp. Dùng nút lọc hoặc ô tìm kiếm khi cần ôn nhanh.</p>
        </div>
        <p class="section-aside"><span>12</span> thẻ<br>in khổ A4</p>
      </div>

      <p class="formula-legend"><strong>S:</strong> chủ ngữ · <strong>V:</strong> động từ nguyên mẫu · <strong>V-ing:</strong> động từ thêm -ing · <strong>V2/ed:</strong> quá khứ đơn · <strong>V3/ed:</strong> quá khứ phân từ</p>

      <div class="toolbar">
        <div class="filter-tabs" role="group" aria-label="Lọc theo mốc thời gian">
          <button class="filter-tab" type="button" data-group="all" aria-pressed="true">Tất cả</button>
          <button class="filter-tab" type="button" data-group="present" aria-pressed="false">Hiện tại</button>
          <button class="filter-tab" type="button" data-group="past" aria-pressed="false">Quá khứ</button>
          <button class="filter-tab" type="button" data-group="future" aria-pressed="false">Tương lai</button>
        </div>

        <div class="search-wrap">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
          <label class="sr-only" for="tense-search">Tìm thì, dấu hiệu hoặc ví dụ</label>
          <input id="tense-search" type="search" placeholder="Tìm “since”, “while”, “tương lai”…" autocomplete="off">
          <button class="search-clear" id="search-clear" type="button" aria-label="Xoá tìm kiếm" hidden>&times;</button>
        </div>

        <span class="result-count" id="result-count" aria-live="polite">12/12 thì</span>
      </div>

      <div class="tense-grid" id="tense-grid">

        <article class="tense-card" id="present-simple" data-group="present">
          <div class="card-head">
            <span class="tense-no">01</span>
            <div class="tense-title">
              <span class="group-pill">Hiện tại</span>
              <h3>Present Simple <span>Thì hiện tại đơn</span></h3>
            </div>
          </div>
          <div class="formulas">
            <div class="formula"><span class="formula-sign">+</span><code>S + V(s/es)</code></div>
            <div class="formula"><span class="formula-sign">−</span><code>S + don't/doesn't + V</code></div>
            <div class="formula"><span class="formula-sign">?</span><code>Do/Does + S + V?</code></div>
          </div>
          <div class="card-block">
            <h4>Cách dùng</h4>
            <ul class="uses">
              <li>Thói quen, việc lặp đi lặp lại: <em>I walk to school every day.</em></li>
              <li>Sự thật hiển nhiên, quy luật tự nhiên: <em>The sun rises in the east.</em></li>
              <li>Lịch trình, thời gian biểu: <em>The workshop opens at 8 a.m.</em></li>
              <li>Sở thích, trạng thái lâu dài: <em>She loves Vietnamese folk music.</em></li>
            </ul>
          </div>
          <div class="card-block">
            <h4>Dấu hiệu nhận biết</h4>
            <div class="chips"><span>always</span><span>usually</span><span>often</span><span>sometimes</span><span>never</span><span>every day</span><span>on Mondays</span></div>
          </div>
          <blockquote class="example">
            <p class="example-en">Every weekend, my family <mark>visits</mark> Bat Trang pottery village.</p>
            <p class="example-vi">Cuối tuần nào, gia đình mình cũng đến thăm làng gốm Bát Tràng.</p>
          </blockquote>
          <p class="pitfall"><strong>Lỗi thường gặp:</strong> Chủ ngữ số ít (he/she/it) phải thêm -s/-es. Trạng từ tần suất đứng trước động từ thường nhưng đứng sau “to be”: <em>She is always late.</em></p>
        </article>

        <article class="tense-card" id="present-continuous" data-group="present">
          <div class="card-head">
            <span class="tense-no">02</span>
            <div class="tense-title">
              <span class="group-pill">Hiện tại</span>
              <h3>Present Continuous <span>Thì hiện tại tiếp diễn</span></h3>
            </div>
          </div>
          <div class="formulas">
            <div class="formula"><span class="formula-sign">+</span><code>S + am/is/are + V-ing</code></div>
            <div class="formula"><span class="formula-sign">−</span><code>S + am/is/are + not + V-ing</code></div>
            <div class="formula"><span class="formula-sign">?</span><code>Am/Is/Are + S + V-ing?</code></div>
          </div>
          <div class="card-block">
            <h4>Cách dùng</h4>
            <ul class="uses">
              <li>Đang xảy ra ngay lúc nói: <em>Listen! Someone is singing.</em></li>
              <li>Tình hình đang thay đổi: <em>More young people are moving to big cities.</em></li>
              <li>Kế hoạch đã sắp xếp cho tương lai gần: <em>We are visiting Hue next Friday.</em></li>
              <li>Dùng với “always” để phàn nàn: <em>He is always leaving his books everywhere!</em></li>
            </ul>
          </div>
          <div class="card-block">
            <h4>Dấu hiệu nhận biết</h4>
            <div class="chips"><span>now</span><span>right now</span><span>at the moment</span><span>Look!</span><span>Listen!</span><span>these days</span><span>currently</span></div>
          </div>
          <blockquote class="example">
            <p class="example-en">Look! The artisans <mark>are moulding</mark> clay at the workshop.</p>
            <p class="example-vi">Nhìn kìa! Những người thợ đang nặn đất sét tại xưởng.</p>
          </blockquote>
          <p class="pitfall"><strong>Lỗi thường gặp:</strong> Không dùng với động từ trạng thái: know, like, love, want, need, believe, understand, belong. Nhớ gấp đôi phụ âm (run → running) và bỏ -e (make → making).</p>
        </article>

        <article class="tense-card tense-card-focus" id="present-perfect" data-group="present">
          <div class="card-head">
            <span class="tense-no">03</span>
            <div class="tense-title">
              <span class="group-pill">Hiện tại</span>
              <h3>Present Perfect <span>Thì hiện tại hoàn thành</span></h3>
            </div>
            <span class="exam-badge">★ Hay gặp</span>
          </div>
          <div class="formulas">
            <div class="formula"><span class="formula-sign">+</span><code>S + have/has + V3/ed</code></div>
            <div class="formula"><span class="formula-sign">−</span><code>S + haven't/hasn't + V3/ed</code></div>
            <div class="formula"><span class="formula-sign">?</span><code>Have/Has + S + V3/ed?</code></div>
          </div>
          <div class="card-block">
            <h4>Cách dùng</h4>
            <ul class="uses">
              <li>Kể trải nghiệm tính đến nay, không nói rõ thời điểm: <em>I have visited Hue three times.</em></li>
              <li>Việc đã xong nhưng kết quả còn ảnh hưởng đến hiện tại: <em>She has lost her ticket, so she can't get in.</em></li>
              <li>Bắt đầu từ quá khứ, kéo dài đến hiện tại: <em>He has lived here since 2015.</em></li>
              <li>Dùng với just, already, yet để nói việc đã hoặc chưa xảy ra.</li>
            </ul>
          </div>
          <div class="card-block">
            <h4>Dấu hiệu nhận biết</h4>
            <div class="chips"><span>already</span><span>just</span><span>yet</span><span>ever</span><span>never</span><span>since</span><span>for</span><span>so far</span></div>
          </div>
          <blockquote class="example">
            <p class="example-en">I <mark>have already tried</mark> making conical hats.</p>
            <p class="example-vi">Mình đã thử làm nón lá rồi.</p>
          </blockquote>
          <p class="pitfall"><strong>Lỗi thường gặp:</strong> Không dùng với mốc thời gian đã kết thúc: <em>I have seen him yesterday.</em> (sai). Nhớ: since + mốc (since 2015), for + khoảng thời gian (for 3 years).</p>
        </article>

        <article class="tense-card" id="present-perfect-continuous" data-group="present">
          <div class="card-head">
            <span class="tense-no">04</span>
            <div class="tense-title">
              <span class="group-pill">Hiện tại</span>
              <h3>Present Perfect Continuous <span>Thì hiện tại hoàn thành tiếp diễn</span></h3>
            </div>
          </div>
          <div class="formulas">
            <div class="formula"><span class="formula-sign">+</span><code>S + have/has + been + V-ing</code></div>
            <div class="formula"><span class="formula-sign">−</span><code>S + haven't/hasn't + been + V-ing</code></div>
            <div class="formula"><span class="formula-sign">?</span><code>Have/Has + S + been + V-ing?</code></div>
          </div>
          <div class="card-block">
            <h4>Cách dùng</h4>
            <ul class="uses">
              <li>Việc bắt đầu từ quá khứ, vẫn đang tiếp diễn; nhấn mạnh việc kéo dài bao lâu: <em>They have been restoring the temple for two years.</em></li>
              <li>Việc vừa diễn ra, vẫn còn dấu vết: <em>Her hands are dirty because she has been gardening.</em></li>
              <li>Nhấn mạnh quá trình hơn kết quả.</li>
            </ul>
          </div>
          <div class="card-block">
            <h4>Dấu hiệu nhận biết</h4>
            <div class="chips"><span>for</span><span>since</span><span>all day</span><span>all week</span><span>how long</span><span>lately</span><span>recently</span></div>
          </div>
          <blockquote class="example">
            <p class="example-en">They <mark>have been restoring</mark> the old communal house for six months.</p>
            <p class="example-vi">Họ đã trùng tu ngôi đình cũ suốt sáu tháng nay.</p>
          </blockquote>
          <p class="pitfall"><strong>Lỗi thường gặp:</strong> Không dùng với động từ trạng thái. Nếu chỉ nêu số lần hoặc kết quả, dùng hiện tại hoàn thành: <em>I have read that book three times.</em></p>
        </article>

        <article class="tense-card" id="past-simple" data-group="past">
          <div class="card-head">
            <span class="tense-no">05</span>
            <div class="tense-title">
              <span class="group-pill">Quá khứ</span>
              <h3>Past Simple <span>Thì quá khứ đơn</span></h3>
            </div>
          </div>
          <div class="formulas">
            <div class="formula"><span class="formula-sign">+</span><code>S + V2/ed</code></div>
            <div class="formula"><span class="formula-sign">−</span><code>S + didn't + V</code></div>
            <div class="formula"><span class="formula-sign">?</span><code>Did + S + V?</code></div>
          </div>
          <div class="card-block">
            <h4>Cách dùng</h4>
            <ul class="uses">
              <li>Việc đã xảy ra và kết thúc tại một thời điểm cụ thể trong quá khứ: <em>We visited My Son Sanctuary last summer.</em></li>
              <li>Chuỗi hành động liên tiếp: <em>She arrived, opened the door, and sat down.</em></li>
              <li>Thói quen trong quá khứ: <em>My grandfather walked to school every day.</em></li>
              <li>Sự kiện, sự thật trong quá khứ: <em>Nguyen Du wrote Truyen Kieu.</em></li>
            </ul>
          </div>
          <div class="card-block">
            <h4>Dấu hiệu nhận biết</h4>
            <div class="chips"><span>yesterday</span><span>last week</span><span>ago</span><span>in 2010</span><span>then</span><span>when</span><span>in the past</span></div>
          </div>
          <blockquote class="example">
            <p class="example-en">Last summer, our class <mark>visited</mark> My Son Sanctuary.</p>
            <p class="example-vi">Hè năm ngoái, lớp mình đã đến thăm Thánh địa Mỹ Sơn.</p>
          </blockquote>
          <p class="pitfall"><strong>Lỗi thường gặp:</strong> Sau didn't và Did phải dùng động từ nguyên mẫu: <em>didn't went</em> (sai). Học kỹ cách phát âm -ed vì đề có phần này.</p>
          <div class="mini-note">
            <strong>Phát âm -ed:</strong> /t/ sau âm vô thanh (watched, stopped) · /d/ sau âm hữu thanh (played, cleaned) · /ɪd/ sau t, d (wanted, needed).
          </div>
        </article>

        <article class="tense-card tense-card-focus" id="past-continuous" data-group="past">
          <div class="card-head">
            <span class="tense-no">06</span>
            <div class="tense-title">
              <span class="group-pill">Quá khứ</span>
              <h3>Past Continuous <span>Thì quá khứ tiếp diễn</span></h3>
            </div>
            <span class="exam-badge">★ Trọng tâm thi</span>
          </div>
          <div class="formulas">
            <div class="formula"><span class="formula-sign">+</span><code>S + was/were + V-ing</code></div>
            <div class="formula"><span class="formula-sign">−</span><code>S + was/were + not + V-ing</code></div>
            <div class="formula"><span class="formula-sign">?</span><code>Was/Were + S + V-ing?</code></div>
          </div>
          <div class="card-block">
            <h4>Cách dùng</h4>
            <ul class="uses">
              <li>Đang diễn ra tại một thời điểm trong quá khứ: <em>At 8 p.m. yesterday, I was watching a documentary.</em></li>
              <li>Đang diễn ra thì bị hành động khác xen vào: <em>While I was reading, the phone rang.</em></li>
              <li>Hai hành động song song: <em>My mother was cooking while my father was setting the table.</em></li>
              <li>Dựng bối cảnh cho câu chuyện: <em>The sun was setting and birds were singing.</em></li>
            </ul>
          </div>
          <div class="card-block">
            <h4>Dấu hiệu nhận biết</h4>
            <div class="chips"><span>at 8 p.m. yesterday</span><span>at that time</span><span>while</span><span>when</span><span>all morning</span></div>
          </div>
          <blockquote class="example">
            <p class="example-en">While I <mark>was reading</mark> about Vietnamese customs, my brother <mark>was watching</mark> a documentary.</p>
            <p class="example-vi">Trong khi mình đang đọc về phong tục Việt Nam thì anh mình đang xem phim tài liệu.</p>
          </blockquote>
          <p class="pitfall"><strong>Lỗi thường gặp:</strong> “While” thường đi với hành động dài (quá khứ tiếp diễn); hành động ngắn xen vào dùng quá khứ đơn.</p>
          <div class="focus-note">
            <strong>Viết lại câu với “while”:</strong> While + S + was/were + V-ing, S + V2/ed. → <em>While I was walking home, I met an old friend.</em>
          </div>
        </article>

        <article class="tense-card" id="past-perfect" data-group="past">
          <div class="card-head">
            <span class="tense-no">07</span>
            <div class="tense-title">
              <span class="group-pill">Quá khứ</span>
              <h3>Past Perfect <span>Thì quá khứ hoàn thành</span></h3>
            </div>
          </div>
          <div class="formulas">
            <div class="formula"><span class="formula-sign">+</span><code>S + had + V3/ed</code></div>
            <div class="formula"><span class="formula-sign">−</span><code>S + hadn't + V3/ed</code></div>
            <div class="formula"><span class="formula-sign">?</span><code>Had + S + V3/ed?</code></div>
          </div>
          <div class="card-block">
            <h4>Cách dùng</h4>
            <ul class="uses">
              <li>Xảy ra trước một hành động quá khứ khác: <em>The film had started when we arrived.</em></li>
              <li>Xảy ra trước một mốc trong quá khứ: <em>By 2010, he had worked here for ten years.</em></li>
              <li>Trong câu tường thuật hoặc câu điều kiện loại 3: <em>She said she had seen the film.</em></li>
              <li>Sau by the time / before / after để làm rõ thứ tự.</li>
            </ul>
          </div>
          <div class="card-block">
            <h4>Dấu hiệu nhận biết</h4>
            <div class="chips"><span>before</span><span>after</span><span>by the time</span><span>by 2010</span><span>already</span><span>never … before</span></div>
          </div>
          <blockquote class="example">
            <p class="example-en">By the time we arrived, the water puppet show <mark>had started</mark>.</p>
            <p class="example-vi">Khi chúng mình đến nơi thì buổi múa rối nước đã bắt đầu rồi.</p>
          </blockquote>
          <p class="pitfall"><strong>Lỗi thường gặp:</strong> Chỉ dùng khi cần nhấn mạnh việc xảy ra trước. Nếu chỉ kể chuỗi việc liên tiếp, dùng quá khứ đơn.</p>
        </article>

        <article class="tense-card" id="past-perfect-continuous" data-group="past">
          <div class="card-head">
            <span class="tense-no">08</span>
            <div class="tense-title">
              <span class="group-pill">Quá khứ</span>
              <h3>Past Perfect Continuous <span>Thì quá khứ hoàn thành tiếp diễn</span></h3>
            </div>
          </div>
          <div class="formulas">
            <div class="formula"><span class="formula-sign">+</span><code>S + had + been + V-ing</code></div>
            <div class="formula"><span class="formula-sign">−</span><code>S + hadn't + been + V-ing</code></div>
            <div class="formula"><span class="formula-sign">?</span><code>Had + S + been + V-ing?</code></div>
          </div>
          <div class="card-block">
            <h4>Cách dùng</h4>
            <ul class="uses">
              <li>Việc đang diễn ra và kéo dài trước một hành động hay một mốc khác trong quá khứ: <em>They had been preparing for months before the festival opened.</em></li>
              <li>Nhấn mạnh việc kéo dài bao lâu: <em>She had been learning Vietnamese for two years before she moved here.</em></li>
            </ul>
          </div>
          <div class="card-block">
            <h4>Dấu hiệu nhận biết</h4>
            <div class="chips"><span>for</span><span>since</span><span>all day</span><span>before</span><span>by the time</span><span>when</span></div>
          </div>
          <blockquote class="example">
            <p class="example-en">The dancers <mark>had been practising</mark> for hours before the show began.</p>
            <p class="example-vi">Các vũ công đã luyện tập hàng giờ trước khi buổi diễn bắt đầu.</p>
          </blockquote>
          <p class="pitfall"><strong>Lỗi thường gặp:</strong> Ít gặp trong đề lớp 9, chủ yếu cần nhận diện. Nếu chỉ muốn nói việc đã xong trước một mốc, dùng quá khứ hoàn thành.</p>
        </article>

        <article class="tense-card tense-card-focus" id="future-simple" data-group="future">
          <div class="card-head">
            <span class="tense-no">09</span>
            <div class="tense-title">
              <span class="group-pill">Tương lai</span>
              <h3>Future Simple <span>Thì tương lai đơn</span></h3>
            </div>
            <span class="exam-badge">★ Điều kiện loại 1</span>
          </div>
          <div class="formulas">
            <div class="formula"><span class="formula-sign">+</span><code>S + will + V</code></div>
            <div class="formula"><span class="formula-sign">−</span><code>S + won't + V</code></div>
            <div class="formula"><span class="formula-sign">?</span><code>Will + S + V?</code></div>
          </div>
          <div class="card-block">
            <h4>Cách dùng</h4>
            <ul class="uses">
              <li>Dự đoán theo ý kiến, cảm nhận của người nói: <em>I think the festival will be crowded.</em></li>
              <li>Quyết định ngay lúc nói: <em>The phone is ringing. I'll answer it.</em></li>
              <li>Lời hứa, đề nghị: <em>I'll help you carry the pottery.</em></li>
              <li>Mệnh đề chính của câu điều kiện loại 1.</li>
            </ul>
          </div>
          <div class="card-block">
            <h4>Dấu hiệu nhận biết</h4>
            <div class="chips"><span>tomorrow</span><span>next week</span><span>in the future</span><span>soon</span><span>I think</span><span>probably</span></div>
          </div>
          <blockquote class="example">
            <p class="example-en">I think Vietnam <mark>will attract</mark> more tourists next year.</p>
            <p class="example-vi">Mình nghĩ Việt Nam sẽ thu hút nhiều du khách hơn vào năm sau.</p>
          </blockquote>
          <p class="pitfall"><strong>Lỗi thường gặp:</strong> Không dùng will trong mệnh đề if: <em>If it will rain</em> (sai). Mệnh đề if dùng hiện tại đơn.</p>
          <div class="focus-note">
            <strong>Câu điều kiện loại 1:</strong> If + S + V(s/es), S + will + V. → <em>If it rains, we will stay home.</em>
          </div>
        </article>

        <article class="tense-card" id="future-continuous" data-group="future">
          <div class="card-head">
            <span class="tense-no">10</span>
            <div class="tense-title">
              <span class="group-pill">Tương lai</span>
              <h3>Future Continuous <span>Thì tương lai tiếp diễn</span></h3>
            </div>
          </div>
          <div class="formulas">
            <div class="formula"><span class="formula-sign">+</span><code>S + will + be + V-ing</code></div>
            <div class="formula"><span class="formula-sign">−</span><code>S + won't + be + V-ing</code></div>
            <div class="formula"><span class="formula-sign">?</span><code>Will + S + be + V-ing?</code></div>
          </div>
          <div class="card-block">
            <h4>Cách dùng</h4>
            <ul class="uses">
              <li>Sẽ đang diễn ra tại một thời điểm trong tương lai: <em>At this time next week, we will be exploring Hoi An.</em></li>
              <li>Hỏi lịch sự về kế hoạch: <em>Will you be using the computer this afternoon?</em></li>
              <li>Hành động theo lịch trình: <em>The coach will be leaving at 6 a.m.</em></li>
            </ul>
          </div>
          <div class="card-block">
            <h4>Dấu hiệu nhận biết</h4>
            <div class="chips"><span>at this time tomorrow</span><span>at 8 p.m. next Sunday</span><span>this time next week</span><span>all day tomorrow</span></div>
          </div>
          <blockquote class="example">
            <p class="example-en">At this time next week, we <mark>will be exploring</mark> Hoi An Ancient Town.</p>
            <p class="example-vi">Giờ này tuần sau, chúng mình sẽ đang khám phá phố cổ Hội An.</p>
          </blockquote>
          <p class="pitfall"><strong>Lỗi thường gặp:</strong> Phân biệt <em>will + V</em> (sẽ xảy ra) với <em>will be + V-ing</em> (sẽ đang diễn ra tại một mốc).</p>
        </article>

        <article class="tense-card" id="future-perfect" data-group="future">
          <div class="card-head">
            <span class="tense-no">11</span>
            <div class="tense-title">
              <span class="group-pill">Tương lai</span>
              <h3>Future Perfect <span>Thì tương lai hoàn thành</span></h3>
            </div>
          </div>
          <div class="formulas">
            <div class="formula"><span class="formula-sign">+</span><code>S + will + have + V3/ed</code></div>
            <div class="formula"><span class="formula-sign">−</span><code>S + won't + have + V3/ed</code></div>
            <div class="formula"><span class="formula-sign">?</span><code>Will + S + have + V3/ed?</code></div>
          </div>
          <div class="card-block">
            <h4>Cách dùng</h4>
            <ul class="uses">
              <li>Sẽ xong trước một thời điểm trong tương lai: <em>By 2030, the city will have built three new metro lines.</em></li>
              <li>Sẽ xong trước khi một việc khác trong tương lai xảy ra: <em>By the time you arrive, I will have finished cooking.</em></li>
            </ul>
          </div>
          <div class="card-block">
            <h4>Dấu hiệu nhận biết</h4>
            <div class="chips"><span>by 2030</span><span>by the time</span><span>before</span><span>by then</span><span>by next month</span></div>
          </div>
          <blockquote class="example">
            <p class="example-en">By 2030, the city <mark>will have built</mark> three new metro lines.</p>
            <p class="example-vi">Đến năm 2030, thành phố sẽ xây xong ba tuyến tàu điện ngầm mới.</p>
          </blockquote>
          <p class="pitfall"><strong>Lỗi thường gặp:</strong> Mốc thời gian phải ở tương lai. Nếu mốc ở quá khứ, dùng had + V3. Nhớ dùng <em>have</em>, không dùng has.</p>
        </article>

        <article class="tense-card" id="future-perfect-continuous" data-group="future">
          <div class="card-head">
            <span class="tense-no">12</span>
            <div class="tense-title">
              <span class="group-pill">Tương lai</span>
              <h3>Future Perfect Continuous <span>Thì tương lai hoàn thành tiếp diễn</span></h3>
            </div>
          </div>
          <div class="formulas">
            <div class="formula"><span class="formula-sign">+</span><code>S + will + have + been + V-ing</code></div>
            <div class="formula"><span class="formula-sign">−</span><code>S + won't + have + been + V-ing</code></div>
            <div class="formula"><span class="formula-sign">?</span><code>Will + S + have + been + V-ing?</code></div>
          </div>
          <div class="card-block">
            <h4>Cách dùng</h4>
            <ul class="uses">
              <li>Nhấn mạnh việc kéo dài bao lâu tính đến một mốc tương lai: <em>By next June, she will have been learning English for five years.</em></li>
              <li>Việc sẽ diễn ra liên tục cho đến thời điểm đó.</li>
            </ul>
          </div>
          <div class="card-block">
            <h4>Dấu hiệu nhận biết</h4>
            <div class="chips"><span>by … for …</span><span>by next June</span><span>by the time + hiện tại đơn</span></div>
          </div>
          <blockquote class="example">
            <p class="example-en">By next June, she <mark>will have been learning</mark> English for five years.</p>
            <p class="example-vi">Đến tháng 6 năm sau, bạn ấy sẽ học tiếng Anh được tròn năm năm.</p>
          </blockquote>
          <p class="pitfall"><strong>Lỗi thường gặp:</strong> Hiếm gặp trong đề lớp 9, chủ yếu cần nhận diện công thức. Không dùng với động từ trạng thái.</p>
        </article>

      </div>

      <div class="empty-state" id="empty-state" hidden>
        <p class="empty-title">Không tìm thấy thì nào khớp.</p>
        <p>Thử từ khoá khác hoặc xoá bộ lọc để xem lại cả 12 thì.</p>
        <button class="btn btn-ghost" id="reset-filters" type="button">Xoá bộ lọc</button>
      </div>
    </div>
  </section>

  <!-- COMPARE -->
  <section class="section section-alt" id="compare">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="section-kicker">04 · Dễ nhầm</p>
          <h2>Bốn cặp thì hay bị hỏi.</h2>
          <p>Đây là những chỗ đề thi lớp 9 thường gài bẫy. Đọc kỹ ví dụ và mốc thời gian.</p>
        </div>
        <p class="section-aside"><span>4</span> cặp<br>dễ nhầm</p>
      </div>

      <div class="compare-grid">
        <article class="compare-card">
          <span class="vs-pill">Cặp 1</span>
          <h3>Present Perfect <em>vs</em> Past Simple</h3>
          <div class="compare-cols">
            <div class="compare-col compare-col-present">
              <h4>Hiện tại hoàn thành</h4>
              <p>Không nói rõ thời điểm; kể trải nghiệm hoặc kết quả còn ảnh hưởng đến hiện tại.</p>
              <p class="eg">I <strong>have watched</strong> that documentary.</p>
            </div>
            <div class="compare-col compare-col-past">
              <h4>Quá khứ đơn</h4>
              <p>Thời gian đã kết thúc, nói rõ khi nào.</p>
              <p class="eg">I <strong>watched</strong> it last night.</p>
            </div>
          </div>
          <p class="compare-tip"><strong>Chốt nhanh:</strong> yesterday, last, ago, in 2019 → quá khứ đơn. already, just, yet, ever, never, since, for → hiện tại hoàn thành.</p>
        </article>

        <article class="compare-card">
          <span class="vs-pill">Cặp 2</span>
          <h3>Past Simple <em>vs</em> Past Continuous</h3>
          <div class="compare-cols">
            <div class="compare-col compare-col-past">
              <h4>Quá khứ tiếp diễn</h4>
              <p>Hành động dài đang diễn ra, làm nền cho câu chuyện.</p>
              <p class="eg">I <strong>was walking</strong> home.</p>
            </div>
            <div class="compare-col compare-col-past">
              <h4>Quá khứ đơn</h4>
              <p>Hành động ngắn xen vào hoặc hành động đã kết thúc.</p>
              <p class="eg">I <strong>met</strong> an old friend.</p>
            </div>
          </div>
          <p class="compare-tip"><strong>Ghép lại:</strong> While I <strong>was walking</strong> home, I <strong>met</strong> an old friend. While + hành động đang diễn ra.</p>
        </article>

        <article class="compare-card">
          <span class="vs-pill">Cặp 3</span>
          <h3>Past Perfect <em>vs</em> Past Simple</h3>
          <div class="compare-cols">
            <div class="compare-col compare-col-past">
              <h4>Quá khứ hoàn thành</h4>
              <p>Hành động xảy ra <strong>trước</strong> hành động quá khứ khác.</p>
              <p class="eg">The show <strong>had started</strong>.</p>
            </div>
            <div class="compare-col compare-col-past">
              <h4>Quá khứ đơn</h4>
              <p>Hành động xảy ra <strong>sau</strong>, dùng để kể tiếp.</p>
              <p class="eg">We <strong>arrived</strong>.</p>
            </div>
          </div>
          <div class="sequence" aria-label="Thứ tự: show đã bắt đầu, sau đó chúng tôi đến">
            <span>had started</span><span class="seq-arrow">→</span><span>arrived</span><span class="seq-arrow">→</span><span class="seq-now">now</span>
          </div>
          <p class="compare-tip"><strong>Ghép lại:</strong> When we arrived, the show had started. Nếu chỉ kể chuỗi: We arrived and the show started.</p>
        </article>

        <article class="compare-card">
          <span class="vs-pill">Cặp 4</span>
          <h3>Will <em>vs</em> Be going to</h3>
          <div class="compare-cols">
            <div class="compare-col compare-col-future">
              <h4>Will</h4>
              <p>Quyết định ngay lúc nói, dự đoán chủ quan, lời hứa.</p>
              <p class="eg">I<strong>'ll get</strong> the door!</p>
            </div>
            <div class="compare-col compare-col-future">
              <h4>Be going to</h4>
              <p>Kế hoạch đã có từ trước, dự đoán có bằng chứng.</p>
              <p class="eg">Look at those clouds. It<strong>'s going to</strong> rain.</p>
            </div>
          </div>
          <p class="compare-tip"><strong>Lưu ý:</strong> “Be going to” không thuộc 12 thì nhưng rất hay gặp trong đề. Đừng nhầm với quyết định ngay lúc nói.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- SIGNALS -->
  <section class="section" id="signals">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="section-kicker">05 · Giải mã đề</p>
          <h2>Thấy từ khoá, nghĩ ngay đến thì nào?</h2>
          <p>Dấu hiệu chỉ là gợi ý — hãy đọc cả câu để xác định mốc thời gian và ý nghĩa.</p>
        </div>
        <p class="section-aside"><span>12</span> dấu hiệu<br>thường gặp</p>
      </div>

      <div class="signal-grid">
        <article class="signal-card">
          <div class="signal-words"><span>every day</span><span>usually</span><span>on Mondays</span></div>
          <p class="signal-arrow">Nghĩ đến</p>
          <p class="signal-tense">Present Simple</p>
          <p class="signal-note">Thói quen, lịch trình, sự thật hiển nhiên.</p>
        </article>
        <article class="signal-card">
          <div class="signal-words"><span>now</span><span>at the moment</span><span>Look!</span><span>Listen!</span></div>
          <p class="signal-arrow">Nghĩ đến</p>
          <p class="signal-tense">Present Continuous</p>
          <p class="signal-note">Đang diễn ra ngay lúc nói.</p>
        </article>
        <article class="signal-card">
          <div class="signal-words"><span>already</span><span>just</span><span>yet</span><span>ever</span><span>never</span></div>
          <p class="signal-arrow">Nghĩ đến</p>
          <p class="signal-tense">Present Perfect</p>
          <p class="signal-note">Trải nghiệm hoặc kết quả, không gắn với thời gian cụ thể.</p>
        </article>
        <article class="signal-card signal-card-caution">
          <div class="signal-words"><span>since</span><span>for</span></div>
          <p class="signal-arrow">Nghĩ đến</p>
          <p class="signal-tense">Present Perfect / Continuous</p>
          <p class="signal-note">since + mốc thời gian; for + khoảng thời gian. Cũng xuất hiện ở quá khứ hoàn thành và tương lai hoàn thành.</p>
        </article>
        <article class="signal-card">
          <div class="signal-words"><span>yesterday</span><span>ago</span><span>last week</span><span>in 2019</span></div>
          <p class="signal-arrow">Nghĩ đến</p>
          <p class="signal-tense">Past Simple</p>
          <p class="signal-note">Thời gian đã kết thúc, không dùng hiện tại hoàn thành.</p>
        </article>
        <article class="signal-card">
          <div class="signal-words"><span>while</span><span>at 8 p.m. yesterday</span></div>
          <p class="signal-arrow">Nghĩ đến</p>
          <p class="signal-tense">Past Continuous</p>
          <p class="signal-note">Đang diễn ra tại một mốc trong quá khứ.</p>
        </article>
        <article class="signal-card">
          <div class="signal-words"><span>before</span><span>after</span><span>by the time + quá khứ</span></div>
          <p class="signal-arrow">Nghĩ đến</p>
          <p class="signal-tense">Past Perfect</p>
          <p class="signal-note">Hành động xảy ra trước một hành động quá khứ khác.</p>
        </article>
        <article class="signal-card">
          <div class="signal-words"><span>tomorrow</span><span>next week</span><span>I think</span></div>
          <p class="signal-arrow">Nghĩ đến</p>
          <p class="signal-tense">Future Simple</p>
          <p class="signal-note">Dự đoán hoặc quyết định ngay lúc nói.</p>
        </article>
        <article class="signal-card">
          <div class="signal-words"><span>at this time tomorrow</span><span>this time next week</span></div>
          <p class="signal-arrow">Nghĩ đến</p>
          <p class="signal-tense">Future Continuous</p>
          <p class="signal-note">Sẽ đang diễn ra tại một mốc trong tương lai.</p>
        </article>
        <article class="signal-card">
          <div class="signal-words"><span>by 2030</span><span>by the time + tương lai</span></div>
          <p class="signal-arrow">Nghĩ đến</p>
          <p class="signal-tense">Future Perfect</p>
          <p class="signal-note">Hoàn thành trước một mốc trong tương lai.</p>
        </article>
        <article class="signal-card">
          <div class="signal-words"><span>by … for …</span></div>
          <p class="signal-arrow">Nghĩ đến</p>
          <p class="signal-tense">Future Perfect Continuous</p>
          <p class="signal-note">Kéo dài liên tục đến một mốc trong tương lai.</p>
        </article>
        <article class="signal-card signal-card-caution">
          <div class="signal-words"><span>when</span></div>
          <p class="signal-arrow">Nghĩ đến</p>
          <p class="signal-tense">Tuỳ ngữ cảnh</p>
          <p class="signal-note">when + việc ngắn → quá khứ đơn; when + việc đang diễn ra → quá khứ tiếp diễn; when + việc xảy ra trước → quá khứ hoàn thành.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- TRAPS -->
  <section class="section section-alt" id="traps">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="section-kicker">06 · Bẫy đề</p>
          <h2>Tám lỗi rất dễ mất điểm.</h2>
          <p>Đọc câu sai, câu đúng và lý do. Đây là những lỗi học sinh lớp 9 hay mắc nhất khi làm bài về thì.</p>
        </div>
        <p class="section-aside"><span>8</span> lỗi<br>cần sửa</p>
      </div>

      <div class="trap-grid">
        <article class="trap">
          <div class="trap-line trap-line-bad"><span class="trap-mark" aria-hidden="true">✗</span><p><span class="sr-only">Sai: </span>She <strong>don't</strong> like conical hats.</p></div>
          <div class="trap-line trap-line-good"><span class="trap-mark" aria-hidden="true">✓</span><p><span class="sr-only">Đúng: </span>She <strong>doesn't</strong> like conical hats.</p></div>
          <p class="trap-why">Chủ ngữ số ít (he/she/it) đi với doesn't, không đi với don't.</p>
        </article>

        <article class="trap">
          <div class="trap-line trap-line-bad"><span class="trap-mark" aria-hidden="true">✗</span><p><span class="sr-only">Sai: </span>I have <strong>saw</strong> that film.</p></div>
          <div class="trap-line trap-line-good"><span class="trap-mark" aria-hidden="true">✓</span><p><span class="sr-only">Đúng: </span>I have <strong>seen</strong> that film.</p></div>
          <p class="trap-why">Sau have/has phải là V3 (quá khứ phân từ), không phải V2.</p>
        </article>

        <article class="trap">
          <div class="trap-line trap-line-bad"><span class="trap-mark" aria-hidden="true">✗</span><p><span class="sr-only">Sai: </span>I <strong>have visited</strong> Hue <strong>last year</strong>.</p></div>
          <div class="trap-line trap-line-good"><span class="trap-mark" aria-hidden="true">✓</span><p><span class="sr-only">Đúng: </span>I <strong>visited</strong> Hue last year.</p></div>
          <p class="trap-why">“Last year” là thời gian đã kết thúc → dùng quá khứ đơn.</p>
        </article>

        <article class="trap">
          <div class="trap-line trap-line-bad"><span class="trap-mark" aria-hidden="true">✗</span><p><span class="sr-only">Sai: </span>When I was walking home, I <strong>was seeing</strong> him.</p></div>
          <div class="trap-line trap-line-good"><span class="trap-mark" aria-hidden="true">✓</span><p><span class="sr-only">Đúng: </span>When I was walking home, I <strong>saw</strong> him.</p></div>
          <p class="trap-why">Hành động ngắn xen vào dùng quá khứ đơn, không dùng thì tiếp diễn.</p>
        </article>

        <article class="trap">
          <div class="trap-line trap-line-bad"><span class="trap-mark" aria-hidden="true">✗</span><p><span class="sr-only">Sai: </span>By the time we arrived, the show <strong>started</strong>.</p></div>
          <div class="trap-line trap-line-good"><span class="trap-mark" aria-hidden="true">✓</span><p><span class="sr-only">Đúng: </span>By the time we arrived, the show <strong>had started</strong>.</p></div>
          <p class="trap-why">Hành động xảy ra trước một hành động quá khứ khác dùng quá khứ hoàn thành.</p>
        </article>

        <article class="trap">
          <div class="trap-line trap-line-bad"><span class="trap-mark" aria-hidden="true">✗</span><p><span class="sr-only">Sai: </span>I <strong>am knowing</strong> the answer.</p></div>
          <div class="trap-line trap-line-good"><span class="trap-mark" aria-hidden="true">✓</span><p><span class="sr-only">Đúng: </span>I <strong>know</strong> the answer.</p></div>
          <p class="trap-why">Know là động từ trạng thái, không chia ở thì tiếp diễn.</p>
        </article>

        <article class="trap">
          <div class="trap-line trap-line-bad"><span class="trap-mark" aria-hidden="true">✗</span><p><span class="sr-only">Sai: </span>She has lived here <strong>since three years</strong>.</p></div>
          <div class="trap-line trap-line-good"><span class="trap-mark" aria-hidden="true">✓</span><p><span class="sr-only">Đúng: </span>She has lived here <strong>for three years</strong>.</p></div>
          <p class="trap-why">since + mốc thời gian (since 2020); for + khoảng thời gian (for three years).</p>
        </article>

        <article class="trap">
          <div class="trap-line trap-line-bad"><span class="trap-mark" aria-hidden="true">✗</span><p><span class="sr-only">Sai: </span><strong>If it will rain</strong>, we will stay home.</p></div>
          <div class="trap-line trap-line-good"><span class="trap-mark" aria-hidden="true">✓</span><p><span class="sr-only">Đúng: </span><strong>If it rains</strong>, we will stay home.</p></div>
          <p class="trap-why">Mệnh đề if của câu điều kiện loại 1 dùng hiện tại đơn, không dùng will.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- QUIZ -->
  <section class="section section-quiz" id="quiz">
    <div class="container">
      <div class="section-head section-head-center">
        <div>
          <p class="section-kicker">07 · Luyện tập</p>
          <h2>Kiểm tra 12 thì trong 12 câu.</h2>
          <p>Chọn đáp án đúng. Mỗi câu đều có giải thích ngay sau khi trả lời.</p>
        </div>
      </div>

      <p class="quiz-best" id="quiz-best" aria-live="polite">Điểm cao nhất: chưa có</p>

      <div class="quiz-shell">
        <div class="quiz-top">
          <span class="quiz-step" id="quiz-step">Câu 1/12</span>
          <div class="quiz-progress" role="progressbar" aria-valuemin="0" aria-valuemax="12" aria-valuenow="1" aria-label="Tiến độ làm bài">
            <span id="quiz-bar"></span>
          </div>
          <span class="quiz-score" id="quiz-score">0 câu đúng</span>
        </div>
        <div class="quiz-stage" id="quiz-stage" aria-live="polite"></div>
      </div>

      <noscript><p class="quiz-noscript">Bật JavaScript để làm bài luyện tập. Phần nội dung phía trên vẫn đọc được bình thường.</p></noscript>
    </div>
  </section>

