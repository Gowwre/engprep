---
import '../styles/global.css';
import SheetLayout from '../layouts/SheetLayout.astro';
import ClueCard from '../components/ClueCard.astro';
import FigurePanel from '../components/FigurePanel.astro';
import QuizPanel from '../components/QuizPanel.astro';
import SectionHead from '../components/SectionHead.astro';
import StepCard from '../components/StepCard.astro';
import StudyStackVisual from '../components/StudyStackVisual.astro';
import TableShell from '../components/TableShell.astro';
import TrapCard from '../components/TrapCard.astro';
import '../styles/cloze.css';
---

<SheetLayout slug="cloze">
  <Fragment slot="visual">
    <StudyStackVisual
      stackClass="cz-stack"
      noteLabel="Mẹo thi"
      noteTitle="Đọc cả câu"
      note="đừng chỉ nhìn chỗ trống!"
    >
      <p class="mini-label">Điền khuyết · Từ nối</p>
      <p class="cz-mini-passage">Plastic bags are convenient. ______, they are harmful to the environment.</p>
      <div class="cz-mini-options">
        <span>A. Because</span>
        <span class="is-correct">B. However</span>
        <span>C. So</span>
      </div>
      <p class="cz-mini-why"><strong>However</strong> báo hiệu ý tương phản.</p>
      <div class="mini-chips">
        <span>contrast</span><span>connector</span><span>however</span>
      </div>
    </StudyStackVisual>
  </Fragment>

  <!-- MAP -->
  <section class="section" id="map">
    <div class="container">
      <SectionHead kicker="01 · Bản đồ" title="Năm loại chỗ trống.">
        Bài điền khuyết không chỉ hỏi từ vựng. Mỗi chỗ trống có thể kiểm tra ngữ pháp, nghĩa, cụm từ cố định (collocation), từ nối hoặc từ thay thế.
        <p slot="aside" class="section-aside"><span>5</span> loại chỗ trống<br><span>12</span> câu hỏi</p>
      </SectionHead>

      <div class="cz-map-grid">
        <a class="cz-map-card cz-map-grammar" href="#grammar">
          <p class="map-kicker">01 · Ngữ pháp</p>
          <h3>Chỗ trống ngữ pháp</h3>
          <p class="map-rule">Giới từ, dạng động từ, mệnh đề quan hệ, so sánh.</p>
          <div class="map-chips">
            <span>depend on</span><span>to-V</span><span>who</span><span>more</span>
          </div>
          <span class="map-link">Xem bảng ngữ pháp →</span>
        </a>

        <a class="cz-map-card cz-map-vocab" href="#vocabulary">
          <p class="map-kicker">02 · Nghĩa</p>
          <h3>Chỗ trống từ vựng</h3>
          <p class="map-rule">Đoán nghĩa từ câu trước, câu sau và chủ đề.</p>
          <div class="map-chips">
            <span>polluted</span><span>opportunity</span><span>benefit</span>
          </div>
          <span class="map-link">Xem manh mối →</span>
        </a>

        <a class="cz-map-card cz-map-colloc" href="#vocabulary">
          <p class="map-kicker">03 · Cụm từ</p>
          <h3>Cụm từ cố định</h3>
          <p class="map-rule">Từ nào đi với từ nào: make a decision, heavy rain.</p>
          <div class="map-chips">
            <span>make a decision</span><span>take part in</span><span>heavy rain</span>
          </div>
          <span class="map-link">Xem collocations →</span>
        </a>

        <a class="cz-map-card cz-map-connector" href="#grammar">
          <p class="map-kicker">04 · Liên kết</p>
          <h3>Từ nối</h3>
          <p class="map-rule">Quan hệ giữa hai câu: thêm ý, tương phản, nguyên nhân, kết quả.</p>
          <div class="map-chips">
            <span>however</span><span>because</span><span>therefore</span>
          </div>
          <span class="map-link">Xem từ nối →</span>
        </a>

        <a class="cz-map-card cz-map-ref" href="#grammar">
          <p class="map-kicker">05 · Thay thế</p>
          <h3>Từ thay thế</h3>
          <p class="map-rule">It, they, this, that thay cho danh từ nào?</p>
          <div class="map-chips">
            <span>it</span><span>they</span><span>this</span><span>that</span>
          </div>
          <span class="map-link">Xem cách tìm →</span>
        </a>
      </div>

      <p class="mini-note"><strong>Nguyên tắc:</strong> không điền ngay khi vừa đọc chỗ trống. Hãy đọc cả câu, xác định loại từ cần điền, rồi mới xét nghĩa và ngữ pháp.</p>
    </div>
  </section>

  <!-- STRATEGY -->
  <section class="section section-alt" id="strategy">
    <div class="container">
      <SectionHead kicker="02 · Chiến lược" title="Bốn bước làm bài điền khuyết.">
        Bài có 6 chỗ trống thường mất khoảng 8 phút. Đọc lướt trước, xử lý từng chỗ, rồi đọc lại cả đoạn.
        <p slot="aside" class="section-aside"><span>4</span> bước<br><span>8</span> phút / bài</p>
      </SectionHead>

      <div class="cz-step-grid">
        <StepCard
          prefix="cz"
          no="01"
          title="Đọc lướt cả đoạn"
          body="Đọc nhanh để nắm chủ đề, giọng điệu và cấu trúc. Chú ý từ nối và các từ lặp lại."
          formula="chủ đề + giọng điệu + cấu trúc"
        />

        <StepCard
          prefix="cz"
          no="02"
          title="Đọc quanh chỗ trống"
          body="Đọc câu chứa chỗ trống và câu trước/sau. Dự đoán loại từ và nghĩa trước khi xem đáp án."
          formula="câu trước + câu sau"
        />

        <StepCard
          prefix="cz"
          no="03"
          title="Kiểm tra ngữ pháp"
          body="Loại từ, thì, số ít/số nhiều, giới từ đi kèm và cụm từ cố định. Đây là bước dễ mất điểm nhất."
          formula="ngữ pháp + cụm từ cố định"
        />

        <StepCard
          prefix="cz"
          no="04"
          title="Đọc lại cả đoạn"
          body="Điền thử đáp án rồi đọc lại. Nếu câu tối nghĩa hoặc sai logic, hãy xem lại chỗ trống đó."
          formula="điền thử + đọc lại"
        />
      </div>

      <div class="cz-time-strip" aria-label="Phân bổ thời gian cho một bài điền khuyết">
        <div class="cz-time-step"><span>Skim</span><strong>1 phút</strong></div>
        <span class="cz-time-arrow" aria-hidden="true">→</span>
        <div class="cz-time-step"><span>Đọc quanh chỗ trống</span><strong>1 phút</strong></div>
        <span class="cz-time-arrow" aria-hidden="true">→</span>
        <div class="cz-time-step"><span>Chọn &amp; kiểm tra</span><strong>5 phút</strong></div>
        <span class="cz-time-arrow" aria-hidden="true">→</span>
        <div class="cz-time-step"><span>Đọc lại</span><strong>1 phút</strong></div>
      </div>

      <FigurePanel
        kicker="Sơ đồ quyết định"
        title="Bốn cổng trước khi chọn đáp án."
        caption="Đi từ cổng 1 đến cổng 4. Nếu vẫn còn hai đáp án, đọc lại cả đoạn và quay lại cổng đầu tiên."
      >
        <div class="cz-funnel">
          <div class="cz-funnel-start">
            <span>Chỗ trống</span>
            <strong>Đừng điền ngay</strong>
          </div>
          <span class="cz-funnel-arrow" aria-hidden="true">↓</span>

          <div class="cz-funnel-gates">
            <div class="cz-funnel-gate cz-gate-grammar">
              <span>01</span>
              <div>
                <strong>Loại từ</strong>
                <p>Trước và sau chỗ trống cần danh từ, tính từ, động từ hay trạng từ?</p>
              </div>
            </div>
            <div class="cz-funnel-gate cz-gate-grammar">
              <span>02</span>
              <div>
                <strong>Ngữ pháp</strong>
                <p>Thì, số ít/số nhiều, giới từ đi kèm, mệnh đề quan hệ hay so sánh?</p>
              </div>
            </div>
            <div class="cz-funnel-gate cz-gate-colloc">
              <span>03</span>
              <div>
                <strong>Cụm cố định</strong>
                <p>Từ nào đi với từ nào: <code>make a decision</code>, <code>depend on</code>, <code>heavy rain</code>?</p>
              </div>
            </div>
            <div class="cz-funnel-gate cz-gate-logic">
              <span>04</span>
              <div>
                <strong>Nghĩa &amp; logic</strong>
                <p>Câu trước, câu sau, từ nối và chủ đề của cả đoạn nói gì?</p>
              </div>
            </div>
          </div>

          <span class="cz-funnel-arrow" aria-hidden="true">↓</span>
          <div class="cz-funnel-end">
            <strong>Đọc lại cả đoạn</strong>
            <span>đúng nghĩa · đúng ngữ pháp · tự nhiên</span>
          </div>
        </div>
      </FigurePanel>

      <p class="mini-note"><strong>Đừng dịch từng chữ:</strong> đọc theo cụm và bám vào cấu trúc câu. Gặp từ lạ, hãy dùng ngữ cảnh để đoán; chỉ tra từ khi nó nằm trong câu hỏi hoặc cần phân biệt nghĩa.</p>
    </div>
  </section>

  <!-- GRAMMAR -->
  <section class="section" id="grammar">
    <div class="container">
      <SectionHead kicker="03 · Ngữ pháp" title="Chỗ trống ngữ pháp: nhìn dấu hiệu.">
        62,5% chỗ trống trong bài điền khuyết là ngữ pháp. Khi thấy dấu hiệu quen thuộc, hãy kiểm tra đúng nhóm đó trước.
        <p slot="aside" class="section-aside"><span>7</span> nhóm<br><span>1</span> bảng tra</p>
      </SectionHead>

      <TableShell
        wrapperClass="cz-table-wrap"
        tableClass="cz-table cz-grammar-table"
        caption="Bảng dấu hiệu ngữ pháp trong bài điền khuyết"
        hint
      >
        <thead>
          <tr>
            <th scope="col">Loại chỗ trống</th>
            <th scope="col">Dấu hiệu</th>
            <th scope="col">Cần kiểm tra</th>
            <th scope="col">Ví dụ</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <th scope="row"><span class="cz-cat cz-cat-prep">Giới từ</span></th>
            <td>Đứng trước danh từ, V-ing hoặc đại từ.</td>
            <td>Giới từ đi kèm động từ/tính từ; giới từ thời gian, nơi chốn.</td>
            <td><code>depend on</code> · <code>interested in</code> · <code>in 2026</code></td>
          </tr>
          <tr>
            <th scope="row"><span class="cz-cat cz-cat-conj">Từ nối</span></th>
            <td>Nối hai mệnh đề hoặc hai câu.</td>
            <td>Quan hệ thêm ý, tương phản, nguyên nhân, kết quả.</td>
            <td><code>however</code> · <code>because</code> · <code>therefore</code></td>
          </tr>
          <tr>
            <th scope="row"><span class="cz-cat cz-cat-rel">Đại từ quan hệ</span></th>
            <td>Đứng sau danh từ, trước mệnh đề.</td>
            <td>Người hay vật; mệnh đề xác định hay không xác định.</td>
            <td><code>who</code> · <code>which</code> · <code>that</code></td>
          </tr>
          <tr>
            <th scope="row"><span class="cz-cat cz-cat-verb">Dạng động từ</span></th>
            <td>Sau modal, “to”, giới từ hoặc chủ ngữ.</td>
            <td>V, to-V, V-ing; thì và hòa hợp chủ ngữ.</td>
            <td><code>decided to go</code> · <code>enjoys reading</code> · <code>has lived</code></td>
          </tr>
          <tr>
            <th scope="row"><span class="cz-cat cz-cat-comp">So sánh</span></th>
            <td>Có <code>than</code>, <code>the most</code>, <code>as … as</code>.</td>
            <td>Tính từ ngắn/dài; so sánh hơn hay nhất.</td>
            <td><code>more crowded</code> · <code>the best</code> · <code>as tall as</code></td>
          </tr>
          <tr>
            <th scope="row"><span class="cz-cat cz-cat-quant">Lượng từ</span></th>
            <td>Trước danh từ hoặc thay cho danh từ.</td>
            <td>Đếm được hay không đếm được; khẳng định hay phủ định.</td>
            <td><code>many people</code> · <code>much water</code> · <code>some</code></td>
          </tr>
          <tr>
            <th scope="row"><span class="cz-cat cz-cat-art">Mạo từ</span></th>
            <td>Trước danh từ số ít hoặc danh từ đã xác định.</td>
            <td>a/an/the; danh từ đếm được hay không đếm được.</td>
            <td><code>a book</code> · <code>an hour</code> · <code>the sun</code></td>
          </tr>
        </tbody>
      </TableShell>

      <p class="mini-note"><strong>Thứ tự kiểm tra:</strong> loại từ → thì/số ít số nhiều → giới từ/collocation → nghĩa. Đừng chọn đáp án chỉ vì nó “nghe quen tai”.</p>
    </div>
  </section>

  <!-- VOCABULARY -->
  <section class="section section-alt" id="vocabulary">
    <div class="container">
      <SectionHead kicker="04 · Từ vựng" title="Chỗ trống từ vựng: tìm manh mối.">
        Khi chỗ trống không phải ngữ pháp, câu xung quanh thường giấu định nghĩa, ví dụ, từ trái nghĩa hoặc cụm từ cố định.
        <p slot="aside" class="section-aside"><span>6</span> loại manh mối<br><span>1</span> quy tắc</p>
      </SectionHead>

      <div class="cz-clue-grid">
        <ClueCard
          label="01 · Định nghĩa"
          title="is / means / refers to"
          body="Câu sau giải thích nghĩa của từ cần điền."
          example="A <strong>habitat</strong> is the natural home of an animal."
        />

        <ClueCard
          label="02 · Ví dụ"
          title="such as / for example"
          body="Ví dụ phía sau thu hẹp nghĩa của từ."
          example="Fruits <strong>such as</strong> mangoes and bananas are sweet."
        />

        <ClueCard
          label="03 · Tương phản"
          title="but / however / although"
          body="Từ nối tương phản báo hiệu nghĩa trái ngược."
          example="The town is small, <strong>but</strong> it is very lively."
        />

        <ClueCard
          label="04 · Nguyên nhân – kết quả"
          title="because / so / therefore"
          body="Một vế giải thích nguyên nhân hoặc kết quả của vế kia."
          example="It rained heavily, <strong>so</strong> the match was cancelled."
        />

        <ClueCard
          label="05 · Cụm từ cố định"
          title="từ đi với từ"
          body="Chọn từ tạo thành cụm tự nhiên với từ đứng cạnh."
          example="<strong>make</strong> a decision · <strong>heavy</strong> rain · <strong>take</strong> responsibility"
        />

        <ClueCard
          label="06 · Chủ đề"
          title="các từ xung quanh"
          body="Chủ đề của cả đoạn giúp loại đáp án sai nghĩa."
          example="Trong đoạn về môi trường: <strong>pollution, recycle, renewable</strong>."
        />
      </div>

      <p class="mini-note"><strong>Mẹo:</strong> thay từng đáp án vào câu và đọc to trong đầu. Đáp án đúng phải đúng nghĩa, đúng ngữ pháp và tạo thành cụm tự nhiên.</p>
    </div>
  </section>

  <!-- SAMPLE -->
  <section class="section" id="sample">
    <div class="container">
      <SectionHead kicker="05 · Đoạn mẫu" title="Một đoạn, sáu chỗ trống.">
        Đọc cả đoạn, thử điền trước khi xem đáp án. Mỗi chỗ trống đại diện cho một loại chỗ trống khác nhau.
        <p slot="aside" class="section-aside"><span>1</span> đoạn mẫu<br><span>6</span> chỗ trống</p>
      </SectionHead>

      <article class="cz-sample">
        <div class="cz-sample-head">
          <div>
            <p class="section-kicker">Plastic pollution</p>
            <h3>Đọc và điền từ.</h3>
          </div>
          <p class="cz-sample-meta">6 chỗ trống · 8 phút</p>
        </div>

        <p class="cz-passage">Plastic pollution is a serious <span class="cz-gap">(1) ______</span> in many countries. Every year, millions of tonnes of plastic end up in the sea. Fish and sea turtles often mistake small pieces of plastic <span class="cz-gap">(2) ______</span> food. <span class="cz-gap">(3) ______</span>, some countries are now taking action. They have banned single-use plastic bags and encouraged people to recycle. In Vietnam, many supermarkets have started using paper bags <span class="cz-gap">(4) ______</span> plastic ones. These changes are small, <span class="cz-gap">(5) ______</span> they can make a big difference if everyone joins in. We should all <span class="cz-gap">(6) ______</span> responsibility for protecting the environment.</p>

        <div class="cz-answer-grid">
          <div><span>1</span><strong>problem</strong><em>danh từ; serious problem</em></div>
          <div><span>2</span><strong>for</strong><em>mistake A for B</em></div>
          <div><span>3</span><strong>However</strong><em>tương phản</em></div>
          <div><span>4</span><strong>instead of</strong><em>thay vì</em></div>
          <div><span>5</span><strong>but</strong><em>tương phản trong câu</em></div>
          <div><span>6</span><strong>take</strong><em>take responsibility for</em></div>
        </div>
      </article>

      <p class="mini-note"><strong>Cách dùng đoạn mẫu:</strong> che phần đáp án, tự điền và nói lý do cho từng chỗ. Sau đó so sánh. Nếu lý do chỉ là “nghe hay” mà không phải ngữ pháp/collocation, hãy xem lại.</p>
    </div>
  </section>

  <!-- TRAPS -->
  <section class="section section-alt traps-start" id="traps">
    <div class="container">
      <SectionHead kicker="06 · Bẫy đề" title="Mười lỗi hay mất điểm.">
        Đọc câu sai, câu đúng và lý do. Đây là những lỗi học sinh lớp 9 hay mắc khi làm bài điền khuyết.
        <p slot="aside" class="section-aside"><span>10</span> lỗi<br>cần tránh</p>
      </SectionHead>

      <div class="trap-grid">
        <TrapCard
          bad="Chọn đáp án chỉ vì <strong>nghe quen</strong>."
          good="Kiểm tra <strong>loại từ, ngữ pháp và nghĩa</strong>."
          why="Đáp án đúng phải khớp cả ba yếu tố, không chỉ khớp nghĩa."
        />

        <TrapCard
          bad="Many <strong>information</strong> · much <strong>people</strong>"
          good="Much <strong>information</strong> · many <strong>people</strong>"
          why="Information không đếm được; people là danh từ số nhiều."
        />

        <TrapCard
          bad="It depends <strong>of</strong> the weather."
          good="It depends <strong>on</strong> the weather."
          why="Depend on là cụm cố định; không dịch “của” thành of."
        />

        <TrapCard
          bad="She decided <strong>going</strong> abroad."
          good="She decided <strong>to go</strong> abroad."
          why="Decide + to-V. Đừng chỉ nhìn nghĩa mà bỏ qua mẫu động từ."
        />

        <TrapCard
          bad="The book <strong>who</strong> I borrowed is interesting."
          good="The book <strong>which</strong> I borrowed is interesting."
          why="Who dùng cho người; which/that dùng cho vật."
        />

        <TrapCard
          bad="It was <strong>so awful weather</strong>."
          good="It was <strong>such awful weather</strong>."
          why="So + adj; such + (a/an) + adj + N. Weather không đếm được nên không có “an”."
        />

        <TrapCard
          bad="<strong>Because</strong> the rain, we stayed home."
          good="<strong>Because of</strong> the rain, we stayed home."
          why="Because + mệnh đề; because of + N/V-ing."
        />

        <TrapCard
          bad="He <strong>did</strong> a decision."
          good="He <strong>made</strong> a decision."
          why="Decision đi với make; homework đi với do. Học cả cụm."
        />

        <TrapCard
          bad="She is <strong>a</strong> honest girl."
          good="She is <strong>an</strong> honest girl."
          why="Chọn a/an theo âm đầu, không theo chữ cái: an hour, an honest person."
        />

        <TrapCard
          bad="Điền xong nhưng không đọc lại cả đoạn."
          good="Đọc lại để kiểm tra logic và mạch văn."
