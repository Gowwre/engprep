---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSheet, sheets, totalQuestions } from '../data/sheets';

const tenses = getSheet('tenses');
const prepositions = getSheet('prepositions');
const wordForms = getSheet('word-forms');
const reading = getSheet('reading');
const pronunciation = getSheet('pronunciation');
const sentenceTransformation = getSheet('sentence-transformation');
const vocabulary = getSheet('vocabulary');
const cloze = getSheet('cloze');
const signs = getSheet('signs');
---

<BaseLayout
  title="EngPrep — Cheat sheet 12 thì, giới từ, word forms, reading, phát âm, viết lại câu, từ vựng, điền khuyết & biển báo lớp 9"
  description="Bộ cheat sheet tiếng Anh lớp 9: 12 thì, giới từ, word forms, reading comprehension, phát âm – trọng âm, viết lại câu, từ vựng, cloze và gap-fill, biển báo – giao tiếp, bẫy đề và bài luyện tập có giải thích. Một chỗ ôn thi, in được khổ A4, dùng offline."
  current="home"
>
  <!-- HERO -->
  <section class="hero" id="top">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Global Success 9 · Ôn thi vào 10</p>
        <h1>Chín tờ cheat sheet,<br>một chỗ <span class="marker">ôn thi</span>.</h1>
        <p class="hero-lead">12 thì, giới từ, word forms, reading, phát âm – trọng âm, viết lại câu, từ vựng – collocations, cloze và biển báo – giao tiếp, gói gọn trong chín tờ ôn thi in được khổ A4. Công thức, dấu hiệu, bẫy đề và bài luyện tập có giải thích — tất cả ở cùng một nơi.</p>

        <div class="hero-actions hero-actions--home">
          <a class="btn btn-primary" href={tenses.href}>
            12 thì
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
          <a class="btn btn-ghost" href={prepositions.href}>
            Giới từ
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18l6-6-6-6"/></svg>
          </a>
          <a class="btn btn-ghost" href={wordForms.href}>
            Word forms
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18l6-6-6-6"/></svg>
          </a>
          <a class="btn btn-ghost" href={reading.href}>
            Đọc hiểu
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18l6-6-6-6"/></svg>
          </a>
          <a class="btn btn-ghost" href={pronunciation.href}>
            Phát âm
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18l6-6-6-6"/></svg>
          </a>
          <a class="btn btn-ghost" href={sentenceTransformation.href}>
            Viết lại câu
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18l6-6-6-6"/></svg>
          </a>
          <a class="btn btn-ghost" href={vocabulary.href}>
            Từ vựng
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18l6-6-6-6"/></svg>
          </a>
          <a class="btn btn-ghost" href={cloze.href}>
            Điền khuyết
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18l6-6-6-6"/></svg>
          </a>
          <a class="btn btn-ghost" href={signs.href}>
            Biển báo
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18l6-6-6-6"/></svg>
          </a>
        </div>

        <ul class="hero-badges" aria-label="Thông tin bộ tài liệu">
          <li>In được khổ A4</li>
          <li>Không cần mạng</li>
          <li>Giải thích tiếng Việt</li>
        </ul>

        <dl class="hero-stats">
          <div><dt>12</dt><dd>thì cần nắm</dd></div>
          <div><dt>54</dt><dd>cụm giới từ</dd></div>
          <div><dt>{totalQuestions}</dt><dd>câu luyện tập</dd></div>
        </dl>
      </div>

      <div class="hero-visual" aria-hidden="true">
        <div class="hub-stack hub-stack--nine">
          <div class="hub-sheet hub-sheet--tenses">
            <span class="hub-sheet-kicker">Cheat sheet 01</span>
            <strong class="hub-sheet-title">12 thì</strong>
            <p class="hub-sheet-formula">S + have/has<br>+ V3/ed</p>
            <div class="mini-rule"></div>
            <div class="mini-chips">
              <span>since 2015</span><span>for 3 years</span><span>already</span>
            </div>
            <p class="mini-example">I <mark>have visited</mark> Hue three times.</p>
          </div>

          <div class="hub-sheet hub-sheet--prep">
            <span class="hub-sheet-kicker">Cheat sheet 02</span>
            <strong class="hub-sheet-title">Giới từ</strong>
            <p class="hub-sheet-formula">AT a point<br>ON a surface<br>IN a space</p>
            <div class="mini-rule"></div>
            <div class="mini-chips">
              <span>at 7 p.m.</span><span>on Monday</span><span>in 2026</span>
            </div>
            <p class="mini-example">We met <mark>at</mark> the cinema <mark>on</mark> Saturday.</p>
          </div>

          <div class="hub-sheet hub-sheet--word">
            <span class="hub-sheet-kicker">Cheat sheet 03</span>
            <strong class="hub-sheet-title">Word forms</strong>
            <p class="hub-sheet-formula">success<br>→ successful<br>→ successfully</p>
            <div class="mini-rule"></div>
            <div class="mini-chips">
              <span>-tion</span><span>-ful</span><span>-ly</span><span>un-</span>
            </div>
            <p class="mini-example">She is a <mark>successful</mark> singer.</p>
          </div>

          <div class="hub-sheet hub-sheet--reading">
            <span class="hub-sheet-kicker">Cheat sheet 04</span>
            <strong class="hub-sheet-title">Reading</strong>
            <p class="hub-sheet-formula">main idea<br>→ detail<br>→ inference</p>
            <div class="mini-rule"></div>
            <div class="mini-chips">
              <span>skim</span><span>scan</span><span>however</span>
            </div>
            <p class="mini-example">The answer needs <mark>evidence</mark>.</p>
          </div>

          <div class="hub-sheet hub-sheet--sound">
            <span class="hub-sheet-kicker">Cheat sheet 05</span>
            <strong class="hub-sheet-title">Sounds</strong>
            <p class="hub-sheet-formula">-ed · -s<br>vowels<br>stress</p>
            <div class="mini-rule"></div>
            <div class="mini-chips">
              <span>/t/</span><span>/d/</span><span>/ɪd/</span>
            </div>
            <p class="mini-example">“Watched” ends in <mark>/t/</mark>.</p>
          </div>

          <div class="hub-sheet hub-sheet--write">
            <span class="hub-sheet-kicker">Cheat sheet 06</span>
            <strong class="hub-sheet-title">Rewriting</strong>
            <p class="hub-sheet-formula">If / Unless<br>wish<br>so … that</p>
            <div class="mini-rule"></div>
            <div class="mini-chips">
              <span>V-ing</span><span>since</span><span>despite</span>
            </div>
            <p class="mini-example">I wish I <mark>had</mark> a bike.</p>
          </div>

          <div class="hub-sheet hub-sheet--vocab">
            <span class="hub-sheet-kicker">Cheat sheet 07</span>
            <strong class="hub-sheet-title">Vocabulary</strong>
            <p class="hub-sheet-formula">collocations<br>phrasal verbs<br>dictionary</p>
            <div class="mini-rule"></div>
            <div class="mini-chips">
              <span>make a decision</span><span>look after</span><span>eating habits</span>
            </div>
            <p class="mini-example">Learn <mark>collocations</mark>, not single words.</p>
          </div>

          <div class="hub-sheet hub-sheet--cloze">
            <span class="hub-sheet-kicker">Cheat sheet 08</span>
            <strong class="hub-sheet-title">Cloze</strong>
            <p class="hub-sheet-formula">grammar<br>vocabulary<br>connectors</p>
            <div class="mini-rule"></div>
            <div class="mini-chips">
              <span>however</span><span>depend on</span><span>much</span>
            </div>
            <p class="mini-example">Read the <mark>whole sentence</mark>.</p>
          </div>

          <div class="hub-sheet hub-sheet--signs">
            <span class="hub-sheet-kicker">Cheat sheet 09</span>
            <strong class="hub-sheet-title">Signs</strong>
            <p class="hub-sheet-formula">notices<br>communication<br>responses</p>
            <div class="mini-rule"></div>
            <div class="mini-chips">
              <span>NO PARKING</span><span>FREE ENTRY</span><span>Not at all.</span>
            </div>
            <p class="mini-example">Read the <mark>key word</mark>.</p>
          </div>
        </div>

        <div class="sticky-note">
          <span class="sticky-label">Mẹo dùng</span>
          <strong>In ra và dán</strong>
          <span>ở góc học tập!</span>
        </div>
        <div class="stamp stamp-home">Học<br>mỗi ngày<br><span>10 phút</span></div>
      </div>
    </div>
  </section>

  <!-- RESOURCES -->
  <section class="section" id="resources">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="section-kicker">01 · Bộ tài liệu</p>
          <h2>Chín tờ cheat sheet, đủ để ôn.</h2>
          <p>Mỗi tờ có sơ đồ, bảng tra nhanh, bẫy đề và bài kiểm tra riêng. Bắt đầu từ tờ bạn cần, hoặc đi theo lộ trình bên dưới.</p>
        </div>
        <p class="section-aside"><span>{sheets.length}</span> tờ<br><span>{totalQuestions}</span> câu hỏi</p>
      </div>

      <div class="hub-grid">
        {sheets.map((sheet) => (
          <article class:list={['hub-card', `hub-card--${sheet.accent}`]}>
            <div class="hub-card-top">
              <span class="hub-card-no">{sheet.cardNo}</span>
              <span class="hub-badge">{sheet.badge}</span>
            </div>
            <h3>{sheet.title}</h3>
            <p class="hub-card-lead">{sheet.lead}</p>
            <div class="hub-preview" aria-hidden="true">
              {sheet.preview.map((item) => <span>{item}</span>)}
            </div>
            <ul class="hub-list">
              {sheet.highlights.map((highlight) => (
                <li>
                  {highlight.strong && <strong>{highlight.strong}</strong>}
                  {highlight.text}
                </li>
              ))}
            </ul>
            <div class="hub-card-foot">
              <span class="hub-meta">{sheet.meta}</span>
              <a class="btn btn-primary btn-small" href={sheet.href}>
                Mở cheat sheet
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- PATH -->
  <section class="section section-alt" id="plan">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="section-kicker">02 · Lộ trình</p>
          <h2>Năm bước trước khi làm đề.</h2>
          <p>Không cần học hết trong một buổi. Đi theo thứ tự này để nhớ lâu hơn.</p>
        </div>
        <p class="section-aside"><span>5</span> bước<br>mỗi ngày 10 phút</p>
      </div>

      <div class="path-grid">
        <article class="path-card">
          <span class="path-no" aria-hidden="true">01</span>
          <h3>Nắm 12 thì</h3>
          <p>Đọc sơ đồ, sau đó học công thức và dấu hiệu của từng thì. Ưu tiên hiện tại hoàn thành, quá khứ tiếp diễn và tương lai đơn.</p>
          <a class="path-link" href={tenses.href}>Mở 12 thì →</a>
        </article>

        <article class="path-card">
          <span class="path-no" aria-hidden="true">02</span>
          <h3>Học giới từ theo cụm</h3>
          <p>Nắm at/on/in trước, rồi học 54 cụm cố định. Đừng cố dịch từng giới từ riêng lẻ.</p>
          <a class="path-link" href={prepositions.href}>Mở giới từ →</a>
        </article>

        <article class="path-card">
          <span class="path-no" aria-hidden="true">03</span>
          <h3>Luyện từ vựng &amp; kỹ năng</h3>
          <p>Học word forms, từ vựng – collocations, cloze, đọc hiểu, phát âm – trọng âm và biển báo – giao tiếp.</p>
          <div class="path-links">
            <a href={wordForms.href}>Word forms</a>
            <a href={vocabulary.href}>Từ vựng</a>
            <a href={cloze.href}>Cloze</a>
            <a href={reading.href}>Reading</a>
            <a href={pronunciation.href}>Phát âm</a>
            <a href={signs.href}>Biển báo</a>
          </div>
        </article>

        <article class="path-card">
          <span class="path-no" aria-hidden="true">04</span>
          <h3>Viết lại câu</h3>
          <p>Học tám nhóm mẫu, mẫu động từ và các bẫy thường gặp ở câu 37–40.</p>
          <a class="path-link" href={sentenceTransformation.href}>Mở viết lại câu →</a>
        </article>

        <article class="path-card">
          <span class="path-no" aria-hidden="true">05</span>
          <h3>Tự kiểm tra</h3>
          <p>Làm bài ngắn để biết phần nào còn hổng, rồi quay lại đúng mục cần ôn.</p>
          <div class="path-links">
            <a href={`${tenses.href}#quiz`}>12 câu thì</a>
            <a href={`${prepositions.href}#quiz`}>16 câu giới từ</a>
            <a href={`${wordForms.href}#quiz`}>16 câu word forms</a>
            <a href={`${reading.href}#quiz`}>12 câu reading</a>
            <a href={`${pronunciation.href}#quiz`}>16 câu phát âm</a>
            <a href={`${sentenceTransformation.href}#quiz`}>16 câu viết lại</a>
            <a href={`${vocabulary.href}#quiz`}>16 câu từ vựng</a>
            <a href={`${cloze.href}#quiz`}>12 câu cloze</a>
            <a href={`${signs.href}#quiz`}>16 câu biển báo</a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- CLOSING -->
  <section class="section">
    <div class="container">
      <div class="home-band">
        <div>
          <p class="section-kicker">03 · Mang vào phòng thi</p>
          <h2>Chín quy tắc nhớ nhanh.</h2>
          <p><strong>Thì:</strong> since + mốc, for + khoảng · <strong>Giới từ:</strong> at + giờ, on + ngày, in + tháng/năm · <strong>Từ loại:</strong> sau tính từ thường là danh từ, sau động từ thường là trạng từ · <strong>Đọc hiểu:</strong> đáp án phải có bằng chứng trong bài · <strong>Phát âm:</strong> xét âm cuối, không xét chữ cuối · <strong>Viết lại:</strong> đổi cấu trúc, giữ nguyên nghĩa · <strong>Từ vựng:</strong> học cả cụm, không học từ đơn · <strong>Cloze:</strong> đọc cả câu, kiểm tra ngữ pháp và nghĩa · <strong>Biển báo:</strong> bám từ khoá No, Only, Free, Required.</p>
        </div>
        <div class="home-band-actions">
          <a class="btn btn-primary" href={tenses.href}>Ôn 12 thì</a>
          <a class="btn btn-ghost" href={prepositions.href}>Ôn giới từ</a>
          <a class="btn btn-ghost" href={wordForms.href}>Ôn word forms</a>
          <a class="btn btn-ghost" href={reading.href}>Luyện đọc hiểu</a>
          <a class="btn btn-ghost" href={pronunciation.href}>Luyện phát âm</a>
          <a class="btn btn-ghost" href={sentenceTransformation.href}>Luyện viết lại câu</a>
          <a class="btn btn-ghost" href={vocabulary.href}>Luyện từ vựng</a>
          <a class="btn btn-ghost" href={cloze.href}>Luyện cloze</a>
          <a class="btn btn-ghost" href={signs.href}>Luyện biển báo</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
