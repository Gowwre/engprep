---
import '../styles/global.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import EmptyState from '../components/EmptyState.astro';
import SectionHead from '../components/SectionHead.astro';
import { getSheet, sheets, totalQuestions } from '../data/sheets';
import '../styles/home.css';

const tenses = getSheet('tenses');
const prepositions = getSheet('prepositions');
const wordForms = getSheet('word-forms');
const reading = getSheet('reading');
const pronunciation = getSheet('pronunciation');
const sentenceTransformation = getSheet('sentence-transformation');
const vocabulary = getSheet('vocabulary');
const cloze = getSheet('cloze');
const signs = getSheet('signs');
const grammar = getSheet('grammar');
const sentenceConstruction = getSheet('sentence-construction');
const mockExam = getSheet('mock-exam');

const pathNotes: Record<string, string> = {
  tenses: 'Sơ đồ 4×3, sáu thì trọng tâm và 12 câu luyện tập.',
  prepositions: 'at/on/in, 54 cụm cố định và 16 câu luyện tập.',
  'word-forms': 'Vị trí từ loại, hậu tố và 40 họ từ.',
  reading: 'Bảy dạng câu, bốn bước đọc và đoạn mẫu.',
  pronunciation: 'Đuôi -ed, -s/-es và trọng âm 2–3 âm tiết.',
  'sentence-transformation': 'Tám nhóm công thức viết lại câu.',
  vocabulary: 'Sáu nhóm cụm, cụm động từ và mục từ điển.',
  cloze: 'Năm loại chỗ trống và bốn bước điền khuyết.',
  signs: 'Bốn nhóm biển báo và tám chức năng giao tiếp.',
  grammar: 'Bốn nhóm ngữ pháp lõi và bốn điểm phụ.',
  'sentence-construction': 'Trật tự từ, bốn bước ghép câu và mục từ điển.',
  'mock-exam': 'Đề 24 câu, 45 phút, chấm điểm theo phần.'
};

const pathDays = sheets.map((sheet, index) => ({
  ...sheet,
  day: String(index + 1).padStart(2, '0'),
  note: pathNotes[sheet.slug]
}));

const rules = [
  { label: 'Thì', text: 'since + mốc, for + khoảng.', href: tenses.href },
  { label: 'Giới từ', text: 'at + giờ, on + ngày, in + tháng/năm.', href: prepositions.href },
  { label: 'Từ loại', text: 'Sau tính từ thường là danh từ.', href: wordForms.href },
  { label: 'Đọc hiểu', text: 'Đáp án phải có bằng chứng trong bài.', href: reading.href },
  { label: 'Phát âm', text: 'Xét âm cuối, không xét chữ cuối.', href: pronunciation.href },
  { label: 'Viết lại', text: 'Đổi cấu trúc, giữ nguyên nghĩa.', href: sentenceTransformation.href },
  { label: 'Từ vựng', text: 'Học cả cụm, không học từ đơn.', href: vocabulary.href },
  { label: 'Điền khuyết', text: 'Đọc cả câu, kiểm tra ngữ pháp và nghĩa.', href: cloze.href },
  { label: 'Biển báo', text: 'Bám từ khoá No, Only, Free, Required.', href: signs.href },
  { label: 'Ngữ pháp', text: 'Nhìn từ đứng trước và cấu trúc cần điền.', href: grammar.href },
  { label: 'Phần VI', text: 'Tìm S + V, giữ cụm cố định.', href: sentenceConstruction.href },
  { label: 'Thi thử', text: 'Canh 45 phút, không bỏ trống.', href: mockExam.href }
];
---

<BaseLayout
  title="EngPrep — Tờ ôn thi tiếng Anh lớp 9 & đề thi thử"
  description="12 tờ ôn thi tiếng Anh lớp 9: ngữ pháp, từ vựng, đọc hiểu, phát âm, viết lại câu và đề thi thử 24 câu. In A4, dùng offline, có giải thích tiếng Việt."
  current="home"
>
  <!-- HERO -->
  <section class="hero" id="top">
    <div class="container hero-grid hero-grid--home">
      <div class="hero-copy">
        <p class="eyebrow">Global Success 9 · Ôn thi vào 10</p>
        <h1>Mười hai tờ,<br>một chỗ <span class="marker">ôn thi</span>.</h1>
        <p class="hero-lead">12 tờ ôn thi in được khổ A4: công thức, dấu hiệu, bẫy đề và bài luyện tập có giải thích. Chọn một tờ để bắt đầu, hoặc đi theo lộ trình 12 ngày.</p>

        <div class="hero-actions">
          <a class="btn btn-primary" href="#resources" data-home-jump="sheets">Chọn tờ để ôn</a>
          <a class="btn btn-ghost" href="#plan" data-home-jump="path">Xem lộ trình</a>
        </div>

        <dl class="hero-stats">
          <div><dt>12</dt><dd>thì cần nắm</dd></div>
          <div><dt>54</dt><dd>cụm giới từ</dd></div>
          <div><dt>{totalQuestions}</dt><dd>câu luyện tập</dd></div>
        </dl>
      </div>

      <div class="hero-visual">
        <div class="hub-stack hub-stack--twelve">
          <a class="hub-sheet hub-sheet--tenses" data-accent="tenses" href={tenses.href}>
            <span class="hub-sheet-kicker">Tờ 01</span>
            <strong class="hub-sheet-title">12 thì</strong>
            <p class="hub-sheet-formula">S + have/has<br>+ V3/ed</p>
            <div class="mini-rule"></div>
            <div class="mini-chips">
              <span>since 2015</span><span>for 3 years</span><span>already</span>
            </div>
            <p class="mini-example">I <mark>have visited</mark> Hue three times.</p>
            <span class="hub-sheet-open">Xem <span aria-hidden="true">→</span></span>
          </a>

          <a class="hub-sheet hub-sheet--prep" data-accent="prep" href={prepositions.href}>
            <span class="hub-sheet-kicker">Tờ 02</span>
            <strong class="hub-sheet-title">Giới từ</strong>
            <p class="hub-sheet-formula">AT a point<br>ON a surface<br>IN a space</p>
            <div class="mini-rule"></div>
            <div class="mini-chips">
              <span>at 7 p.m.</span><span>on Monday</span><span>in 2026</span>
            </div>
            <p class="mini-example">We met <mark>at</mark> the cinema <mark>on</mark> Saturday.</p>
            <span class="hub-sheet-open">Xem <span aria-hidden="true">→</span></span>
          </a>

          <a class="hub-sheet hub-sheet--word" data-accent="word" href={wordForms.href}>
            <span class="hub-sheet-kicker">Tờ 03</span>
            <strong class="hub-sheet-title">Từ loại</strong>
            <p class="hub-sheet-formula">success<br>→ successful<br>→ successfully</p>
            <div class="mini-rule"></div>
            <div class="mini-chips">
              <span>-tion</span><span>-ful</span><span>-ly</span><span>un-</span>
            </div>
            <p class="mini-example">She is a <mark>successful</mark> singer.</p>
            <span class="hub-sheet-open">Xem <span aria-hidden="true">→</span></span>
          </a>

          <a class="hub-sheet hub-sheet--reading" data-accent="reading" href={reading.href}>
            <span class="hub-sheet-kicker">Tờ 04</span>
            <strong class="hub-sheet-title">Đọc hiểu</strong>
            <p class="hub-sheet-formula">ý chính<br>→ chi tiết<br>→ suy luận</p>
            <div class="mini-rule"></div>
            <div class="mini-chips">
              <span>skim</span><span>scan</span><span>however</span>
            </div>
            <p class="mini-example">The answer needs <mark>evidence</mark>.</p>
            <span class="hub-sheet-open">Xem <span aria-hidden="true">→</span></span>
          </a>

          <a class="hub-sheet hub-sheet--sound" data-accent="sound" href={pronunciation.href}>
            <span class="hub-sheet-kicker">Tờ 05</span>
            <strong class="hub-sheet-title">Phát âm</strong>
            <p class="hub-sheet-formula">-ed · -s<br>nguyên âm<br>trọng âm</p>
            <div class="mini-rule"></div>
            <div class="mini-chips">
              <span>/t/</span><span>/d/</span><span>/ɪd/</span>
            </div>
            <p class="mini-example">“Watched” ends in <mark>/t/</mark>.</p>
            <span class="hub-sheet-open">Xem <span aria-hidden="true">→</span></span>
          </a>

          <a class="hub-sheet hub-sheet--write" data-accent="write" href={sentenceTransformation.href}>
            <span class="hub-sheet-kicker">Tờ 06</span>
            <strong class="hub-sheet-title">Viết lại câu</strong>
            <p class="hub-sheet-formula">If / Unless<br>wish<br>so … that</p>
            <div class="mini-rule"></div>
            <div class="mini-chips">
              <span>V-ing</span><span>since</span><span>despite</span>
            </div>
            <p class="mini-example">I wish I <mark>had</mark> a bike.</p>
            <span class="hub-sheet-open">Xem <span aria-hidden="true">→</span></span>
          </a>

          <a class="hub-sheet hub-sheet--vocab" data-accent="vocab" href={vocabulary.href}>
            <span class="hub-sheet-kicker">Tờ 07</span>
            <strong class="hub-sheet-title">Từ vựng</strong>
            <p class="hub-sheet-formula">cụm từ<br>cụm động từ<br>mục từ</p>
            <div class="mini-rule"></div>
            <div class="mini-chips">
              <span>make a decision</span><span>look after</span><span>eating habits</span>
            </div>
            <p class="mini-example">Learn <mark>collocations</mark>, not single words.</p>
            <span class="hub-sheet-open">Xem <span aria-hidden="true">→</span></span>
          </a>

          <a class="hub-sheet hub-sheet--cloze" data-accent="cloze" href={cloze.href}>
            <span class="hub-sheet-kicker">Tờ 08</span>
            <strong class="hub-sheet-title">Điền khuyết</strong>
            <p class="hub-sheet-formula">ngữ pháp<br>từ vựng<br>từ nối</p>
            <div class="mini-rule"></div>
            <div class="mini-chips">
              <span>however</span><span>depend on</span><span>much</span>
            </div>
            <p class="mini-example">Read the <mark>whole sentence</mark>.</p>
            <span class="hub-sheet-open">Xem <span aria-hidden="true">→</span></span>
          </a>

          <a class="hub-sheet hub-sheet--signs" data-accent="signs" href={signs.href}>
            <span class="hub-sheet-kicker">Tờ 09</span>
            <strong class="hub-sheet-title">Biển báo</strong>
            <p class="hub-sheet-formula">thông báo<br>giao tiếp<br>đáp lại</p>
            <div class="mini-rule"></div>
            <div class="mini-chips">
              <span>NO PARKING</span><span>FREE ENTRY</span><span>Not at all.</span>
            </div>
            <p class="mini-example">Read the <mark>key word</mark>.</p>
            <span class="hub-sheet-open">Xem <span aria-hidden="true">→</span></span>
          </a>

          <a class="hub-sheet hub-sheet--grammar" data-accent="grammar" href={grammar.href}>
            <span class="hub-sheet-kicker">Tờ 10</span>
            <strong class="hub-sheet-title">Ngữ pháp</strong>
            <p class="hub-sheet-formula">từ nối<br>mệnh đề quan hệ<br>so sánh<br>mẫu động từ</p>
            <div class="mini-rule"></div>
            <div class="mini-chips">
              <span>however</span><span>who / which</span><span>more crowded</span>
            </div>
            <p class="mini-example">Choose the <mark>structure</mark>, not the sound.</p>
            <span class="hub-sheet-open">Xem <span aria-hidden="true">→</span></span>
          </a>

          <a class="hub-sheet hub-sheet--sentence" data-accent="sentence" href={sentenceConstruction.href}>
            <span class="hub-sheet-kicker">Tờ 11</span>
            <strong class="hub-sheet-title">Sắp xếp câu</strong>
            <p class="hub-sheet-formula">S + V + O<br>by + V-ing<br>Phần VI</p>
            <div class="mini-rule"></div>
            <div class="mini-chips">
              <span>S + V + O</span><span>by presenting</span><span>break the habit</span>
            </div>
            <p class="mini-example">Find the <mark>main verb</mark> first.</p>
            <span class="hub-sheet-open">Xem <span aria-hidden="true">→</span></span>
          </a>

          <a class="hub-sheet hub-sheet--mock" data-accent="mock" href={mockExam.href}>
            <span class="hub-sheet-kicker">Tờ 12</span>
            <strong class="hub-sheet-title">Thi thử</strong>
            <p class="hub-sheet-formula">24 câu<br>45 phút<br>chấm điểm</p>
            <div class="mini-rule"></div>
            <div class="mini-chips">
              <span>đồng hồ</span><span>điểm</span><span>xem lại</span>
            </div>
            <p class="mini-example">Find your <mark>weak spots</mark>.</p>
            <span class="hub-sheet-open">Xem <span aria-hidden="true">→</span></span>
          </a>
        </div>

        <div class="sticky-note" aria-hidden="true">
          <span class="sticky-label">Mẹo dùng</span>
          <strong>In ra và dán</strong>
          <span>ở góc học tập!</span>
        </div>
        <div class="stamp stamp-home" aria-hidden="true">Học<br>mỗi ngày<br><span>10 phút</span></div>
      </div>
    </div>
  </section>

  <!-- MODE SWITCH -->
  <div class="home-switch">
    <div class="container">
      <div class="home-progress" id="home-progress" aria-live="polite">
        <p class="home-progress-label">Tiến độ của bạn</p>
        <p class="home-progress-copy">
          <strong data-progress-done>0</strong>/12 tờ đã luyện
          <span class="home-progress-dot" aria-hidden="true"> · </span>
          <span data-progress-mock>Thi thử: chưa làm</span>
        </p>
        <a class="home-progress-next" id="home-continue" href="#resources" hidden>Tiếp tục →</a>
      </div>

      <noscript>
        <style>
          .home-mode-tabs { display: none !important; }
          .home-mode-panel { display: block !important; }
        </style>
      </noscript>
      <div class="home-mode-tabs" role="tablist" aria-label="Cách ôn">
        <button class="home-mode-tab" type="button" role="tab" id="tab-sheets" aria-selected="true" aria-controls="resources-panel" data-home-tab="sheets">Ôn theo tờ</button>
        <button class="home-mode-tab" type="button" role="tab" id="tab-path" aria-selected="false" aria-controls="plan-panel" tabindex="-1" data-home-tab="path">Ôn theo lộ trình</button>
      </div>
    </div>
  </div>

  <!-- RESOURCES -->
  <div class="home-mode-panel" id="resources-panel" data-home-panel="sheets">
  <section class="section" id="resources">
    <div class="container">
      <SectionHead title="Mười hai tờ, đủ để ôn.">
        Mỗi tờ có sơ đồ, bảng tra nhanh, bẫy đề và bài kiểm tra riêng. Tìm tờ bạn cần, hoặc chuyển sang lộ trình 12 ngày.
        <p slot="aside" class="section-aside"><span>{sheets.length}</span> tờ<br><span>{totalQuestions}</span> câu hỏi</p>
      </SectionHead>

      <div class="home-tools">
        <div class="search-wrap">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <circle cx="11" cy="11" r="7" />
            <path d="M20 20l-3.5-3.5" />
          </svg>
          <label class="sr-only" for="home-search">Tìm tờ hoặc kỹ năng</label>
          <input id="home-search" type="search" placeholder="Tìm “thì”, “đọc hiểu”, “biển báo”…" autocomplete="off" />
          <button class="search-clear" id="home-clear" type="button" aria-label="Xoá tìm kiếm" hidden>&times;</button>
        </div>
        <span class="result-count" id="home-count" aria-live="polite">12/12 tờ</span>
      </div>

      <EmptyState
        id="home-empty"
        title="Không tìm thấy tờ phù hợp"
        text="Thử từ khoá khác hoặc xoá bộ lọc."
        resetId="home-reset"
      />

      <div class="hub-grid">
        {sheets.map((sheet) => (
          <article class:list={['hub-card']} data-accent={sheet.accent}>
            <div class="hub-card-top">
              <span class="hub-card-no">{sheet.cardNo}</span>
              <span class="badge badge--accent">{sheet.badge}</span>
            </div>
            <h3>{sheet.title}</h3>
            <p class="hub-card-lead">{sheet.lead}</p>
            <div class="hub-preview" aria-hidden="true">
              {sheet.preview.map((item) => <span>{item}</span>)}
            </div>
            <ul class="hub-list">
              {sheet.highlights.map((highlight) => (
                <li>
                  {highlight.strong && <strong>{highlight.strong}</strong>}
                  {highlight.text}
                </li>
              ))}
            </ul>
            <div class="hub-card-foot">
              <span class="hub-meta">{sheet.meta}</span>
              <span class="hub-progress" data-progress-sheet={sheet.slug}>Chưa luyện</span>
              <a class="btn btn-ghost btn-small" href={sheet.href}>
                Xem
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
  </div>

  <!-- PATH -->
  <div class="home-mode-panel" id="plan-panel" data-home-panel="path" hidden>
  <section class="section section-alt" id="plan">
    <div class="container">
      <SectionHead title="Lộ trình 12 ngày.">
        Mỗi ngày một tờ: 10 phút Ôn nhanh, sau đó 10–20 phút luyện tập. Đi đều quan trọng hơn học dồn.
        <p slot="aside" class="section-aside"><span>12</span> ngày<br><span>20–30</span> phút / ngày</p>
      </SectionHead>

      <div class="path-grid path-grid--days">
        {pathDays.map((day) => (
          <a class="path-card path-day" href={day.href} data-path-sheet={day.slug}>
            <span class="path-no" aria-hidden="true">{day.day}</span>
            <div class="path-day-head">
              <h3>{day.title}</h3>
              <span class="path-status" data-path-status={day.slug}>Chưa luyện</span>
            </div>
            <p>{day.note}</p>
            <span class="path-day-meta">Ngày {Number(day.day)} · 20–30 phút <span aria-hidden="true">→</span></span>
          </a>
        ))}
      </div>
    </div>
  </section>
  </div>

  <!-- RULES -->
  <section class="section section-alt" id="rules">
    <div class="container">
      <SectionHead title="Mười hai quy tắc nhớ nhanh.">
        Mỗi thẻ là một câu nhắc; bấm để mở tờ tương ứng.
        <p slot="aside" class="section-aside"><span>12</span> quy tắc<br><span>1</span> màn hình</p>
      </SectionHead>

      <div class="rule-grid">
        {rules.map((rule, index) => (
          <a class="rule-card" href={rule.href}>
            <span class="rule-no" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            <strong>{rule.label}</strong>
            <span>{rule.text}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CLOSING -->
  <section class="section">
    <div class="container">
      <div class="home-band">
        <div>
          <h2>Sẵn sàng làm đề chưa?</h2>
          <p>Làm đề 24 câu để biết phần nào còn hổng, rồi quay lại đúng tờ cần ôn.</p>
        </div>
        <div class="home-band-actions">
          <a class="btn btn-primary" href={mockExam.href}>Thi thử 24 câu</a>
          <a class="btn btn-ghost" href={tenses.href}>Ôn 12 thì</a>
          <a class="btn btn-ghost" href={grammar.href}>Luyện ngữ pháp</a>
        </div>
      </div>
    </div>
  </section>

  <script>
    import '../scripts/home.js';
  </script>
</BaseLayout>
