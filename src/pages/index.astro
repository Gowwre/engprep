---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSheet, sheets, totalQuestions } from '../data/sheets';

const tenses = getSheet('tenses');
const prepositions = getSheet('prepositions');
const wordForms = getSheet('word-forms');
const reading = getSheet('reading');
const pronunciation = getSheet('pronunciation');
const sentenceTransformation = getSheet('sentence-transformation');
const vocabulary = getSheet('vocabulary');
const cloze = getSheet('cloze');
const signs = getSheet('signs');
const grammar = getSheet('grammar');
const sentenceConstruction = getSheet('sentence-construction');
const mockExam = getSheet('mock-exam');
---

<BaseLayout
  title="EngPrep — Tờ ôn thi tiếng Anh lớp 9 & đề thi thử"
  description="12 tờ ôn thi tiếng Anh lớp 9: ngữ pháp, từ vựng, đọc hiểu, phát âm, viết lại câu và đề thi thử 24 câu. In A4, dùng offline, có giải thích tiếng Việt."
  current="home"
>
  <!-- HERO -->
  <section class="hero" id="top">
    <div class="container hero-grid hero-grid--home">
      <div class="hero-copy">
        <p class="eyebrow">Global Success 9 · Ôn thi vào 10</p>
        <h1>Mười hai tờ,<br>một chỗ <span class="marker">ôn thi</span>.</h1>
        <p class="hero-lead">12 thì, giới từ, từ loại, đọc hiểu, phát âm – trọng âm, viết lại câu, từ vựng – cụm từ, điền khuyết, biển báo – giao tiếp, ngữ pháp cốt lõi, sắp xếp câu – phần VI và đề thi thử 24 câu, gói gọn trong mười hai tờ ôn thi in được khổ A4. Công thức, dấu hiệu, bẫy đề và bài luyện tập có giải thích — tất cả ở cùng một nơi.</p>

        <dl class="hero-stats">
          <div><dt>12</dt><dd>thì cần nắm</dd></div>
          <div><dt>54</dt><dd>cụm giới từ</dd></div>
          <div><dt>{totalQuestions}</dt><dd>câu luyện tập</dd></div>
        </dl>
      </div>

      <div class="hero-visual">
        <div class="hub-stack hub-stack--twelve">
          <a class="hub-sheet hub-sheet--tenses" href={tenses.href} aria-label="Xem 12 thì">
            <span class="hub-sheet-kicker">Tờ 01</span>
            <strong class="hub-sheet-title">12 thì</strong>
            <p class="hub-sheet-formula">S + have/has<br>+ V3/ed</p>
            <div class="mini-rule"></div>
            <div class="mini-chips">
              <span>since 2015</span><span>for 3 years</span><span>already</span>
            </div>
            <p class="mini-example">I <mark>have visited</mark> Hue three times.</p>
            <span class="hub-sheet-open">Xem <span aria-hidden="true">→</span></span>
          </a>

          <a class="hub-sheet hub-sheet--prep" href={prepositions.href} aria-label="Xem Giới từ">
            <span class="hub-sheet-kicker">Tờ 02</span>
            <strong class="hub-sheet-title">Giới từ</strong>
            <p class="hub-sheet-formula">AT a point<br>ON a surface<br>IN a space</p>
            <div class="mini-rule"></div>
            <div class="mini-chips">
              <span>at 7 p.m.</span><span>on Monday</span><span>in 2026</span>
            </div>
            <p class="mini-example">We met <mark>at</mark> the cinema <mark>on</mark> Saturday.</p>
            <span class="hub-sheet-open">Xem <span aria-hidden="true">→</span></span>
          </a>

          <a class="hub-sheet hub-sheet--word" href={wordForms.href} aria-label="Xem Từ loại">
            <span class="hub-sheet-kicker">Tờ 03</span>
            <strong class="hub-sheet-title">Từ loại</strong>
            <p class="hub-sheet-formula">success<br>→ successful<br>→ successfully</p>
            <div class="mini-rule"></div>
            <div class="mini-chips">
              <span>-tion</span><span>-ful</span><span>-ly</span><span>un-</span>
            </div>
            <p class="mini-example">She is a <mark>successful</mark> singer.</p>
            <span class="hub-sheet-open">Xem <span aria-hidden="true">→</span></span>
          </a>

          <a class="hub-sheet hub-sheet--reading" href={reading.href} aria-label="Xem Đọc hiểu">
            <span class="hub-sheet-kicker">Tờ 04</span>
            <strong class="hub-sheet-title">Đọc hiểu</strong>
            <p class="hub-sheet-formula">ý chính<br>→ chi tiết<br>→ suy luận</p>
            <div class="mini-rule"></div>
            <div class="mini-chips">
              <span>skim</span><span>scan</span><span>however</span>
            </div>
            <p class="mini-example">The answer needs <mark>evidence</mark>.</p>
            <span class="hub-sheet-open">Xem <span aria-hidden="true">→</span></span>
          </a>

          <a class="hub-sheet hub-sheet--sound" href={pronunciation.href} aria-label="Xem Phát âm">
            <span class="hub-sheet-kicker">Tờ 05</span>
            <strong class="hub-sheet-title">Phát âm</strong>
            <p class="hub-sheet-formula">-ed · -s<br>nguyên âm<br>trọng âm</p>
            <div class="mini-rule"></div>
            <div class="mini-chips">
              <span>/t/</span><span>/d/</span><span>/ɪd/</span>
            </div>
            <p class="mini-example">“Watched” ends in <mark>/t/</mark>.</p>
            <span class="hub-sheet-open">Xem <span aria-hidden="true">→</span></span>
          </a>

          <a class="hub-sheet hub-sheet--write" href={sentenceTransformation.href} aria-label="Xem Viết lại câu">
            <span class="hub-sheet-kicker">Tờ 06</span>
            <strong class="hub-sheet-title">Viết lại câu</strong>
            <p class="hub-sheet-formula">If / Unless<br>wish<br>so … that</p>
            <div class="mini-rule"></div>
            <div class="mini-chips">
              <span>V-ing</span><span>since</span><span>despite</span>
            </div>
            <p class="mini-example">I wish I <mark>had</mark> a bike.</p>
            <span class="hub-sheet-open">Xem <span aria-hidden="true">→</span></span>
          </a>

          <a class="hub-sheet hub-sheet--vocab" href={vocabulary.href} aria-label="Xem Từ vựng">
            <span class="hub-sheet-kicker">Tờ 07</span>
            <strong class="hub-sheet-title">Từ vựng</strong>
            <p class="hub-sheet-formula">cụm từ<br>cụm động từ<br>mục từ</p>
            <div class="mini-rule"></div>
            <div class="mini-chips">
              <span>make a decision</span><span>look after</span><span>eating habits</span>
            </div>
            <p class="mini-example">Learn <mark>collocations</mark>, not single words.</p>
            <span class="hub-sheet-open">Xem <span aria-hidden="true">→</span></span>
          </a>

          <a class="hub-sheet hub-sheet--cloze" href={cloze.href} aria-label="Xem Điền khuyết">
            <span class="hub-sheet-kicker">Tờ 08</span>
            <strong class="hub-sheet-title">Điền khuyết</strong>
            <p class="hub-sheet-formula">ngữ pháp<br>từ vựng<br>từ nối</p>
            <div class="mini-rule"></div>
            <div class="mini-chips">
              <span>however</span><span>depend on</span><span>much</span>
            </div>
            <p class="mini-example">Read the <mark>whole sentence</mark>.</p>
            <span class="hub-sheet-open">Xem <span aria-hidden="true">→</span></span>
          </a>

          <a class="hub-sheet hub-sheet--signs" href={signs.href} aria-label="Xem Biển báo">
            <span class="hub-sheet-kicker">Tờ 09</span>
            <strong class="hub-sheet-title">Biển báo</strong>
            <p class="hub-sheet-formula">thông báo<br>giao tiếp<br>đáp lại</p>
            <div class="mini-rule"></div>
            <div class="mini-chips">
              <span>NO PARKING</span><span>FREE ENTRY</span><span>Not at all.</span>
            </div>
            <p class="mini-example">Read the <mark>key word</mark>.</p>
            <span class="hub-sheet-open">Xem <span aria-hidden="true">→</span></span>
          </a>

          <a class="hub-sheet hub-sheet--grammar" href={grammar.href} aria-label="Xem Ngữ pháp">
            <span class="hub-sheet-kicker">Tờ 10</span>
            <strong class="hub-sheet-title">Ngữ pháp</strong>
            <p class="hub-sheet-formula">từ nối<br>mệnh đề quan hệ<br>so sánh<br>mẫu động từ</p>
            <div class="mini-rule"></div>
            <div class="mini-chips">
              <span>however</span><span>who / which</span><span>more crowded</span>
            </div>
            <p class="mini-example">Choose the <mark>structure</mark>, not the sound.</p>
            <span class="hub-sheet-open">Xem <span aria-hidden="true">→</span></span>
          </a>

          <a class="hub-sheet hub-sheet--sentence" href={sentenceConstruction.href} aria-label="Xem Sắp xếp câu">
            <span class="hub-sheet-kicker">Tờ 11</span>
            <strong class="hub-sheet-title">Sắp xếp câu</strong>
            <p class="hub-sheet-formula">S + V + O<br>by + V-ing<br>Phần VI</p>
            <div class="mini-rule"></div>
            <div class="mini-chips">
              <span>S + V + O</span><span>by presenting</span><span>break the habit</span>
            </div>
            <p class="mini-example">Find the <mark>main verb</mark> first.</p>
            <span class="hub-sheet-open">Xem <span aria-hidden="true">→</span></span>
          </a>

          <a class="hub-sheet hub-sheet--mock" href={mockExam.href} aria-label="Xem Thi thử">
            <span class="hub-sheet-kicker">Tờ 12</span>
            <strong class="hub-sheet-title">Thi thử</strong>
            <p class="hub-sheet-formula">24 câu<br>45 phút<br>chấm điểm</p>
            <div class="mini-rule"></div>
            <div class="mini-chips">
              <span>đồng hồ</span><span>điểm</span><span>xem lại</span>
            </div>
            <p class="mini-example">Find your <mark>weak spots</mark>.</p>
            <span class="hub-sheet-open">Xem <span aria-hidden="true">→</span></span>
          </a>
        </div>

        <div class="sticky-note" aria-hidden="true">
          <span class="sticky-label">Mẹo dùng</span>
          <strong>In ra và dán</strong>
          <span>ở góc học tập!</span>
        </div>
        <div class="stamp stamp-home" aria-hidden="true">Học<br>mỗi ngày<br><span>10 phút</span></div>
      </div>
    </div>
  </section>

  <!-- RESOURCES -->
  <section class="section" id="resources">
    <div class="container">
      <div class="section-head">
        <div>
          <h2>Mười hai tờ, đủ để ôn.</h2>
          <p>Mỗi tờ có sơ đồ, bảng tra nhanh, bẫy đề và bài kiểm tra riêng. Bắt đầu từ tờ bạn cần, hoặc đi theo lộ trình bên dưới.</p>
        </div>
        <p class="section-aside"><span>{sheets.length}</span> tờ<br><span>{totalQuestions}</span> câu hỏi</p>
      </div>

      <div class="hub-grid">
        {sheets.map((sheet) => (
          <article class:list={['hub-card', `hub-card--${sheet.accent}`]}>
            <div class="hub-card-top">
              <span class="hub-card-no">{sheet.cardNo}</span>
              <span class="hub-badge">{sheet.badge}</span>
            </div>
            <h3>{sheet.title}</h3>
            <p class="hub-card-lead">{sheet.lead}</p>
            <div class="hub-preview" aria-hidden="true">
              {sheet.preview.map((item) => <span>{item}</span>)}
            </div>
            <ul class="hub-list">
              {sheet.highlights.map((highlight) => (
                <li>
                  {highlight.strong && <strong>{highlight.strong}</strong>}
                  {highlight.text}
                </li>
              ))}
            </ul>
            <div class="hub-card-foot">
              <span class="hub-meta">{sheet.meta}</span>
              <a class="btn btn-primary btn-small" href={sheet.href}>
                Xem
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- PATH -->
  <section class="section section-alt" id="plan">
    <div class="container">
      <div class="section-head">
        <div>
          <h2>Năm bước trước khi làm đề.</h2>
          <p>Không cần học hết trong một buổi. Đi theo thứ tự này để nhớ lâu hơn.</p>
        </div>
        <p class="section-aside"><span>5</span> bước<br>mỗi ngày 10 phút</p>
      </div>

      <div class="path-grid">
        <article class="path-card">
          <span class="path-no" aria-hidden="true">01</span>
          <h3>Nắm 12 thì</h3>
          <p>Đọc sơ đồ, sau đó học công thức và dấu hiệu của từng thì. Ưu tiên hiện tại hoàn thành, quá khứ tiếp diễn và tương lai đơn.</p>
          <a class="path-link" href={tenses.href}>Xem 12 thì →</a>
        </article>

        <article class="path-card">
          <span class="path-no" aria-hidden="true">02</span>
          <h3>Học giới từ theo cụm</h3>
          <p>Nắm at/on/in trước, rồi học 54 cụm cố định. Đừng cố dịch từng giới từ riêng lẻ.</p>
          <a class="path-link" href={prepositions.href}>Xem giới từ →</a>
        </article>

        <article class="path-card">
          <span class="path-no" aria-hidden="true">03</span>
          <h3>Luyện từ vựng, ngữ pháp &amp; kỹ năng</h3>
          <p>Học từ loại, từ vựng – cụm từ, ngữ pháp cốt lõi, điền khuyết, đọc hiểu, phát âm – trọng âm và biển báo – giao tiếp.</p>
          <div class="path-links">
            <a href={wordForms.href}>Từ loại</a>
            <a href={vocabulary.href}>Từ vựng</a>
            <a href={grammar.href}>Ngữ pháp</a>
            <a href={cloze.href}>Điền khuyết</a>
            <a href={reading.href}>Đọc hiểu</a>
            <a href={pronunciation.href}>Phát âm</a>
            <a href={signs.href}>Biển báo</a>
          </div>
        </article>

        <article class="path-card">
          <span class="path-no" aria-hidden="true">04</span>
          <h3>Viết lại câu &amp; phần VI</h3>
          <p>Học tám nhóm mẫu viết lại câu, trật tự từ và cách dùng mục từ điển ở phần VI.</p>
          <div class="path-links">
            <a href={sentenceTransformation.href}>Viết lại câu</a>
            <a href={sentenceConstruction.href}>Sắp xếp câu</a>
          </div>
        </article>

        <article class="path-card">
          <span class="path-no" aria-hidden="true">05</span>
          <h3>Tự kiểm tra &amp; thi thử</h3>
          <p>Làm bài ngắn để biết phần nào còn hổng, rồi làm đề 24 câu để kiểm tra tổng thể.</p>
          <div class="path-links">
            <a href={`${tenses.href}#quiz`}>12 câu thì</a>
            <a href={`${prepositions.href}#quiz`}>16 câu giới từ</a>
            <a href={`${wordForms.href}#quiz`}>16 câu từ loại</a>
            <a href={`${reading.href}#quiz`}>12 câu đọc hiểu</a>
            <a href={`${pronunciation.href}#quiz`}>16 câu phát âm</a>
            <a href={`${sentenceTransformation.href}#quiz`}>16 câu viết lại</a>
            <a href={`${vocabulary.href}#quiz`}>16 câu từ vựng</a>
            <a href={`${cloze.href}#quiz`}>12 câu điền khuyết</a>
            <a href={`${signs.href}#quiz`}>16 câu biển báo</a>
            <a href={`${grammar.href}#quiz`}>18 câu ngữ pháp</a>
            <a href={`${sentenceConstruction.href}#quiz`}>16 câu sắp xếp</a>
            <a href={mockExam.href}>Thi thử 24 câu</a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- CLOSING -->
  <section class="section">
    <div class="container">
      <div class="home-band">
        <div>
          <h2>Mười hai quy tắc nhớ nhanh.</h2>
          <p><strong>Thì:</strong> since + mốc, for + khoảng · <strong>Giới từ:</strong> at + giờ, on + ngày, in + tháng/năm · <strong>Từ loại:</strong> sau tính từ thường là danh từ, sau động từ thường là trạng từ · <strong>Đọc hiểu:</strong> đáp án phải có bằng chứng trong bài · <strong>Phát âm:</strong> xét âm cuối, không xét chữ cuối · <strong>Viết lại:</strong> đổi cấu trúc, giữ nguyên nghĩa · <strong>Từ vựng:</strong> học cả cụm, không học từ đơn · <strong>Điền khuyết:</strong> đọc cả câu, kiểm tra ngữ pháp và nghĩa · <strong>Biển báo:</strong> bám từ khoá No, Only, Free, Required · <strong>Ngữ pháp:</strong> nhìn từ đứng trước và cấu trúc cần điền · <strong>Phần VI:</strong> tìm S + V, giữ cụm cố định · <strong>Thi thử:</strong> canh 45 phút, không bỏ trống.</p>
        </div>
        <div class="home-band-actions">
          <a class="btn btn-primary" href={mockExam.href}>Thi thử 24 câu</a>
          <a class="btn btn-ghost" href={tenses.href}>Ôn 12 thì</a>
          <a class="btn btn-ghost" href={grammar.href}>Luyện ngữ pháp</a>
          <a class="btn btn-ghost" href={sentenceConstruction.href}>Luyện phần VI</a>
          <a class="btn btn-ghost" href={sentenceTransformation.href}>Luyện viết lại câu</a>
          <a class="btn btn-ghost" href={reading.href}>Luyện đọc hiểu</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
