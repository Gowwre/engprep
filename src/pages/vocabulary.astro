---
import '../styles/global.css';
import SheetLayout from '../layouts/SheetLayout.astro';
import EmptyState from '../components/EmptyState.astro';
import FigurePanel from '../components/FigurePanel.astro';
import FilterToolbar from '../components/FilterToolbar.astro';
import QuizPanel from '../components/QuizPanel.astro';
import QuickReview from '../components/QuickReview.astro';
import SectionHead from '../components/SectionHead.astro';
import StepCard from '../components/StepCard.astro';
import StudyStackVisual from '../components/StudyStackVisual.astro';
import TableShell from '../components/TableShell.astro';
import TrapCard from '../components/TrapCard.astro';
import { quickReviews } from '../data/quick-review';
import '../styles/vocabulary.css';
---

<SheetLayout slug="vocabulary">
  <Fragment slot="visual">
    <StudyStackVisual
      stackClass="vc-stack"
      noteLabel="Mẹo thi"
      noteTitle="Từ nào đi với từ nào?"
      note="học cả cụm!"
    >
      <p class="mini-label">Mục từ điển · provide</p>
      <div class="vc-mini-entry">
        <p class="vc-mini-word">provide <span>/prəˈvaɪd/ v.</span></p>
        <p class="vc-mini-def">to give something to somebody</p>
        <p class="vc-mini-colloc">provide <mark>information</mark></p>
        <p class="vc-mini-colloc">provide <mark>an opportunity</mark></p>
      </div>
      <div class="mini-rule"></div>
      <p class="vc-mini-question">Chọn cụm đúng:</p>
      <p class="vc-mini-answer">provide information ✓</p>
      <p class="vc-mini-why">Học cả cụm, không học từ đơn.</p>
    </StudyStackVisual>
  </Fragment>

  <QuickReview slug="vocabulary" accent="vocab" content={quickReviews['vocabulary']!} />

  <!-- MAP -->
  <section class="section" id="map" data-pagefind-title="Bản đồ">
    <div class="container">
      <SectionHead kicker="01 · Bản đồ" title="Bốn nhóm từ vựng cần ôn.">
        Từ vựng trong đề không hỏi từ đơn lẻ. Đề hỏi cách từ kết hợp với nhau, nghĩa trong ngữ cảnh và cụm từ trong mục từ điển.
        <p slot="aside" class="section-aside"><span>4</span> nhóm<br><span>16</span> câu hỏi</p>
      </SectionHead>

      <div class="map-grid vc-map-grid">
        <a class="map-card vc-map-card vc-map-colloc" href="#collocations-fixed">
          <p class="map-kicker">01 · Cách kết hợp</p>
          <h3>Cụm từ cố định</h3>
          <p class="map-rule">Học cụm 2–3 từ thay vì học từng từ riêng lẻ.</p>
          <div class="map-chips">
            <span>make a decision</span><span>heavy rain</span><span>take part in</span>
          </div>
          <span class="map-link">Xem 32 cụm →</span>
        </a>

        <a class="map-card vc-map-card vc-map-phrasal" href="#collocations-phrasal">
          <p class="map-kicker">02 · Nghĩa cố định</p>
          <h3>Cụm động từ</h3>
          <p class="map-rule">Động từ + tiểu từ tạo nghĩa mới, không đoán từng chữ.</p>
          <div class="map-chips">
            <span>look after</span><span>run out of</span><span>put off</span>
          </div>
          <span class="map-link">Xem cụm động từ →</span>
        </a>

        <a class="map-card vc-map-card vc-map-topic" href="#topics">
          <p class="map-kicker">03 · Theo chủ đề</p>
          <h3>Từ vựng theo chủ đề</h3>
          <p class="map-rule">Sáu chủ đề quen thuộc: môi trường, công nghệ, du lịch, sức khoẻ, cộng đồng, học đường.</p>
          <div class="map-chips">
            <span>environment</span><span>technology</span><span>travel</span><span>health</span>
          </div>
          <span class="map-link">Xem từ theo chủ đề →</span>
        </a>

        <a class="map-card vc-map-card vc-map-entry" href="#dictionary">
          <p class="map-kicker">04 · Phần VI</p>
          <h3>Mục từ điển</h3>
          <p class="map-rule">Đọc mục từ, chọn cụm phù hợp và kiểm tra ngữ pháp.</p>
          <div class="map-chips">
            <span>provide</span><span>habit</span><span>an opportunity</span>
          </div>
          <span class="map-link">Xem cách làm →</span>
        </a>
      </div>

      <p class="mini-note"><strong>Nguyên tắc:</strong> gặp một từ mới, hãy ghi luôn cụm đi với nó. Ví dụ: không ghi “decision” mà ghi “make a decision”; không ghi “provide” mà ghi “provide information / an opportunity”.</p>
    </div>
  </section>

  <!-- COLLOCATIONS -->
  <section class="section section-alt" id="collocations" data-pagefind-title="Cụm từ">
    <div class="container">
      <SectionHead kicker="02 · Cụm từ" title="32 cụm thường gặp trong đề.">
        Chia thành sáu nhóm: động từ + danh từ, tính từ + danh từ, động từ + giới từ, danh từ + giới từ, cụm cố định và cụm động từ.
        <p slot="aside" class="section-aside"><span>32</span> cụm<br><span>6</span> nhóm</p>
      </SectionHead>

      <FigurePanel
        kicker="Cụm động từ"
        title="Một động từ, sáu nghĩa."
        caption="Tiểu từ sau “look” đổi nghĩa hoàn toàn. Học cả cụm, đừng dịch riêng động từ và giới từ."
      >
        <div class="vc-phrasal-web">
          <div class="vc-web-hub">
            <span class="vc-web-verb">look</span>
            <span class="vc-web-plus">+ particle</span>
            <strong>→ nghĩa mới</strong>
          </div>

          <div class="vc-web-branches">
            <div class="vc-web-branch">
              <code>look after</code>
              <span>chăm sóc</span>
              <em>look after a child</em>
            </div>
            <div class="vc-web-branch">
              <code>look for</code>
              <span>tìm kiếm</span>
              <em>look for a job</em>
            </div>
            <div class="vc-web-branch">
              <code>look forward to</code>
              <span>mong chờ (+ V-ing)</span>
              <em>look forward to seeing you</em>
            </div>
            <div class="vc-web-branch">
              <code>look up</code>
              <span>tra cứu</span>
              <em>look up a word</em>
            </div>
            <div class="vc-web-branch">
              <code>look into</code>
              <span>điều tra, xem xét</span>
              <em>look into the problem</em>
            </div>
            <div class="vc-web-branch">
              <code>look out</code>
              <span>coi chừng</span>
              <em>look out! there’s a car</em>
            </div>
          </div>
        </div>

        <p class="vc-web-note"><strong>Bẫy:</strong> “look forward <em>to</em>” có “to” là giới từ, nên sau nó là V-ing, không phải to-V.</p>
      </FigurePanel>

      <FilterToolbar
        class="vc-toolbar"
        tabKey="cat"
        ariaLabel="Lọc cụm từ theo nhóm"
        tabs={[
          { value: 'all', label: 'Tất cả' },
          { value: 'vn', label: 'V + N' },
          { value: 'adjn', label: 'Adj + N' },
          { value: 'vprep', label: 'V + prep' },
          { value: 'nprep', label: 'N + prep' },
          { value: 'fixed', label: 'Cụm cố định' },
          { value: 'phrasal', label: 'Cụm động từ' },
        ]}
        searchId="collocation-search"
        searchLabel="Tìm cụm từ"
        placeholder="Tìm “decision”, “quyết định”, “on”…"
        clearId="collocation-clear"
        countId="collocation-count"
        countText="32/32 cụm"
      />

      <div class="anchor-target" id="collocations-fixed" aria-hidden="true"></div>
      <div class="anchor-target" id="collocations-phrasal" aria-hidden="true"></div>

      <TableShell
        wrapperClass="table-shell"
        tableClass="data-table vc-table vc-collocation-table"
        caption="Bảng cụm từ cố định thường gặp trong đề thi lớp 9"
        hint
      >
        <thead>
          <tr>
            <th scope="col">Cụm</th>
            <th scope="col">Nhóm</th>
            <th scope="col">Nghĩa</th>
            <th scope="col">Ví dụ</th>
          </tr>
        </thead>
        <tbody>
          <tr class="vc-collocation-row" data-cat="vn">
            <th scope="row"><code>make a decision</code></th>
            <td><span class="vc-cat vc-cat-vn">V + N</span></td>
            <td>đưa ra quyết định</td>
            <td>She <strong>made a decision</strong> about the trip.</td>
          </tr>
          <tr class="vc-collocation-row" data-cat="vn">
            <th scope="row"><code>take part in</code></th>
            <td><span class="vc-cat vc-cat-vn">V + N</span></td>
            <td>tham gia</td>
            <td>He <strong>took part in</strong> the contest.</td>
          </tr>
          <tr class="vc-collocation-row" data-cat="vn">
            <th scope="row"><code>do homework</code></th>
            <td><span class="vc-cat vc-cat-vn">V + N</span></td>
            <td>làm bài tập</td>
            <td>I <strong>do my homework</strong> every evening.</td>
          </tr>
          <tr class="vc-collocation-row" data-cat="vn">
            <th scope="row"><code>have an impact on</code></th>
            <td><span class="vc-cat vc-cat-vn">V + N</span></td>
            <td>có tác động đến</td>
            <td>Social media <strong>has an impact on</strong> teenagers.</td>
          </tr>
          <tr class="vc-collocation-row" data-cat="vn">
            <th scope="row"><code>make a difference</code></th>
            <td><span class="vc-cat vc-cat-vn">V + N</span></td>
            <td>tạo sự khác biệt</td>
            <td>Small actions can <strong>make a difference</strong>.</td>
          </tr>
          <tr class="vc-collocation-row" data-cat="vn">
            <th scope="row"><code>pay attention to</code></th>
            <td><span class="vc-cat vc-cat-vn">V + N</span></td>
            <td>chú ý đến</td>
            <td><strong>Pay attention to</strong> the keywords.</td>
          </tr>
          <tr class="vc-collocation-row" data-cat="vn">
            <th scope="row"><code>take responsibility for</code></th>
            <td><span class="vc-cat vc-cat-vn">V + N</span></td>
            <td>chịu trách nhiệm về</td>
            <td>We should <strong>take responsibility for</strong> our actions.</td>
          </tr>

          <tr class="vc-collocation-row" data-cat="adjn">
            <th scope="row"><code>heavy rain</code></th>
            <td><span class="vc-cat vc-cat-adjn">Adj + N</span></td>
            <td>mưa lớn</td>
            <td><strong>Heavy rain</strong> caused floods.</td>
          </tr>
          <tr class="vc-collocation-row" data-cat="adjn">
            <th scope="row"><code>serious problem</code></th>
            <td><span class="vc-cat vc-cat-adjn">Adj + N</span></td>
            <td>vấn đề nghiêm trọng</td>
            <td>Plastic waste is a <strong>serious problem</strong>.</td>
          </tr>
          <tr class="vc-collocation-row" data-cat="adjn">
            <th scope="row"><code>healthy lifestyle</code></th>
            <td><span class="vc-cat vc-cat-adjn">Adj + N</span></td>
            <td>lối sống lành mạnh</td>
            <td>A <strong>healthy lifestyle</strong> is important.</td>
          </tr>
          <tr class="vc-collocation-row" data-cat="adjn">
            <th scope="row"><code>public transport</code></th>
            <td><span class="vc-cat vc-cat-adjn">Adj + N</span></td>
            <td>giao thông công cộng</td>
            <td>We should use <strong>public transport</strong>.</td>
          </tr>
          <tr class="vc-collocation-row" data-cat="adjn">
            <th scope="row"><code>renewable energy</code></th>
            <td><span class="vc-cat vc-cat-adjn">Adj + N</span></td>
            <td>năng lượng tái tạo</td>
            <td>Solar power is a form of <strong>renewable energy</strong>.</td>
          </tr>
          <tr class="vc-collocation-row" data-cat="adjn">
            <th scope="row"><code>cultural heritage</code></th>
            <td><span class="vc-cat vc-cat-adjn">Adj + N</span></td>
            <td>di sản văn hoá</td>
            <td>We should protect <strong>cultural heritage</strong>.</td>
          </tr>
          <tr class="vc-collocation-row" data-cat="adjn">
            <th scope="row"><code>social media</code></th>
            <td><span class="vc-cat vc-cat-adjn">Adj + N</span></td>
            <td>mạng xã hội</td>
            <td>Many teens use <strong>social media</strong> every day.</td>
          </tr>

          <tr class="vc-collocation-row" data-cat="vprep">
            <th scope="row"><code>depend on</code></th>
            <td><span class="vc-cat vc-cat-vprep">V + prep</span></td>
            <td>phụ thuộc vào</td>
            <td>It <strong>depends on</strong> the weather.</td>
          </tr>
          <tr class="vc-collocation-row" data-cat="vprep">
            <th scope="row"><code>look after</code></th>
            <td><span class="vc-cat vc-cat-vprep">V + prep</span></td>
            <td>chăm sóc</td>
            <td>She <strong>looks after</strong> her little brother.</td>
          </tr>
          <tr class="vc-collocation-row" data-cat="vprep">
            <th scope="row"><code>look forward to</code></th>
            <td><span class="vc-cat vc-cat-vprep">V + prep</span></td>
            <td>mong chờ (+ V-ing)</td>
            <td>I <strong>look forward to seeing</strong> you.</td>
          </tr>
          <tr class="vc-collocation-row" data-cat="vprep">
            <th scope="row"><code>deal with</code></th>
            <td><span class="vc-cat vc-cat-vprep">V + prep</span></td>
            <td>giải quyết, xử lý</td>
            <td>We need to <strong>deal with</strong> this problem.</td>
          </tr>
          <tr class="vc-collocation-row" data-cat="vprep">
            <th scope="row"><code>concentrate on</code></th>
            <td><span class="vc-cat vc-cat-vprep">V + prep</span></td>
            <td>tập trung vào</td>
            <td><strong>Concentrate on</strong> your studies.</td>
          </tr>

          <tr class="vc-collocation-row" data-cat="nprep">
            <th scope="row"><code>reason for</code></th>
            <td><span class="vc-cat vc-cat-nprep">N + prep</span></td>
            <td>lý do cho</td>
            <td>the <strong>reason for</strong> the change</td>
          </tr>
          <tr class="vc-collocation-row" data-cat="nprep">
            <th scope="row"><code>solution to</code></th>
            <td><span class="vc-cat vc-cat-nprep">N + prep</span></td>
            <td>giải pháp cho</td>
            <td>a <strong>solution to</strong> the problem</td>
          </tr>
          <tr class="vc-collocation-row" data-cat="nprep">
            <th scope="row"><code>effect on</code></th>
            <td><span class="vc-cat vc-cat-nprep">N + prep</span></td>
            <td>tác động lên</td>
            <td>Noise has a bad <strong>effect on</strong> sleep.</td>
          </tr>
          <tr class="vc-collocation-row" data-cat="nprep">
            <th scope="row"><code>access to</code></th>
            <td><span class="vc-cat vc-cat-nprep">N + prep</span></td>
            <td>quyền tiếp cận</td>
            <td><strong>access to</strong> the internet</td>
          </tr>

          <tr class="vc-collocation-row" data-cat="fixed">
            <th scope="row"><code>in the end</code></th>
            <td><span class="vc-cat vc-cat-fixed">Cụm cố định</span></td>
            <td>cuối cùng</td>
            <td><strong>In the end</strong>, we decided to stay.</td>
          </tr>
          <tr class="vc-collocation-row" data-cat="fixed">
            <th scope="row"><code>on time</code></th>
            <td><span class="vc-cat vc-cat-fixed">Cụm cố định</span></td>
            <td>đúng giờ</td>
            <td>The train arrived <strong>on time</strong>.</td>
          </tr>
          <tr class="vc-collocation-row" data-cat="fixed">
            <th scope="row"><code>by mistake</code></th>
            <td><span class="vc-cat vc-cat-fixed">Cụm cố định</span></td>
            <td>do nhầm lẫn</td>
            <td>I took your bag <strong>by mistake</strong>.</td>
          </tr>
          <tr class="vc-collocation-row" data-cat="fixed">
            <th scope="row"><code>in spite of</code></th>
            <td><span class="vc-cat vc-cat-fixed">Cụm cố định</span></td>
            <td>mặc dù</td>
            <td><strong>In spite of</strong> the rain, we went out.</td>
          </tr>

          <tr class="vc-collocation-row" data-cat="phrasal">
            <th scope="row"><code>break down</code></th>
            <td><span class="vc-cat vc-cat-phrasal">Cụm động từ</span></td>
            <td>hỏng máy</td>
            <td>Our car <strong>broke down</strong>.</td>
          </tr>
          <tr class="vc-collocation-row" data-cat="phrasal">
            <th scope="row"><code>run out of</code></th>
            <td><span class="vc-cat vc-cat-phrasal">Cụm động từ</span></td>
            <td>hết, không còn</td>
            <td>We <strong>ran out of</strong> water.</td>
          </tr>
          <tr class="vc-collocation-row" data-cat="phrasal">
            <th scope="row"><code>put off</code></th>
            <td><span class="vc-cat vc-cat-phrasal">Cụm động từ</span></td>
            <td>hoãn lại</td>
            <td>They <strong>put off</strong> the meeting.</td>
          </tr>
          <tr class="vc-collocation-row" data-cat="phrasal">
            <th scope="row"><code>turn off</code></th>
            <td><span class="vc-cat vc-cat-phrasal">Cụm động từ</span></td>
            <td>tắt</td>
            <td><strong>Turn off</strong> the lights.</td>
          </tr>
          <tr class="vc-collocation-row" data-cat="phrasal">
            <th scope="row"><code>give up</code></th>
            <td><span class="vc-cat vc-cat-phrasal">Cụm động từ</span></td>
            <td>từ bỏ</td>
            <td>Don’t <strong>give up</strong>.</td>
          </tr>
        </tbody>
      </TableShell>

      <EmptyState
        id="collocation-empty"
        title="Không tìm thấy cụm nào khớp."
        text="Thử từ khoá khác hoặc xoá bộ lọc để xem lại cả 32 cụm."
        resetId="collocation-reset"
      />

      <p class="mini-note"><strong>Mẹo:</strong> khi học một cụm, hãy đọc cả câu ví dụ. Ví dụ <em>make a decision</em> đi với “make”, không phải “do”; <em>look forward to</em> đi với V-ing.</p>
    </div>
  </section>

  <!-- TOPICS -->
  <section class="section" id="topics" data-pagefind-title="Chủ đề">
    <div class="container">
      <SectionHead kicker="03 · Theo chủ đề" title="Sáu chủ đề quen thuộc.">
        Đề xoay chủ đề nhưng vẫn dùng lại các nhóm từ quen thuộc. Học theo chủ đề để gặp lại từ trong bài đọc và bài điền khuyết.
        <p slot="aside" class="section-aside"><span>6</span> chủ đề<br><span>8</span> cụm / chủ đề</p>
      </SectionHead>

      <div class="vc-topic-grid">
        <article class="vc-topic-card vc-topic-env">
          <p class="vc-topic-label">01 · Môi trường</p>
          <h3>Môi trường</h3>
          <div class="vc-topic-chips">
            <span>pollution</span><span>climate change</span><span>renewable energy</span><span>plastic waste</span><span>protect the environment</span><span>reduce emissions</span><span>natural disaster</span><span>wildlife</span>
          </div>
        </article>

        <article class="vc-topic-card vc-topic-tech">
          <p class="vc-topic-label">02 · Công nghệ &amp; AI</p>
          <h3>Công nghệ</h3>
          <div class="vc-topic-chips">
            <span>artificial intelligence</span><span>deepfake</span><span>misinformation</span><span>social media</span><span>digital device</span><span>online safety</span><span>spread information</span><span>influence public opinion</span>
          </div>
        </article>

        <article class="vc-topic-card vc-topic-travel">
          <p class="vc-topic-label">03 · Du lịch</p>
          <h3>Du lịch</h3>
          <div class="vc-topic-chips">
            <span>destination</span><span>accommodation</span><span>tourist attraction</span><span>local cuisine</span><span>package tour</span><span>means of transport</span><span>book a ticket</span><span>go sightseeing</span>
          </div>
        </article>

        <article class="vc-topic-card vc-topic-health">
          <p class="vc-topic-label">04 · Sức khoẻ</p>
          <h3>Sức khoẻ</h3>
          <div class="vc-topic-chips">
            <span>balanced diet</span><span>physical activity</span><span>mental health</span><span>get enough sleep</span><span>cut down on fast food</span><span>stay healthy</span><span>overweight</span><span>stress</span>
          </div>
        </article>

        <article class="vc-topic-card vc-topic-community">
          <p class="vc-topic-label">05 · Cộng đồng</p>
          <h3>Cộng đồng</h3>
          <div class="vc-topic-chips">
            <span>volunteer</span><span>charity</span><span>community service</span><span>cultural heritage</span><span>festival</span><span>custom</span><span>tradition</span><span>take part in</span>
          </div>
        </article>

        <article class="vc-topic-card vc-topic-school">
          <p class="vc-topic-label">06 · Học đường</p>
          <h3>Học đường</h3>
          <div class="vc-topic-chips">
            <span>curriculum</span><span>assignment</span><span>extracurricular activity</span><span>vocational school</span><span>qualification</span><span>higher education</span><span>pass an exam</span><span>school facilities</span>
          </div>
        </article>
      </div>

      <p class="mini-note"><strong>Mẹo ghi chép:</strong> mỗi khi gặp một từ mới trong bài đọc, ghi từ đó vào đúng chủ đề và thêm một cụm đi kèm. Ví dụ: <em>energy → renewable energy</em>, <em>habit → eating habits</em>.</p>
    </div>
  </section>

  <!-- DICTIONARY -->
  <section class="section section-alt" id="dictionary" data-pagefind-title="Từ điển">
    <div class="container">
      <SectionHead kicker="04 · Mục từ điển" title="Phần VI: chọn cụm, không chọn từ.">
        Hai đề gần đây dùng mục từ điển để kiểm tra cụm từ cố định. Đọc cả mục từ, xem ví dụ rồi mới chọn cụm phù hợp.
        <p slot="aside" class="section-aside"><span>2</span> mục từ mẫu<br><span>3</span> bước chọn</p>
      </SectionHead>

      <div class="vc-entry-grid">
        <article class="vc-entry">
          <div class="vc-entry-head">
            <strong>provide</strong>
            <span>/prəˈvaɪd/ v.</span>
          </div>
          <p class="vc-entry-def">to give something to somebody</p>
          <div class="vc-entry-line">
            <code>provide <mark>information</mark></code>
            <span>Volunteers provide information about the museum.</span>
          </div>
          <div class="vc-entry-line">
            <code>provide <mark>an opportunity</mark></code>
            <span>The program provides an opportunity for learners.</span>
          </div>
          <div class="vc-entry-line">
            <code>provide <mark>support</mark></code>
            <span>They provide support for local families.</span>
          </div>
        </article>

        <article class="vc-entry">
          <div class="vc-entry-head">
            <strong>habit</strong>
            <span>/ˈhæbɪt/ n.</span>
          </div>
          <p class="vc-entry-def">something you do regularly</p>
          <div class="vc-entry-line">
            <code><mark>eating</mark> habits</code>
            <span>Your eating habits affect your health.</span>
          </div>
          <div class="vc-entry-line">
            <code>break the <mark>habit</mark> of + V-ing</code>
            <span>I’m trying to break the habit of staying up late.</span>
          </div>
          <div class="vc-entry-line">
            <code>sleeping <mark>habits</mark></code>
            <span>Good sleeping habits help you focus.</span>
          </div>
        </article>
      </div>

      <div class="vc-steps">
        <StepCard
          prefix="vc"
          no="01"
          title="Đọc cả mục từ"
          body="Xác định từ loại, nghĩa và các cụm đi kèm. Đừng chỉ nhìn dòng đầu tiên."
          plainNo
        />
        <StepCard
          prefix="vc"
          no="02"
          title="Soi ví dụ"
          body="Chú ý giới từ, số ít/số nhiều và thì của động từ trong câu ví dụ."
          plainNo
        />
        <StepCard
          prefix="vc"
          no="03"
          title="Chọn cụm 2–3 từ"
          body="Chọn cụm đúng nghĩa, rồi kiểm tra lại ngữ pháp trong câu hoàn chỉnh."
          plainNo
        />
      </div>

      <div class="vc-check-strip">
        <span><strong>provide information</strong> · không thêm -s</span>
        <span><strong>provides an opportunity</strong> · chia -s</span>
        <span><strong>eating habits</strong> · số nhiều</span>
        <span><strong>break the habit of + V-ing</strong></span>
      </div>

      <p class="mini-note"><strong>Đừng học tủ:</strong> mục từ có thể thay đổi mỗi năm, nhưng cách làm thì không. Hãy luyện đọc mục từ và kiểm tra cụm + ngữ pháp, thay vì học thuộc một đáp án.</p>
    </div>
  </section>

  <!-- TRAPS -->
  <section class="section" id="traps" data-pagefind-title="Bẫy đề">
    <div class="container">
      <SectionHead kicker="05 · Bẫy đề" title="Mười lỗi hay mất điểm.">
        Đọc câu sai, câu đúng và lý do. Đây là những lỗi học sinh lớp 9 hay mắc khi làm phần từ vựng và mục từ điển.
        <p slot="aside" class="section-aside"><span>10</span> lỗi<br>cần tránh</p>
      </SectionHead>

      <div class="trap-grid">
        <TrapCard
          bad="<strong>do</strong> a decision"
          good="<strong>make</strong> a decision"
          why="Decision đi với make, không đi với do. Học cả cụm."
        />

        <TrapCard
          bad="<strong>make</strong> homework"
          good="<strong>do</strong> homework"
          why="Do homework, do the dishes; make a decision, make a plan."
        />

        <TrapCard
          bad="She <strong>said</strong> me the news."
          good="She <strong>told</strong> me the news."
          why="Say something; tell somebody something."
        />

        <TrapCard
          bad="Can you <strong>lend</strong> me some money? — No, I need to <strong>borrow</strong> from you."
          good="Can you <strong>lend</strong> me some money? — I need to <strong>borrow</strong> some."
          why="Borrow something from somebody; lend something to somebody."
        />

        <TrapCard
          bad="The weather <strong>effects</strong> my mood."
          good="The weather <strong>affects</strong> my mood."
          why="Affect là động từ; effect là danh từ: the effect on health."
        />

        <TrapCard
          bad="They provide <strong>students books</strong>."
          good="They provide <strong>students with books</strong>."
          why="Provide somebody with something; provide something for somebody."
        />

        <TrapCard
          bad="<strong>eat habits</strong>"
          good="<strong>eating habits</strong>"
          why="Habit đi với V-ing hoặc danh từ: eating habits, sleeping habits."
        />

        <TrapCard
          bad="Our car <strong>broke up</strong> on the way."
          good="Our car <strong>broke down</strong> on the way."
          why="Break down = hỏng máy; break up = chia tay, tan rã."
        />

        <TrapCard
          bad="The program <strong>provide</strong> an opportunity for learners."
          good="The program <strong>provides</strong> an opportunity for learners."
          why="Chủ ngữ số ít “The program” → provides. Đừng quên chia động từ trong mục từ điển."
        />

        <TrapCard
          bad="I need some <strong>informations</strong>."
          good="I need some <strong>information</strong>."
          why="Information, advice, furniture, equipment là danh từ không đếm được, không thêm -s."
        />
      </div>
    </div>
  </section>

